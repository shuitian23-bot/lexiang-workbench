// 页面数据缓存：key = "cat-p{n}"
const pageCache = {};

// ── URL 状态管理（真实路径，无hash）─────────────────────
// 检测当前站点base: /wiki/ 或 /wiki-c/ 或 /wiki-b/ 或 /wiki-biz/
const SITE_BASE = (function(){
  const m = location.pathname.match(/^\/(wiki(?:-[a-z]+)?)\//);
  return m ? '/' + m[1] + '/' : '/wiki/';
})();

function pushState(cat, page, q) {
  let url;
  if (q) {
    url = SITE_BASE + '?q=' + encodeURIComponent(q);
  } else if (cat && cat !== 'all') {
    url = page > 1 ? SITE_BASE + cat + '/page/' + page + '.html' : SITE_BASE + cat + '/';
  } else if (page > 1) {
    url = SITE_BASE + '?page=' + page;
  } else {
    url = SITE_BASE;
  }
  history.replaceState({cat, page, q}, '', url);
}

function readState() {
  // 优先从URL路径解析: /wiki/notebook/ 或 /wiki/notebook/page/2.html
  const path = location.pathname;
  const base = SITE_BASE;
  const rel = path.startsWith(base) ? path.slice(base.length) : '';
  // /wiki/notebook/ → cat=notebook
  const catMatch = rel.match(/^([a-z_-]+)\/$/);
  if (catMatch && (PAGED_CATS.includes(catMatch[1]) || catMatch[1] in COUNTS)) {
    return { cat: catMatch[1], page: 1, q: '' };
  }
  // /wiki/notebook/page/3.html → cat=notebook, page=3
  const pageMatch = rel.match(/^([a-z_-]+)\/page\/(\d+)\.html$/);
  if (pageMatch) {
    return { cat: pageMatch[1], page: parseInt(pageMatch[2]), q: '' };
  }
  // fallback: 查询参数
  const params = new URLSearchParams(location.search);
  // 兼容旧hash
  const hashParams = new URLSearchParams(location.hash.slice(1));
  return {
    cat: params.get('cat') || hashParams.get('cat') || 'all',
    page: parseInt(params.get('page') || hashParams.get('page')) || 1,
    q: params.get('q') || hashParams.get('q') || '',
  };
}

// ── 启动：直接用内联数据渲染首屏 ────────────────────────
(function(){
    const data = INLINE_PAGE1;
    const arr = data.items;
    if (data.total) COUNTS['all'] = data.total;
    pageCache['all-p1'] = arr;
    updateCounts();
    const state = readState();
    if (state.q) {
      document.querySelector('.hero-search input').value = state.q;
      doSearch();
    } else {
      loadPage(state.cat, state.page);
    }
    // 首页加载完后，后台静默预取各分类第一页
    setTimeout(() => {
      PAGED_CATS.forEach(cat => {
        fetch(`${SITE_BASE}pages/${cat}-p1.json?v=5`)
          .then(r => r.json())
          .then(d => {
            const items = Array.isArray(d) ? d : d.items;
            if (!Array.isArray(d) && d.total) COUNTS[cat] = d.total;
            pageCache[`${cat}-p1`] = items;
          }).catch(() => {});
      });
    }, 800);
})();

// ── 核心：按分类+页码加载 ─────────────────────────────
function loadPage(cat, page, cb) {
  currentCat = cat;
  currentPage = page;
  if (cat !== 'search') pushState(cat, page, '');

  // 更新按钮状态
  document.querySelectorAll('.cat-btn').forEach(b =>
    b.classList.toggle('active', b.dataset.cat === cat));
  // 更新侧边栏高亮
  document.querySelectorAll('.sidebar-link[onclick]').forEach(a => {
    const m = a.getAttribute('onclick').match(/filterCat\('(\w+)'\)/);
    if (m) a.classList.toggle('active', m[1] === cat);
  });
  document.getElementById('content-title').textContent = CAT_TITLES[cat] || '全部文章';

  const cacheKey = `${cat}-p${page}`;

  if (pageCache[cacheKey]) {
    renderPage(pageCache[cacheKey]);
    return;
  }

  // 半透明遮罩保留当前内容，避免闪白
  const grid = document.getElementById('article-grid');
  grid.style.opacity = '0.4';
  grid.style.pointerEvents = 'none';

  fetch(`${SITE_BASE}pages/${cat}-p${page}.json?v=5`)
    .then(r => { if(!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(data => {
      // 兼容旧格式（直接是数组）和新格式（{total, items:[]}）
      const items = Array.isArray(data) ? data : data.items;
      if (!Array.isArray(data) && data.total) COUNTS[cat] = data.total;
      pageCache[cacheKey] = items;
      if (currentCat === cat && currentPage === page) {
        renderPage(items);
        if (cb) cb();
      }
    })
    .catch(e => {
      console.error('loadPage fetch error:', e);
      const g = document.getElementById('article-grid');
      g.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:#c00">加载失败，请重试</div>';
      g.style.opacity = '1';
      g.style.pointerEvents = '';
    });
}

function filterCat(cat) { loadPage(cat, 1); }

// ── 搜索（搜索时先加载完整分类数据）────────────────
document.querySelector('.hero-search button').addEventListener('click', doSearch);
document.querySelector('.hero-search input').addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });

let searchPool = null;
let searchCat = null;

// 全量slim数据缓存（一次加载，后续搜索直接用）
let slimPool = null;

function doSearch() {
  const q = document.querySelector('.hero-search input').value.trim().toLowerCase();
  if (!q) { pushState('all', 1, ''); loadPage(currentCat === 'search' ? 'all' : currentCat, 1); return; }

  // 立即设置search状态，阻止正在进行的loadPage回调覆盖内容
  currentCat = 'search';
  currentPage = 1;
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));

  const doFilter = (pool) => {
    const terms = q.split(/\s+/).filter(Boolean);
    const result = pool.filter(a => {
      const hay = ((a.title||'')+' '+(a.desc||'')+' '+(a.sku||'')+' '+(a.cat||'')).toLowerCase();
      return terms.every(t => hay.includes(t));
    });
    // 有真价品优先(占位价/无价沉后)
    const _hp = p => !!p && p<999999 && p!==99999 && p!==888888;
    result.sort((a,b)=> (_hp(b.price)?1:0) - (_hp(a.price)?1:0));
    currentPage = 1;
    pushState('search', 1, q);
    document.getElementById('content-title').textContent = `搜索：${q}（${result.length} 条）`;
    for (let p = 1; p <= Math.ceil(result.length/PAGE_SIZE); p++)
      pageCache[`search-p${p}`] = result.slice((p-1)*PAGE_SIZE, p*PAGE_SIZE);
    pageCache['search-total'] = result.length;
    currentCat = 'search';
    renderPage(pageCache['search-p1'] || []);
  };

  // 统一用全量slim搜索（38871条，已缓存后无需重复fetch）
  if (slimPool) {
    doFilter(slimPool);
  } else {
    document.getElementById('content-total').textContent = '搜索中…';
    document.getElementById('article-grid').innerHTML =
      '<div style="grid-column:1/-1;text-align:center;padding:60px 0;color:#999;font-size:14px">⏳ 搜索中…</div>';
    fetch('/wiki/articles-slim.json?v=1780973162').then(r=>r.json()).then(pool => {
      slimPool = pool;
      doFilter(pool);
    }).catch(()=>doFilter([]));
  }
}

// ── 渲染当前页数据 ────────────────────────────────────
function renderPage(items) {
  const total = currentCat === 'search'
    ? (pageCache['search-total'] || 0)
    : (COUNTS[currentCat] || items.length);
  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

  document.getElementById('content-total').textContent =
    `共 ${total.toLocaleString()} 篇 · 第 ${currentPage} / ${totalPages} 页`;

  const grid = document.getElementById('article-grid');
  grid.innerHTML = items.length
    ? items.map(cardHTML).join('')
    : '<div style="grid-column:1/-1;text-align:center;padding:60px 0;color:#999">没有找到相关文章</div>';
  grid.style.opacity = '1';
  grid.style.pointerEvents = '';

  renderPagination(totalPages);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// 兼容旧调用
function render() { renderPage([]); }

function cardHTML(a) {
  const m = CAT_META[a.cat] || DEFAULT_META;
  const emoji = a.emoji || (a.type === 'knowledge' ? '📖' : '💻');
  const tag = CAT_META[a.cat] ? CAT_META[a.cat].label : (a.cat || '联想');
  const dateStr = a.ts ? a.ts.slice(0,10) : '';
  // product-doc-XXX 是知识库商品文档(无价格), 不走 product 模板, 当文档渲染
  const isKbDoc = (a.slug||'').startsWith('product-doc-');
  const meta = (a.type === 'product' && !isKbDoc)
    ? `${tag} <span class="dot"></span> ${(!a.price||a.price>=999999||a.price===99999||a.price===888888)?"暂未公布":"¥"+Number(a.price).toLocaleString()} <span class="new-badge">商品</span>`
    : (isKbDoc
        ? `${tag} <span class="dot"></span> ${dateStr} <span class="new-badge">产品文档</span>`
        : `${tag} <span class="dot"></span> ${dateStr}`);
  return `<a class="card" href="/wiki/${a.slug}">
    <div class="card-cover" style="background:${m.bg}">
      ${emoji}
      <span class="cat-tag" style="${m.tagStyle}">${tag}</span>
    </div>
    <div class="card-body">
      <div class="card-title">${esc(a.title)}</div>
      <div class="card-desc">${esc((a.desc||'').slice(0,100))}</div>
      <div class="card-meta">${meta}</div>
    </div>
  </a>`;
}

function esc(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── 分页 ─────────────────────────────────────────────
function renderPagination(totalPages) {
  const p = document.getElementById('pagination');
  if (totalPages <= 1) { p.innerHTML = ''; return; }

  let btns = [];
  const addBtn = (n, label, active, disabled) => {
    btns.push(`<button class="page-btn${active?' active':''}${disabled?' ellipsis':''}"
      ${disabled?'disabled':''} onclick="goPage(${n})">${label}</button>`);
  };

  addBtn(currentPage-1, '‹ 上一页', false, currentPage===1);

  // 页码省略逻辑
  const pages = [];
  if (totalPages <= 9) {
    for (let i=1; i<=totalPages; i++) pages.push(i);
  } else {
    pages.push(1);
    if (currentPage > 4) pages.push('…');
    for (let i=Math.max(2,currentPage-2); i<=Math.min(totalPages-1,currentPage+2); i++) pages.push(i);
    if (currentPage < totalPages-3) pages.push('…');
    pages.push(totalPages);
  }

  pages.forEach(n => {
    if (n === '…') {
      btns.push('<button class="page-btn ellipsis" disabled>…</button>');
    } else {
      addBtn(n, n, n===currentPage, false);
    }
  });

  addBtn(currentPage+1, '下一页 ›', false, currentPage===totalPages);
  // 页码跳转输入框
  btns.push(`<span class="page-jump" style="display:inline-flex;align-items:center;gap:4px;margin-left:12px;font-size:13px;color:#666;">
    跳至 <input type="number" min="1" max="${totalPages}" value="${currentPage}"
      style="width:52px;padding:4px 6px;border:1px solid #d0d5dd;border-radius:6px;text-align:center;font-size:13px;"
      onkeydown="if(event.key==='Enter'){goPage(+this.value)}"
      aria-label="跳转页码"> / ${totalPages} 页
    <button onclick="goPage(+this.previousElementSibling.previousElementSibling.value)"
      style="padding:4px 10px;border:1px solid #d0d5dd;border-radius:6px;background:#fff;cursor:pointer;font-size:13px;">GO</button>
  </span>`);
  p.innerHTML = btns.join('');
}

function goPage(n) {
  const total = currentCat === 'search' ? (pageCache['search-total']||0) : (COUNTS[currentCat]||0);
  const totalPages = Math.ceil(total / PAGE_SIZE);
  if (n < 1 || n > totalPages) return;
  if (currentCat === 'search') {
    currentPage = n;
    const q = document.querySelector('.hero-search input').value.trim().toLowerCase();
    pushState('search', n, q);
    renderPage(pageCache[`search-p${n}`] || []);
  } else {
    loadPage(currentCat, n);
  }
}

// ── 更新侧边栏计数（用已知精确数值，不依赖运行时统计）
function updateCounts() {
  Object.entries(COUNTS).forEach(([key, n]) => {
    const el = document.getElementById('cnt-' + key);
    if (el) el.textContent = n.toLocaleString();
  });
  const total = document.getElementById('stat-total');
  if (total) total.textContent = COUNTS.all.toLocaleString();
}

// 分类按钮点击（顶部标签栏）
document.querySelectorAll('.cat-btn[data-cat]').forEach(btn => {
  btn.addEventListener('click', () => filterCat(btn.dataset.cat));
});

// 读取URL参数 ?cat=xxx，自动切换分类
(function() {
  const params = new URLSearchParams(window.location.search);
  const cat = params.get('cat');
  if (cat && cat !== 'all') {
    // 等首页数据加载完再切分类（article-grid有实际内容时）
    const timer = setInterval(() => {
      const grid = document.getElementById('article-grid');
      if (grid && grid.children.length > 0 && !grid.children[0].textContent.includes('加载中')) {
        clearInterval(timer);
        filterCat(cat);
      }
    }, 100);
    // 最多等5秒
    setTimeout(() => clearInterval(timer), 5000);
  }
})();
</script>


<script>/*pageshow-bfcache-fix*/window.addEventListener('pageshow',function(e){if(e.persisted)location.reload();});</script>
</body>
</html>
