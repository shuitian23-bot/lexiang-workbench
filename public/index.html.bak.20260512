// ── Nav active state ──
function setNavActive(key) {
  document.querySelectorAll('.nlinks a').forEach(a => a.classList.remove('nav-active'));
  if (key) {
    const el = document.querySelector('.nlinks a[data-nav="' + key + '"]');
    if (el) el.classList.add('nav-active');
  }
}
async function startChat(msg){
  convId = null;
  document.getElementById('msgsInner').innerHTML = '';
  showChatApp();
  appendBubble('user', msg);
  if (leaiCompare) await callCompareAPI(msg);
  else await callAPI(msg);
}

// ── Quick ask from welcome cards ──
async function quickAsk(msg){
  if(!checkAnonLimit()) return;
  appendBubble('user', msg);
  if(!isLoggedIn()) _anonRounds++;
  if (leaiCompare) await callCompareAPI(msg);
  else await callAPI(msg);
}

// ── Main textarea send ──
// ── 图片上传状态 ──
let _pendingImageUrl = null; // 已上传的图片相对路径
let _pendingImageFile = null; // 原始 File 对象（用于预览）

function onImageFileSelected(input) {
  const file = input.files && input.files[0];
  if (!file) return;
  _pendingImageFile = file;
  // 显示预览
  const reader = new FileReader();
  reader.onload = (e) => {
    document.getElementById('imgPreviewThumb').src = e.target.result;
    document.getElementById('imgPreviewName').textContent = file.name;
    document.getElementById('imgPreviewArea').style.display = 'flex';
  };
  reader.readAsDataURL(file);
  // 同时把 base64 上传到服务端
  const fr2 = new FileReader();
  fr2.onload = async (e) => {
    try {
      const b64 = e.target.result.split(',')[1];
      const mime = file.type || 'image/jpeg';
      const r = await apiFetch('/api/chat/upload-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image_base64: b64, mime_type: mime })
      });
      const d = await r.json();
      if (d.url) {
        _pendingImageUrl = d.url;
      } else {
        console.warn('[ImageUpload] 上传失败:', d);
        clearImagePreview();
      }
    } catch(e) {
      console.warn('[ImageUpload] 网络错误:', e);
      clearImagePreview();
    }
  };
  fr2.readAsDataURL(file);
  // 清空 input 以允许重复选同一文件
  input.value = '';
}

function clearImagePreview() {
  _pendingImageUrl = null;
  _pendingImageFile = null;
  document.getElementById('imgPreviewArea').style.display = 'none';
  document.getElementById('imgPreviewThumb').src = '';
  document.getElementById('imgPreviewName').textContent = '';
}

// ── 音频上传状态 ──
let _pendingAudioUrl = null; // 已上传的音频相对路径
let _pendingAudioFile = null; // 原始 File 对象

function onAudioFileSelected(input) {
  const file = input.files && input.files[0];
  if (!file) return;
  _pendingAudioFile = file;
  // 显示预览（文件名，不是缩略图）
  document.getElementById('audioPreviewName').textContent = file.name;
  document.getElementById('audioPreviewArea').style.display = 'flex';
  // 上传到服务端
  const fr = new FileReader();
  fr.onload = async (e) => {
    try {
      const b64 = e.target.result.split(',')[1];
      const mime = file.type || 'audio/mpeg';
      const r = await apiFetch('/api/chat/upload-audio', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ audio_base64: b64, mime_type: mime })
      });
      const d = await r.json();
      if (d.url) {
        _pendingAudioUrl = d.url;
      } else {
        console.warn('[AudioUpload] 上传失败:', d);
        clearAudioPreview();
      }
    } catch(e) {
      console.warn('[AudioUpload] 网络错误:', e);
      clearAudioPreview();
    }
  };
  fr.readAsDataURL(file);
  input.value = '';
}

function clearAudioPreview() {
  _pendingAudioUrl = null;
  _pendingAudioFile = null;
  document.getElementById('audioPreviewArea').style.display = 'none';
  document.getElementById('audioPreviewName').textContent = '';
}

// 门店查询拦截：检测关键词，提取地点名
const STORE_RE = /门店|专卖店|体验店|服务站|售后.*店|维修.*点/;
const LOC_RE   = /(.{1,15}?)(?:附近|周边|旁边|那边|这边|的门店|的专卖|的联想)/;

function extractStoreLocation(msg) {
  const m = msg.match(LOC_RE);
  if (!m) return null;
  // 去掉句首的"联想""有没有""查"等虚词
  return m[1].replace(/^(联想|有没有|查询一下|查询下|查询|查一下|查下|查|帮我查|帮我找|我想查|我想找|找一下|找下|找|看看|搜索|搜一下|搜|哪里有)\s*/g, '').trim() || null;
}

async function sendMain(directMsg){
  if(!checkAnonLimit()) return;
  const ta = document.getElementById('mainTa');
  const msg = (typeof directMsg === 'string' ? directMsg : ta.value).trim();
  // 有图片或音频时允许消息为空
  const imageUrl = _pendingImageUrl;
  const audioUrl = _pendingAudioUrl;
  if (!msg && !imageUrl && !audioUrl || isLoading) return;
  ta.value = ''; ta.style.height = '';
  document.querySelectorAll('.suggestions').forEach(el => el.remove());

  // 清除图片/音频预览（已保存到局部变量）
  if (imageUrl) clearImagePreview();
  if (audioUrl) clearAudioPreview();

  // ── 门店查询拦截（仅纯文字、非对比模式时）──
  if (!leaiCompare && !imageUrl && !audioUrl && STORE_RE.test(msg)) {
    const loc = extractStoreLocation(msg);
    if (loc) {
      await findStoresByLocation(msg, loc);
      return;
    } else if (/附近|周边|旁边|我这|我在/.test(msg)) {
      // 提到"附近"但没识别到具体地名 → 走 GPS 定位
      await findNearbyStores();
      return;
    }
    // 否则（只说"门店"没说位置）→ 走普通 AI 问答
  }

  const displayMsg = msg || (audioUrl ? '请转写并分析这段音频' : '请分析这张图片');
  appendBubble('user', displayMsg);
  if(!isLoggedIn()) _anonRounds++;
  // 对比模式：仅纯文本支持，有图片/音频走普通模式
  if (leaiCompare && !imageUrl && !audioUrl) await callCompareAPI(displayMsg);
  else await callAPI(displayMsg, imageUrl, audioUrl);
}
document.getElementById('mainSend').addEventListener('click', sendMain);
document.getElementById('mainTa').addEventListener('keydown', e => {
  if (e.key==='Enter' && !e.shiftKey){ e.preventDefault(); sendMain(); }
});
document.getElementById('mainTa').addEventListener('input', function(){
  this.style.height = '';
  this.style.height = Math.min(this.scrollHeight, 150) + 'px';
});

// ── Hero input ──
document.getElementById('heroSend').addEventListener('click', () => {
  const inp = document.getElementById('heroInput');
  const v = inp.value.trim() || inp.placeholder;
  if (v) startChat(v);
});
document.getElementById('heroInput').addEventListener('keydown', e => {
  if (e.key==='Enter' && !e.shiftKey){ e.preventDefault(); document.getElementById('heroSend').click(); }
});
// ── Pills 点击事件（内容已在脚本顶部立即渲染）──
document.getElementById('qpills').addEventListener('click', e => {
  const btn = e.target.closest('.qp');
  if(btn) startChat(btn.textContent.trim());
});
document.querySelectorAll('.tag').forEach(c => {
  c.addEventListener('click', () => { document.querySelectorAll('.tag').forEach(x=>x.classList.remove('active')); c.classList.add('active'); });
});

// ── Utils ──
function scrollBottom(force){
  const w=document.getElementById('msgsWrap');
  // 只在用户没有主动上滑时才自动滚动（距底部100px以内视为在底部）
  if(force || w.scrollHeight - w.scrollTop - w.clientHeight < 100) w.scrollTop=w.scrollHeight;
}
function escHtml(t){ return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ── Copy AI message ──
function copyMsg(btn){
  const text = btn.closest('.msg').querySelector('.mbubble').innerText;
  navigator.clipboard.writeText(text).then(()=>{
    btn.classList.add('copied');
    btn.innerHTML = `<svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>已复制`;
    setTimeout(()=>{ btn.classList.remove('copied'); btn.innerHTML=`<svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>复制`; }, 1800);
  }).catch(()=>{
    btn.innerHTML=`<svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>复制失败`;
    setTimeout(()=>{ btn.innerHTML=`<svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>复制`; }, 1800);
  });
}

// ── Render follow-up suggestions ──
function renderSuggestions(bubbleEl, suggestions) {
  // 移除前一轮 suggestions（保持只有最新一组可见）
  var msgsInner = document.getElementById('msgsInner');
  if (msgsInner) msgsInner.querySelectorAll('.suggestions').forEach(el => el.remove());
  const wrap = document.createElement('div');
  wrap.className = 'suggestions';
  suggestions.forEach(s => {
    const chip = document.createElement('button');
    chip.className = 'suggest-chip';
    chip.textContent = s;
    chip.onclick = () => {
      wrap.remove();
      sendMain(s);
    };
    wrap.appendChild(chip);
  });
  // 插在 bubbleEl（.msg div）之后，保持在 msgsInner 内部，切换对话时会被清除
  bubbleEl.insertAdjacentElement('afterend', wrap);
  scrollBottom();
}

// ── Feedback (thumbs up/down) ──
async function sendFeedback(btn, rating) {
  if (!convId) return;
  const actions = btn.closest('.msg-actions');
  // 清除同一消息之前的选中状态
  actions.querySelectorAll('.fb-like,.fb-dislike').forEach(b => { b.classList.remove('liked','disliked'); });
  btn.classList.add(rating === 1 ? 'liked' : 'disliked');
  try {
    await apiFetch('/api/chat/feedback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ conv_id: convId, rating })
    });
  } catch(e) {}
}

// ── Scroll-to-bottom button ──
(function(){
  const wrap = document.getElementById('msgsWrap');
  const btn = document.getElementById('scrollDownBtn');
  wrap.addEventListener('scroll', ()=>{
    const atBottom = wrap.scrollHeight - wrap.scrollTop - wrap.clientHeight < 80;
    btn.classList.toggle('show', !atBottom);
  });
})();

// ── Scroll reveals ──
const ro = new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('v');ro.unobserve(e.target);}})},{threshold:.1});
document.querySelectorAll('.fi').forEach(el=>ro.observe(el));

// ── Tab switching ──
document.querySelectorAll('.titem').forEach(tab=>{
  tab.addEventListener('click',()=>{
    const map={all:'tabAll',mfg:'tabMfg',edu:'tabEdu',office:'tabOffice'};
    document.querySelectorAll('.titem').forEach(i=>i.classList.remove('active'));
    tab.classList.add('active');
    document.querySelectorAll('.tcontent').forEach(c=>c.classList.remove('active'));
    const el=document.getElementById(map[tab.dataset.tab]);
    if(el) el.classList.add('active');
  });
});

// ── Carousel dots ──
const pcarousel = document.getElementById('pcarousel');
const pcards = pcarousel ? pcarousel.querySelectorAll('.pcard') : [];
const dotsEl = document.getElementById('cdots');
const dc = pcards.length ? Math.ceil(pcards.length/2) : 0;
for(let i=0;i<dc;i++){
  const d=document.createElement('button');
  d.className='cdot'+(i===0?' active':'');
  d.addEventListener('click',()=>{
    pcards[i*2].scrollIntoView({behavior:'smooth',inline:'start',block:'nearest'});
    document.querySelectorAll('.cdot').forEach(x=>x.classList.remove('active'));
    d.classList.add('active');
  });
  dotsEl.appendChild(d);
}
// 手动滑动同步圆点
if(pcarousel) pcarousel.addEventListener('scroll',()=>{
  const idx = Math.round(pcarousel.scrollLeft / (pcarousel.scrollWidth / dc));
  document.querySelectorAll('.cdot').forEach((x,i)=>x.classList.toggle('active',i===idx));
},{passive:true});

// ── 商城商品详情 ──
var mallProducts = {};
(function(){
  if(typeof _siteType !== 'undefined' && _siteType === 'default') return;
  var _site = (typeof _siteType !== 'undefined' && _siteType !== 'default') ? '&site=' + _siteType : '';
  fetch('/api/products?limit=8' + _site).then(function(r){return r.json()}).then(function(products){
    var grid = document.getElementById('mallGrid');
    if (!grid || !products.length) return;
    grid.innerHTML = products.map(function(p){
      mallProducts[p.sku] = {
        name: p.name, slogan: p.description || '', price: '¥' + Number(p.price).toLocaleString(),
        original: p.original_price > p.price ? '¥' + Number(p.original_price).toLocaleString() : '',
        img: p.image_url || '', colors: [], specs: [],
        chat: p.name + ' 的详细配置和购买建议'
      };
      var origHtml = p.original_price > p.price ? ' <span class="mall-original">¥' + Number(p.original_price).toLocaleString() + '</span>' : '';
      return '<div class="mall-card" data-product="' + p.sku + '">' +
        '<div class="mall-img"><img src="' + (p.image_url||'') + '" alt="' + escHtml(p.name) + '" onerror="this.style.display=\'none\'"></div>' +
        '<div class="mall-info"><div class="mall-name">' + escHtml(p.name) + '</div>' +
        '<div class="mall-desc">' + escHtml((p.description||'').substring(0,40)) + '</div>' +
        '<div class="mall-price">¥' + Number(p.price).toLocaleString() + origHtml + '</div></div></div>';
    }).join('');
    console.log('[MallGrid] rendered ' + grid.children.length + ' cards');
  }).catch(function(e){ console.error('[MallGrid] FAILED:', e); });
})();

function openDetail(el) {
  var card = el.closest ? el.closest('.mall-card') : el;
  if (!card) card = el;
  showProductDetail(card.dataset.product);
}


// ── AI展示画布 ──
function showDisplayCanvas(title, products) {
  var dc = document.getElementById('displayCanvas');
  var body = document.getElementById('dcBody');
  body.style.display = '';
  body.style.gridTemplateColumns = '';
  document.getElementById('dcTitle').textContent = title;
  body.innerHTML = products.map(function(p) {
    var img = escHtml(p.image_url || p.图片 || '');
    var name = escHtml(p.name || p.名称 || '');
    var desc = escHtml(p.description || p.描述 || p.分类 || '');
    var price = p.price || p.价格 || '';
    var origPrice = p.original_price || p.原价 || '';
    var sku = p.sku || p.SKU || '';
    return '<a class="dc-card" href="#" onclick="if(\'' + escHtml(sku) + '\'){showProductDetail(\'' + escHtml(sku) + '\')};return false">' +
      '<img src="' + img + '" alt="' + name + '" loading="lazy">' +
      '<div class="dc-card-info">' +
        '<div class="dc-card-name">' + name + '</div>' +
        (desc ? '<div class="dc-card-desc">' + desc + '</div>' : '') +
        (price ? '<div class="dc-card-price">¥' + Number(price).toLocaleString() + (origPrice ? '<span class="dc-orig">¥' + Number(origPrice).toLocaleString() + '</span>' : '') + '</div>' : '') +
      '</div></a>';
  }).join('');
  var lp = document.getElementById('landingPage');
  if (lp) { lp.scrollTop = 0; lp.style.overflow = 'hidden'; lp.classList.add('dc-open'); }
  dc.style.display = 'block';
  dc.scrollTop = 0;
  var topbar = dc.querySelector('.dc-topbar');
  if (topbar) topbar.style.display = '';
}
function closeDisplayCanvas() {
  var dc = document.getElementById('displayCanvas');
  dc.style.display = 'none';
  var topbar = dc.querySelector('.dc-topbar');
  if (topbar) topbar.style.display = '';
  var body = document.getElementById('dcBody');
  if (body) { body.style.display = ''; body.style.gridTemplateColumns = ''; }
  var lp = document.getElementById('landingPage');
  if (lp) { lp.style.overflow = ''; lp.style.height = ''; lp.classList.remove('dc-open'); }
  window.__currentProduct = null;
}
window.showDisplayCanvas = showDisplayCanvas;
window.closeDisplayCanvas = closeDisplayCanvas;
function showCategoryProducts(category) {
  var dc = document.getElementById('displayCanvas');
  var body = document.getElementById('dcBody');
  document.getElementById('dcTitle').textContent = category;
  body.innerHTML = '<div style="text-align:center;padding:60px;color:#999">加载中...</div>';
  var topbar = dc.querySelector('.dc-topbar');
  if (topbar) topbar.style.display = '';
  dc.style.display = 'block';
  dc.scrollTop = 0;
  fetch('/api/products?category=' + encodeURIComponent(category) + '&limit=20')
    .then(function(r){ return r.json(); })
    .then(function(products){ showDisplayCanvas(category, products); });
}
window.showCategoryProducts = showCategoryProducts;

// ── 商品详情页（左侧渲染，联想商城风格） ──
async function showProductDetail(sku) {
  startBuyFlow._done = false;
  startBuyFlow._running = false;
  var dc = document.getElementById('displayCanvas');
  var body = document.getElementById('dcBody');
  document.getElementById('dcTitle').textContent = '加载中...';
  body.innerHTML = '<div style="text-align:center;padding:60px;color:#999">正在加载商品信息...</div>';
  var lp = document.getElementById('landingPage');
  if (lp) { lp.scrollTop = 0; lp.style.overflow = 'hidden'; lp.classList.add('dc-open'); }
  dc.style.display = 'block';
  dc.scrollTop = 0;
  body.style.display = 'block';
  body.style.gridTemplateColumns = '1fr';
  var topbar = dc.querySelector('.dc-topbar');
  if (topbar) topbar.style.display = 'none';
  try {
    var res = await fetch('/api/products/' + encodeURIComponent(sku));
    if (!res.ok) { body.innerHTML = '<div style="text-align:center;padding:60px;color:#999">未找到该商品</div>'; return; }
    var p = await res.json();
    var specs = p.specs || {};
    var imgUrl = p.image_url || '';
    var buyUrl = specs.url || 'https://item.lenovo.com.cn/product/' + sku + '.html';
    document.getElementById('dcTitle').textContent = p.name;
    window.__currentProduct = { sku: p.sku, name: p.name, category: p.category, price: p.price, description: p.description };
    notifyAIProductContext(p);

    // 从 description 提取亮点（按 / 分隔的配置项）
    var highlights = [];
    if (p.description) {
      var parts = p.description.split('/');
      if (parts.length >= 3) highlights = parts.map(function(s){ return s.trim(); }).filter(Boolean);
    }

    // 从 specs 提取可展示参数
    var skipKeys = ['url','bu_ids','lvl1','lvl2','lvl3','target_user','highlights','images','ad_picture','is_ai','bu','mtm'];
    var labelMap = {brand:'品牌',color:'颜色',weight:'重量',screen_size:'屏幕尺寸',battery:'电池',os:'操作系统',cpu:'处理器',gpu:'显卡',ram:'内存',storage:'存储',resolution:'分辨率'};
    var specRowsInline = '';
    var specTableRows = '';
    Object.keys(specs).forEach(function(k) {
      if (skipKeys.indexOf(k) >= 0 || !specs[k]) return;
      var v = specs[k];
      if (typeof v === 'object') return;
      var label = labelMap[k] || k;
      specRowsInline += '<div class="pd-spec-row"><span class="pd-spec-label">' + escHtml(label) + '</span><span class="pd-spec-value">' + escHtml(String(v)) + '</span></div>';
      specTableRows += '<tr><td>' + escHtml(label) + '</td><td>' + escHtml(String(v)) + '</td></tr>';
    });

    // 解析 target_user
    var targetUsers = [];
    try { if (specs.target_user) targetUsers = JSON.parse(specs.target_user); } catch(e){}

    var priceInt = String(Math.floor(p.price));
    var priceDec = p.price % 1 ? '.' + String(p.price).split('.')[1] : '';

    // 下半部分：配置亮点 grid
    var hlGridHtml = '';
    if (highlights.length > 0) {
      hlGridHtml = '<h4 class="pd-hl-title">配置亮点</h4><div class="pd-hl-grid">' +
        highlights.map(function(h){ return '<div class="pd-hl-item">' + escHtml(h) + '</div>'; }).join('') + '</div>';
    }
    // 适合人群
    var tuHtml = '';
    if (targetUsers.length > 0) {
      tuHtml = '<h4 class="pd-tu-title">适合人群</h4><div class="pd-tu-grid">' +
        targetUsers.map(function(u){ return '<span class="pd-tu-tag">' + escHtml(u) + '</span>'; }).join('') + '</div>';
    }
    // 规格参数表
    var specsTblHtml = specTableRows ? '<table class="pd-specs-tbl">' +
      '<tr><td>商品名称</td><td>' + escHtml(p.name) + '</td></tr>' +
      '<tr><td>分类</td><td>' + escHtml(p.category || '-') + '</td></tr>' +
      '<tr><td>SKU</td><td>' + escHtml(String(p.sku)) + '</td></tr>' +
      specTableRows + '</table>' :
      '<div style="text-align:center;padding:40px;color:#999">暂无详细规格参数</div>';

    body.innerHTML =
      '<div class="pd-page">' +
        '<div class="pd-breadcrumb">' +
          '<a onclick="closeDisplayCanvas()" style="cursor:pointer">首页</a><span class="sep">/</span>' +
          '<a onclick="showCategoryProducts(\'' + escHtml(p.category || '商品').replace(/'/g, "\\'") + '\')" style="cursor:pointer">' + escHtml(p.category || '商品') + '</a><span class="sep">/</span>' +
          '<span style="color:var(--text);font-weight:500">' + escHtml(p.name) + '</span>' +
        '</div>' +
        '<div class="pd-detail-main">' +
          '<div class="pd-gallery">' +
            '<div class="pd-main-img"><img src="' + imgUrl + '" alt="' + escHtml(p.name) + '"></div>' +
          '</div>' +
          '<div class="pd-info">' +
            '<div class="pd-prod-name">' + escHtml(p.name) + '</div>' +
            (p.description ? '<div class="pd-prod-brief">' + escHtml(p.description) + '</div>' : '') +
            '<div class="pd-price-box">' +
              '<span class="pd-price-label">价格</span>' +
              '<span class="pd-price-val"><small>¥</small>' + priceInt + (priceDec ? '<small>' + priceDec + '</small>' : '') + '</span>' +
              (p.original_price && p.original_price > p.price ? '<span class="pd-price-orig">¥' + Number(p.original_price).toLocaleString() + '</span>' : '') +
            '</div>' +
            '<div class="pd-stock">' +
              (p.stock > 0 ? '<span class="in">● 有货</span><span style="color:#999;margin-left:8px">库存 ' + (p.stock > 999 ? '充足' : p.stock + '件') + '</span>' : '<span class="out">● 无货</span>') +
              '<span style="color:#999;margin-left:8px">' + (p.status === 'active' ? '在售' : '已下架') + '</span>' +
            '</div>' +
            (highlights.length > 0 ? '<div class="pd-spec-list">' + highlights.map(function(h){ return '<div class="pd-spec-row"><span class="pd-spec-label">亮点</span><span class="pd-spec-value">' + escHtml(h) + '</span></div>'; }).join('') + '</div>' : '') +
            (specRowsInline ? '<div class="pd-spec-list">' + specRowsInline + '</div>' : '') +
            '<div class="pd-action-btns">' +
              '<button class="pd-btn-buy" onclick="startBuyFlow(\'' + escHtml(p.name).replace(/'/g, "\\'") + '\',' + (p.price||0) + ')">立即购买</button>' +
              '<button class="pd-btn-cart" onclick="quickAsk(\'我想把 ' + escHtml(p.name).replace(/'/g, "\\'") + ' 加入购物车，有什么优惠可以一起用吗？\')">加入购物车</button>' +
              '<button class="pd-btn-ask" onclick="askAboutProduct()">问AI助手</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        // 下半部分：tabs + 详情内容
        '<div class="pd-detail-below">' +
          '<div class="pd-tabs">' +
            '<button class="pd-tab active" onclick="switchPdTab(this,0)">商品详情</button>' +
            '<button class="pd-tab" onclick="switchPdTab(this,1)">规格参数</button>' +
          '</div>' +
          '<div class="pd-tab-panel active">' +
            hlGridHtml +
            tuHtml +
            '<div class="pd-detail-img"><img src="' + imgUrl + '" alt="' + escHtml(p.name) + '"></div>' +
          '</div>' +
          '<div class="pd-tab-panel">' +
            specsTblHtml +
          '</div>' +
        '</div>' +
      '</div>';
    var base = window.__chatBase || '/chat';
    history.pushState({displayCanvas:true, sku:sku}, '', base + '/product/' + sku + '.html');
  } catch(e) {
    body.innerHTML = '<div style="text-align:center;padding:60px;color:#999">加载失败，请稍后重试</div>';
  }
}
function askAboutProduct() {
  var p = window.__currentProduct;
  if (p) quickAsk('请详细介绍一下 ' + p.name + '（SKU: ' + p.sku + '），包括配置、优缺点和适合人群。');
}
function switchPdTab(btn, idx) {
  var tabs = btn.parentNode.querySelectorAll('.pd-tab');
  var panels = btn.closest('.pd-detail-below').querySelectorAll('.pd-tab-panel');
  tabs.forEach(function(t){ t.classList.remove('active'); });
  panels.forEach(function(p){ p.classList.remove('active'); });
  btn.classList.add('active');
  if (panels[idx]) panels[idx].classList.add('active');
}
window.switchPdTab = switchPdTab;
window.showProductDetail = showProductDetail;

function notifyAIProductContext(p) {
  var ov = document.getElementById('productOverlay');
  var bar = document.getElementById('productChipsBar');
  if (!ov) return;
  var isSplit = document.documentElement.classList.contains('split-mode');
  var isChatVisible = isSplit || document.documentElement.classList.contains('is-chat');
  if (!isChatVisible) { window.__pendingProductCtx = p; return; }
  window.__pendingProductCtx = null;
  var priceStr = p.price ? ' <span class="ov-price">¥' + Number(p.price).toLocaleString() + '</span>' : '';
  var n = escHtml(p.name).replace(/'/g, "\\'");
  var cat = (p.category || '').toLowerCase();
  var chips;
  if (cat.indexOf('手机') >= 0) {
    chips = [['拍照表现如何？','的拍照和影像表现怎么样'],['续航够用吗？','电池续航表现如何'],['和同价位手机比？','和同价位竞品手机对比']];
  } else if (cat.indexOf('平板') >= 0) {
    chips = [['适合办公吗？','适合办公和学习吗，有键盘配件吗'],['屏幕素质？','的屏幕分辨率、色域表现如何'],['和iPad比？','和同价位iPad对比优劣']];
  } else if (cat.indexOf('笔记本') >= 0 || cat.indexOf('电脑') >= 0) {
    chips = [['性能够用吗？','的CPU/GPU性能表现如何，适合什么场景'],['散热和噪音？','散热表现和噪音控制如何'],['和竞品对比？','和同价位竞品笔记本对比']];
  } else if (cat.indexOf('服务器') >= 0 || cat.indexOf('工作站') >= 0) {
    chips = [['配置方案？','推荐什么配置方案，适合什么业务场景'],['售后服务？','的保修和企业售后服务如何'],['和竞品对比？','和同类竞品对比']];
  } else {
    chips = [['值得买吗？','值得买吗？优缺点分析一下'],['对比竞品','和同价位竞品对比'],['有优惠吗？','有什么优惠活动吗']];
  }
  window.__currentProductChips = chips;
  window.__currentProductQuery = n;
  ov.innerHTML =
    '<div class="ov-top"><div><div class="ov-label">正在浏览</div>' +
    '<div class="ov-name">' + escHtml(p.name) + priceStr + '</div></div>' +
    '<button class="ov-close" onclick="dismissProductOverlay()"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>' +
    '<div class="ov-chips">' +
      chips.map(function(c){ return '<button onclick="dismissProductOverlay();quickAsk(\'这款 ' + n + ' ' + c[1] + '\')">' + c[0] + '</button>'; }).join('') +
    '</div>';
  ov.classList.remove('hiding');
  if (bar) bar.classList.add('hidden');
}
function dismissProductOverlay() {
  var ov = document.getElementById('productOverlay');
  if (ov) ov.classList.add('hiding');
  var bar = document.getElementById('productChipsBar');
  var chips = window.__currentProductChips;
  var n = window.__currentProductQuery;
  if (bar && chips && n) {
    bar.innerHTML = chips.map(function(c){ return '<button onclick="quickAsk(\'这款 ' + n + ' ' + c[1] + '\')">' + c[0] + '</button>'; }).join('');
    bar.classList.remove('hidden');
  }
}

// ── AI 弹层系统（由 SSE event:modal 触发） ──
function showAIModal(data) {
  document.querySelectorAll('.ai-modal-mask').forEach(function(m){ m.remove(); });
  if (data.error) return;
  var mask = document.createElement('div');
  mask.className = 'ai-modal-mask';
  mask.onclick = function(e){ if (e.target === mask) mask.remove(); };

  if (data.type === 'compare' && data.products?.length >= 2) {
    var products = data.products;
    // 收集所有 specs key
    var specKeys = {};
    products.forEach(function(p){
      if (p.specs) Object.keys(p.specs).forEach(function(k){
        if (k !== 'url' && k !== 'bu_ids') specKeys[k] = true;
      });
    });
    var keys = Object.keys(specKeys);

    var colW = Math.max(180, Math.floor(600 / products.length));
    var headHtml = '<th class="cmp-label-col">参数</th>';
    var imgRow = '<td class="cmp-label-col">外观</td>';
    var priceRow = '<td class="cmp-label-col">价格</td>';
    var catRow = '<td class="cmp-label-col">分类</td>';
    var descRow = '<td class="cmp-label-col">简介</td>';
    var buyRow = '<td class="cmp-label-col">操作</td>';

    products.forEach(function(p){
      var img = p.image_url || '';
      headHtml += '<th class="cmp-prod-col" style="min-width:'+colW+'px"><div class="cmp-prod-name">' + escHtml(p.name) + '</div></th>';
      imgRow += '<td><div class="cmp-img-wrap">' + (img ? '<img src="'+img+'" alt="">' : '<div class="cmp-no-img">暂无图</div>') + '</div></td>';
      priceRow += '<td><span class="cmp-price">¥' + Number(p.price).toLocaleString() + '</span>' +
        (p.original_price && p.original_price > p.price ? '<span class="cmp-orig">¥' + Number(p.original_price).toLocaleString() + '</span>' : '') + '</td>';
      catRow += '<td>' + escHtml(p.category || '-') + '</td>';
      descRow += '<td class="cmp-desc">' + escHtml((p.description || '').slice(0, 100)) + '</td>';
      buyRow += '<td><a href="' + (p.url || '#') + '" target="_blank" class="cmp-buy">去购买</a>' +
        '<button class="cmp-ask" onclick="document.querySelector(\'.ai-modal-mask\').remove();quickAsk(\'详细介绍 ' + escHtml(p.name).replace(/'/g,"\\'") + '\')">问AI</button></td>';
    });

    var specRows = '';
    keys.forEach(function(k){
      var label = k;
      var row = '<td class="cmp-label-col">' + escHtml(label) + '</td>';
      products.forEach(function(p){
        var v = p.specs?.[k];
        row += '<td>' + escHtml(v != null ? String(v) : '-') + '</td>';
      });
      specRows += '<tr>' + row + '</tr>';
    });

    mask.innerHTML =
      '<div class="ai-modal cmp-modal">' +
        '<button class="ai-modal-close" onclick="this.closest(\'.ai-modal-mask\').remove()">×</button>' +
        '<div class="ai-modal-title">' + escHtml(data.title) + '</div>' +
        '<div class="cmp-table-wrap"><table class="cmp-table">' +
          '<thead><tr>' + headHtml + '</tr></thead>' +
          '<tbody>' +
            '<tr class="cmp-img-row">' + imgRow + '</tr>' +
            '<tr>' + priceRow + '</tr>' +
            '<tr>' + catRow + '</tr>' +
            '<tr>' + descRow + '</tr>' +
            specRows +
            '<tr class="cmp-buy-row">' + buyRow + '</tr>' +
          '</tbody>' +
        '</table></div>' +
      '</div>';
  } else if (data.type === 'info') {
    var rendered = typeof marked !== 'undefined' ? marked.parse(data.content || '') : escHtml(data.content || '');
    mask.innerHTML =
      '<div class="ai-modal">' +
        '<button class="ai-modal-close" onclick="this.closest(\'.ai-modal-mask\').remove()">×</button>' +
        '<div class="ai-modal-title">' + escHtml(data.title) + '</div>' +
        '<div class="ai-modal-body">' + rendered + '</div>' +
      '</div>';
  }
  document.body.appendChild(mask);
}

// ── 商城卡片点击（事件委托 + inline onclick 兼容）──
window.openDetail = openDetail;
(function(){
  var grid = document.querySelector('.mall-grid');
  if (grid) {
    grid.addEventListener('click', function(e) {
      var card = e.target.closest('.mall-card');
      if (card) openDetail(card);
    });
  }
})();

// ── 商城 Banner 轮播 ──
(function(){
  var slides = document.querySelectorAll('.mall-slide');
  var dots = document.querySelectorAll('.mall-dot');
  if(!slides.length) return;
  var cur = 0;
  function show(i){
    slides[cur].classList.remove('active');
    dots[cur].classList.remove('active');
    cur = i;
    slides[cur].classList.add('active');
    dots[cur].classList.add('active');
  }
  dots.forEach(function(d,i){ d.addEventListener('click',function(){ clearInterval(timer); show(i); timer=setInterval(next,4000); }); });
  function next(){ show((cur+1)%slides.length); }
  var timer = setInterval(next, 4000);
  var hero = document.querySelector('.mall-hero');
  if(hero){
    hero.addEventListener('mouseenter',function(){ clearInterval(timer); });
    hero.addEventListener('mouseleave',function(){ timer=setInterval(next,4000); });
  }
})();

// ── URL router: restore state on refresh ──
async function restoreFromUrl(){
  // 等登录态检查完成再做路由，避免已登录用户被弹登录框
  if (window._authReady) await window._authReady;
  const p = location.pathname;
  var chatPrefixes = ['/shop-chat','/b-chat','/biz-chat','/chat'];
  var matchedBase = chatPrefixes.find(x => p.startsWith(x));
  if (matchedBase){
    var rest = p.slice(matchedBase.length);
    var productMatch = rest.match(/^\/product\/(\d+)\.html/);
    var activityMatch = rest.match(/^\/activity\/(.+)\.html/);
    if (productMatch) {
      await loadConvList();
      openChatFresh();
      showProductDetail(productMatch[1]);
    } else if (activityMatch) {
      await loadConvList();
      openChatFresh();
    } else {
      const id = rest.split('/')[1];
      if (id) {
        await Promise.all([loadConvList(), loadConv(id)]);
      } else {
        await loadConvList();
        openChatFresh();
      }
    }
  }
}
restoreFromUrl();

// ── 按地点名搜门店（地理编码 → 周边搜索） ──
async function findStoresByLocation(origMsg, locName) {
  showChatApp();
  appendBubble('user', origMsg);
  const bubbleEl = appendBubble('ai', '');
  const mbubble = bubbleEl.querySelector('.mbubble');
  mbubble.textContent = `🔍 正在定位"${locName}"…`;

  try {
    const geoRes = await apiFetch(`/api/stores/geocode?address=${encodeURIComponent(locName)}`);
    const geo = await geoRes.json();
    if (geo.error) { mbubble.textContent = geo.error; return; }

    mbubble.textContent = '🏪 正在搜索附近联想门店…';
    const storeRes = await apiFetch(`/api/stores/nearby?lat=${geo.lat}&lng=${geo.lng}`);
    const result = await storeRes.json();
    if (result.error) { mbubble.textContent = result.error; return; }

    renderStoreCards(mbubble, result.stores || [], geo.lat, geo.lng, geo.name);
  } catch (e) {
    mbubble.textContent = '搜索失败，请稍后重试。';
  }
}

// ── 门店查询（GPS 定位 + 百度POI） ──
async function findNearbyStores() {
  showChatApp();
  const userBubble = appendBubble('user', '查询附近联想门店');
  const bubbleEl = appendBubble('ai', '');
  const mbubble = bubbleEl.querySelector('.mbubble');
  mbubble.textContent = '📍 正在获取您的位置…';

  if (!navigator.geolocation) {
    // 降级：走 AI 问答
    userBubble.remove(); bubbleEl.remove();
    await startChat('我想查询附近的联想门店，请问如何找到最近的线下服务中心或体验店？');
    return;
  }

  let position;
  try {
    position = await new Promise((resolve, reject) =>
      navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 20000, enableHighAccuracy: false })
    );
  } catch (err) {
    // 拒绝授权或超时 → 降级走 AI 问答
    userBubble.remove(); bubbleEl.remove();
    await startChat('我想查询附近的联想门店，请问如何找到最近的线下服务中心或体验店？');
    return;
  }

  const { latitude: lat, longitude: lng } = position.coords;
  mbubble.textContent = '🔍 正在搜索附近门店…';

  let result;
  try {
    const res = await apiFetch(`/api/stores/nearby?lat=${lat}&lng=${lng}`);
    result = await res.json();
  } catch (e) {
    userBubble.remove(); bubbleEl.remove();
    await startChat('我想查询附近的联想门店，请问如何找到最近的线下服务中心或体验店？');
    return;
  }

  if (result.error) {
    // 后端地图 API 不可用 → 降级走 AI 问答，不暴露原始错误给用户
    userBubble.remove(); bubbleEl.remove();
    await startChat('我想查询附近的联想门店，请问如何找到最近的线下服务中心或体验店？');
    return;
  }

  const stores = result.stores || [];
  renderStoreCards(mbubble, stores, lat, lng);
}

function distText(m) {
  return m < 1000 ? m + ' m' : (m / 1000).toFixed(1) + ' km';
}

function renderStoreCards(mbubble, stores, userLat, userLng, centerName) {
  if (!stores.length) {
    const loc = centerName ? `"${centerName}"附近` : '20 公里内';
    mbubble.innerHTML = `😔 未找到${loc}的联想门店，建议访问 <a href="https://www.lenovo.com.cn/store/" target="_blank">联想官网门店查询</a>。`;
    return;
  }

  const total = stores.length;
  const INIT_SHOW = 3;

  const wrap = document.createElement('div');
  wrap.className = 'store-wrap';

  const intro = document.createElement('div');
  intro.className = 'store-intro';
  const loc = centerName ? `"${centerName}"附近` : '您附近';
  intro.textContent = `为您找到 ${loc} ${total} 家联想门店：`;
  wrap.appendChild(intro);

  stores.forEach((s, i) => {
    const card = document.createElement('div');
    card.className = 'store-card' + (i >= INIT_SHOW ? ' store-hidden' : '');

    // 百度地图导航（BD09坐标）
    const navUrl = `https://api.map.baidu.com/marker?location=${s.lat},${s.lng}&title=${encodeURIComponent(s.name)}&content=${encodeURIComponent(s.address)}&output=html&coord_type=bd09ll`;

    card.innerHTML = `
      <div class="store-card-top">
        <div class="store-name">${escHtml(s.name)}</div>
        <div class="store-dist">${distText(s.dist)}</div>
      </div>
      <div class="store-addr">${escHtml(s.address || '暂无地址')}</div>
      <div class="store-footer">
        ${s.tel ? `<a class="store-tel" href="tel:${escHtml(s.tel)}"><svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>${escHtml(s.tel)}</a><span class="store-sep">·</span>` : ''}
        <a class="store-nav" href="${navUrl}" target="_blank"><svg viewBox="0 0 24 24"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>导航</a>
      </div>`;
    wrap.appendChild(card);
  });

  if (total > INIT_SHOW) {
    const btn = document.createElement('button');
    btn.className = 'store-expand-btn';
    btn.innerHTML = `<svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>展开更多（共 ${total} 家）`;
    btn.onclick = function() {
      const hidden = wrap.querySelectorAll('.store-hidden');
      const isExpanded = btn.classList.contains('expanded');
      hidden.forEach(el => el.classList.toggle('store-hidden', isExpanded));
      if (isExpanded) {
        // 收起：重新隐藏 INIT_SHOW 之后的
        wrap.querySelectorAll('.store-card').forEach((el, i) => {
          if (i >= INIT_SHOW) el.classList.add('store-hidden');
        });
        btn.classList.remove('expanded');
        btn.innerHTML = `<svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>展开更多（共 ${total} 家）`;
      } else {
        wrap.querySelectorAll('.store-card').forEach(el => el.classList.remove('store-hidden'));
        btn.classList.add('expanded');
        btn.innerHTML = `<svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>收起`;
      }
      scrollBottom();
    };
    wrap.appendChild(btn);
  }

  mbubble.innerHTML = '';
  mbubble.appendChild(wrap);
  scrollBottom();
}

