<script>
// ── Preview Panel ──
let _previewUrl = '';
function resolvePreviewUrl(url) {
  return fetch('/api/resolve-link?url=' + encodeURIComponent(url))
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(data){ return data && data.url ? data.url : url; })
    .catch(function(){ return url; });
}
async function openPreview(url) {
  const originalUrl = url;
  url = await resolvePreviewUrl(url);
  _previewUrl = url;
  const panel = document.getElementById('previewPanel');
  const iframe = document.getElementById('previewIframe');
  const fb = document.getElementById('previewFallback');
  document.getElementById('previewUrl').textContent = url !== originalUrl ? url + '（已校正链接）' : url;
  fb.style.display = 'none';
  iframe.style.display = 'block';
  const proxyUrl = '/api/preview?url=' + encodeURIComponent(url);
  iframe.src = proxyUrl;
  panel.classList.add('open');
}
function showPreviewFallback(url) {
  document.getElementById('previewIframe').style.display = 'none';
  const fb = document.getElementById('previewFallback');
  fb.style.display = 'flex';
  document.getElementById('previewFallbackLink').href = url;
}
function closePreview() {
  const panel = document.getElementById('previewPanel');
  panel.classList.remove('open');
  setTimeout(() => { document.getElementById('previewIframe').src = 'about:blank'; }, 300);
  _previewUrl = '';
}
function openPreviewExternal() { if (_previewUrl) window.open(_previewUrl, '_blank'); }

// ── Global link interceptor: all external links open in preview panel ──
document.addEventListener('click', function(e) {
  const a = e.target.closest('a[href]');
  if (!a) return;
  const href = a.getAttribute('href');
  if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('/api/')) return;
  if (href.startsWith('http') || href.startsWith('//')) {
    e.preventDefault();
    e.stopPropagation();
    const url = href.startsWith('//') ? 'https:' + href : href;
    openPreview(url);
  }
}, true);

// ── Configure marked: all links open in preview panel ──
if (typeof marked !== 'undefined') {
  const renderer = new marked.Renderer();
  renderer.link = function(href, title, text) {
    const safeHref = (href || '').replace(/"/g, '&quot;').replace(/'/g, "\\'");
    const label = text || href || '链接';
    return '<a href="javascript:void(0)" onclick="openPreview(\'' + safeHref + '\')" style="cursor:pointer">' + label + '</a>';
  };
  marked.setOptions({ renderer: renderer });
}

// ══════════════════════════════════════
//  持久 Session UID
//  localStorage + 1年 cookie 双保险
//  清缓存不影响，只有手动清 cookie 才重置
// ══════════════════════════════════════
const _UID = (() => {
  const KEY = 'lexiang-uid';
  const readCookie = () => { const m = document.cookie.match(/(?:^|;\s*)lexiang-uid=([^;]+)/); return m ? m[1] : null; };
  const writeCookie = (v) => { document.cookie = `${KEY}=${v}; max-age=${365*24*3600}; path=/; SameSite=Lax`; };
  let uid = null;
  try { uid = localStorage.getItem(KEY); } catch(_) {}
  if (!uid) uid = readCookie();
  if (!uid) uid = 'u-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 9);
  try { localStorage.setItem(KEY, uid); } catch(_) {}
  writeCookie(uid);
  return uid;
})();

function apiFetch(url, options = {}) {
  options.headers = Object.assign({ 'x-session-id': _UID }, options.headers || {});
  return fetch(url, options);
}

// ── 登录态 ──
let _loginUser = null;
let _anonRounds = 0; // 未登录本 session 已聊轮数

function isLoggedIn(){ return !!_loginUser; }

function requireLogin(callback){
  if(isLoggedIn()){ if(callback) callback(); return; }
  showLoginModal();
  if(callback) window._afterLogin = callback;
}

function onLoginSuccess(user){
  _loginUser = user;
  _anonRounds = 0;
  updateNavUser(user);
  loadConvList(); // 刷新历史
  if(window._afterLogin){ window._afterLogin(); window._afterLogin = null; }
}

function checkAnonLimit(){
  if(isLoggedIn()) return true;
  if(_anonRounds < 2) return true;
  showLoginModal();
  return false;
}

// ══════════════════════════════════════
//  前端日志 & 错误上报 (Telemetry)
// ══════════════════════════════════════
const _log = {
  _send(payload){
    try{ navigator.sendBeacon('/api/log', new Blob([JSON.stringify(payload)], {type:'application/json'})); }catch(_){}
  },
  error(message, stack, extra){
    console.error('[FE]', message, extra || '');
    this._send({ type:'error', message, stack, url: location.href, extra });
  },
  apiError(url, status, message){
    console.warn('[API]', status, url, message);
    this._send({ type:'api_error', message: `${status} ${url}: ${message}`, url: location.href });
  },
  event(name, data){
    this._send({ type:'event', message: name, url: location.href, extra: data });
  }
};
window.addEventListener('error', e => {
  _log.error(e.message, e.error?.stack, { file: e.filename, line: e.lineno });
});
window.addEventListener('unhandledrejection', e => {
  _log.error('UnhandledRejection: ' + (e.reason?.message || String(e.reason)), e.reason?.stack);
});

