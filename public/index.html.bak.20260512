function applyLang() {
  const s = I18N[currentLang];
  document.getElementById('chatTitle').textContent = s.title;
  document.getElementById('mainTa').placeholder = s.placeholder;
  document.querySelector('.input-hint').textContent = s.hint;
  document.getElementById('webSearchLabel').textContent = s.webSearch;
  document.getElementById('thinkLabel').textContent = s.thinking;
  var langBtn = document.getElementById('langBtn'); if (langBtn) langBtn.classList.toggle('active', currentLang === 'en');
  // Sidebar
  document.getElementById('newConvLabel').textContent = s.newConv;
  document.getElementById('historyLabel').textContent = s.history;
  document.getElementById('backHomeLabel').textContent = s.backHome;
  const noHistEl = document.getElementById('noHistoryLabel');
  if (noHistEl) noHistEl.textContent = s.noHistory;
  const themeToggleLabel = document.getElementById('themeToggleLabel');
  if (themeToggleLabel) themeToggleLabel.textContent = s.themeToggle;
}

function toggleLang() {
  currentLang = currentLang === 'zh' ? 'en' : 'zh';
  localStorage.setItem('lexiang-lang', currentLang);
  applyLang();
}

function toggleWebSearch() {
  webSearchEnabled = !webSearchEnabled;
  document.getElementById('webSearchToggle').classList.toggle('active-web', webSearchEnabled);
}

function toggleThinking() {
