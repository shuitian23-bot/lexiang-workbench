<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>联想乐享AI - 联想官方AI购物助手</title>
<meta name="description" content="联想乐享AI官方购物助手，智能导购、商品对比、优惠查询、企业方案，让购买联想产品更简单高效。">
<meta property="og:title" content="联想乐享AI - 联想官方AI购物助手">
<meta property="og:description" content="智能导购、商品对比、优惠查询、企业方案，让购买联想产品更简单高效。">
<meta property="og:type" content="website">
<meta property="og:image" content="https://leaibot.cn/favicon.svg">
<link rel="canonical" href="https://leaibot.cn/shop-chat">
<script src="/marked.min.js"></script>
<style>

*{margin:0;padding:0;box-sizing:border-box}
/* ════ LIGHT ════ */
:root,[data-theme="light"]{
  --bg:#F7F5FB;--bg-chat:#ffffff;--text:#1A1A2E;--text2:#666580;--border:#EBE5F2;--card:#F4EFFA;--card2:#fff;
  --accent:#E12521;--primary:#3D0366;--primary-grad:linear-gradient(135deg,#3D0366,#87112b);
  --nav-bg:rgba(255,255,255,.95);--nav-bd:#EBE5F2;
  --search-bg:#ffffff;--search-bd:#DDD5E8;
  --tag-bg:#F4EFFA;--tag-bd:#DDD5E8;
  --hero-bg:#F7F5FB;--hp:rgba(200,180,240,.25);--hb:rgba(135,17,43,.1);--hv:rgba(61,3,102,.12);--hr:rgba(225,37,33,.08);
  --icon-bg:#EBE5F2;--cta-bg:#F4EFFA;--ft-bd:#EBE5F2;
  --btn-bg:#3D0366;--btn-bg2:#2a0248;--btn-c:#fff;
  --tog-bg:#DDD5E8;--tog-knob:#fff;--logo-f:none;
  --send-btn-bg:linear-gradient(135deg,#3D0366,#87112b);
}
/* ════ DARK ════ */
[data-theme="dark"]{
  --bg:#09090d;--text:#e2e2ea;--text2:#666;--border:#1c1c28;--card:#131320;--card2:#18182a;
  --accent:#ff5a50;--nav-bg:rgba(9,9,13,.86);--nav-bd:#1a1a26;
  --search-bg:rgba(25,25,40,.7);--search-bd:rgba(50,50,70,.55);
  --tag-bg:rgba(25,25,40,.55);--tag-bd:rgba(50,50,70,.45);
  --hero-bg:#09090d;--hp:rgba(200,60,100,.18);--hb:rgba(60,120,220,.17);--hv:rgba(140,80,220,.14);--hr:rgba(180,70,100,.12);
  --icon-bg:#1a1a2a;--cta-bg:#131320;--ft-bd:#1a1a26;
  --btn-bg:#e2e2ea;--btn-bg2:#bbb;--btn-c:#09090d;
  --tog-bg:#222230;--tog-knob:#e2e2ea;--logo-f:brightness(0) invert(1);
}
html{scroll-behavior:smooth}
body,nav,.hero-wrap,.pcard,.scard,.ncard,.citem,.cta,footer,.search input,.tag{transition:background .45s ease,color .45s ease,border-color .45s ease}
body{font-family:'Noto Sans SC','Plus Jakarta Sans',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}

nav{position:fixed;top:0;left:0;right:0;z-index:100;background:var(--nav-bg);backdrop-filter:blur(20px);border-bottom:1px solid var(--nav-bd);padding:0 40px;height:56px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.logo{flex-shrink:0;display:flex;align-items:center}
.logo img{height:26px;width:auto;object-fit:contain;display:block}
.nlinks{position:absolute;left:50%;transform:translateX(-50%);display:flex;gap:28px;flex-shrink:0;align-items:center}
.nlinks a{text-decoration:none;color:#454545;font-size:15px;opacity:.8;transition:opacity .3s;white-space:nowrap;border-bottom:3px solid transparent}
.nlinks a:hover{opacity:1}.nlinks a.nav-active{opacity:1;color:#E1251B;font-weight:700;border-bottom-color:#E1251B}
.nright{display:flex;align-items:center;gap:16px;margin-left:auto;flex-shrink:0}
.nright a{text-decoration:none;font-size:13px;color:var(--text);opacity:.6;white-space:nowrap;transition:opacity .3s}
.nright a:hover{opacity:1}
.nright .sep{color:var(--text);opacity:.25;font-size:13px;user-select:none}
.nav-search{width:20px;height:20px;opacity:.5;cursor:pointer;transition:opacity .3s;flex-shrink:0;color:var(--text)}
.nav-search:hover{opacity:1}

/* TOGGLE */
.tog{position:relative;width:54px;height:28px;background:var(--tog-bg);border-radius:999px;cursor:pointer;border:none;padding:0;transition:background .4s;flex-shrink:0;display:flex;align-items:center}
.tog .k{position:absolute;top:2px;left:2px;width:24px;height:24px;border-radius:50%;background:var(--tog-knob);box-shadow:0 1px 4px rgba(0,0,0,.2);transition:transform .4s cubic-bezier(.4,0,.2,1)}
[data-theme="dark"] .tog .k{transform:translateX(26px)}
.tog svg{position:absolute;width:13px;height:13px;pointer-events:none;transition:opacity .3s}
.tog .sun{left:7px;color:#f59e0b;opacity:1}
.tog .moon{right:7px;color:#818cf8;opacity:.3}
[data-theme="dark"] .tog .sun{opacity:.3}
[data-theme="dark"] .tog .moon{opacity:1}
.btn{background:var(--btn-bg);color:var(--btn-c);border:none;padding:8px 20px;border-radius:999px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .3s}
.btn:hover{background:var(--btn-bg2);transform:translateY(-1px)}

/* HERO */
.hero-wrap{position:relative;overflow:hidden;background:var(--hero-bg)}
.hero-wrap::before{content:'';position:absolute;inset:-40% -20%;background:radial-gradient(ellipse 60% 55% at 25% 45%,var(--hp) 0%,transparent 70%),radial-gradient(ellipse 35% 30% at 80% 65%,var(--hr) 0%,transparent 60%);filter:blur(34px);animation:gf1 14s linear infinite;z-index:0}
.hero-wrap::after{content:'';position:absolute;inset:-40% -20%;background:radial-gradient(ellipse 50% 50% at 70% 35%,var(--hb) 0%,transparent 70%),radial-gradient(ellipse 40% 45% at 50% 70%,var(--hv) 0%,transparent 65%);filter:blur(34px);animation:gf2 18s linear infinite;z-index:0}
.hero-wrap .blob{position:absolute;border-radius:50%;filter:blur(52px);z-index:0;pointer-events:none}
.hero-wrap .blob1{width:50%;height:55%;top:5%;left:2%;background:var(--hp);animation:gb1 12s linear infinite}
.hero-wrap .blob2{width:45%;height:50%;top:10%;right:2%;background:var(--hb);animation:gb2 16s linear infinite}
.hero-wrap .blob3{width:42%;height:48%;bottom:5%;left:25%;background:var(--hv);animation:gb3 20s linear infinite}
.hero-wrap .blob4{width:38%;height:42%;bottom:10%;right:10%;background:var(--hr);animation:gb4 14s linear infinite}
@keyframes gf1{0%{transform:translate(0,0) scale(1) rotate(0deg)}25%{transform:translate(-80px,60px) scale(1.12) rotate(90deg)}50%{transform:translate(70px,-50px) scale(.9) rotate(180deg)}75%{transform:translate(-50px,-70px) scale(1.08) rotate(270deg)}100%{transform:translate(0,0) scale(1) rotate(360deg)}}
@keyframes gf2{0%{transform:translate(0,0) scale(1) rotate(0deg)}25%{transform:translate(75px,-60px) scale(1.1) rotate(-90deg)}50%{transform:translate(-60px,75px) scale(1.14) rotate(-180deg)}75%{transform:translate(60px,45px) scale(.9) rotate(-270deg)}100%{transform:translate(0,0) scale(1) rotate(-360deg)}}
@keyframes gb1{0%{transform:translate(0,0) scale(1) rotate(0deg)}25%{transform:translate(100px,-80px) scale(1.25) rotate(120deg)}50%{transform:translate(-70px,100px) scale(.8) rotate(240deg)}75%{transform:translate(80px,30px) scale(1.18) rotate(300deg)}100%{transform:translate(0,0) scale(1) rotate(360deg)}}
@keyframes gb2{0%{transform:translate(0,0) scale(1) rotate(0deg)}25%{transform:translate(-90px,70px) scale(1.2) rotate(-100deg)}50%{transform:translate(80px,-90px) scale(.85) rotate(-200deg)}75%{transform:translate(-50px,-60px) scale(1.12) rotate(-300deg)}100%{transform:translate(0,0) scale(1) rotate(-360deg)}}
@keyframes gb3{0%{transform:translate(0,0) scale(1) rotate(0deg)}25%{transform:translate(85px,60px) scale(1.22) rotate(80deg)}50%{transform:translate(-100px,-40px) scale(.78) rotate(180deg)}75%{transform:translate(40px,-80px) scale(1.15) rotate(260deg)}100%{transform:translate(0,0) scale(1) rotate(360deg)}}
@keyframes gb4{0%{transform:translate(0,0) scale(1) rotate(0deg)}25%{transform:translate(-70px,-85px) scale(1.15) rotate(-110deg)}50%{transform:translate(90px,70px) scale(.82) rotate(-220deg)}75%{transform:translate(-40px,55px) scale(1.25) rotate(-310deg)}100%{transform:translate(0,0) scale(1) rotate(-360deg)}}
.hero{position:relative;z-index:1;padding:230px 48px 170px;text-align:center;max-width:780px;margin:0 auto}
.hero h1{font-family:'Plus Jakarta Sans';font-size:48px;font-weight:800;letter-spacing:-2px;line-height:1.12;margin-bottom:36px;animation:scaleIn 1s cubic-bezier(.2,.8,.3,1) both}
.search{position:relative;max-width:540px;margin:0 auto 26px;animation:fadeUp .8s ease .12s both}
.search input{width:100%;padding:15px 54px 15px 22px;border:1.5px solid var(--search-bd);border-radius:999px;font-size:16px;font-family:inherit;background:var(--search-bg);backdrop-filter:blur(12px);color:var(--text);outline:none;transition:all .3s}
.search input:focus{border-color:var(--text);box-shadow:0 0 0 3px rgba(128,128,128,.08)}
.search input::placeholder{color:var(--text2)}
.search .send-btn{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;background:var(--accent);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s;flex-shrink:0}
.search .send-btn:hover{background:var(--btn-bg);transform:translateY(-50%) scale(1.06)}
.search .send-btn svg{width:18px;height:18px;stroke:#fff;fill:none}
.tags{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;animation:fadeUp .8s ease .24s both}
.tag{padding:8px 18px;border-radius:999px;border:1px solid var(--tag-bd);background:var(--tag-bg);backdrop-filter:blur(8px);font-size:12px;color:var(--text2);cursor:pointer;text-decoration:none;transition:all .3s}
.tag:hover{border-color:var(--text);color:var(--text)}

.wrap{max-width:1080px;margin:0 auto;padding:0 48px}
.sec{padding:58px 0}
.sec-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}
.sec-head h2{font-size:20px;font-weight:700;letter-spacing:-.5px}
.sec-head a{font-size:12px;color:var(--text2);text-decoration:none}

.feat{display:grid;grid-template-columns:1.6fr 1fr;grid-template-rows:1fr 1fr;gap:14px}
.feat-main{grid-row:1/3;border-radius:22px;overflow:hidden;position:relative;min-height:400px;background:linear-gradient(135deg,#ff6b35,#ff3e6c,#d63384);cursor:pointer;transition:all .3s}
.feat-main:hover{transform:translateY(-3px);box-shadow:0 20px 60px rgba(0,0,0,.14)}
.feat-main .ov{position:absolute;bottom:0;left:0;right:0;padding:32px;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.5))}
.feat-main .badge{display:inline-block;padding:4px 12px;border-radius:999px;background:rgba(255,255,255,.2);backdrop-filter:blur(8px);font-size:11px;margin-bottom:8px}
.feat-main h3{font-size:24px;font-weight:700}
.feat-main p{font-size:12px;opacity:.78;margin-top:4px}
.feat-s{border-radius:22px;padding:26px;display:flex;flex-direction:column;justify-content:flex-end;color:#fff;cursor:pointer;transition:all .3s}
.feat-s:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,0,0,.12)}
.feat-s:nth-child(2){background:linear-gradient(135deg,#667eea,#764ba2)}
.feat-s:nth-child(3){background:linear-gradient(135deg,#11998e,#38ef7d)}
.feat-s h4{font-size:16px;font-weight:700}
.feat-s p{font-size:11px;opacity:.75}

.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.pcard{background:var(--card);border-radius:14px;padding:28px 18px;text-align:center;cursor:pointer;border:1px solid transparent;transition:all .3s}
.pcard:hover{background:var(--card2);border-color:var(--border);transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.06)}
.pcard .ico{width:68px;height:68px;margin:0 auto 14px;background:var(--icon-bg);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:26px;transition:transform .3s}
.pcard:hover .ico{transform:scale(1.08)}
.pcard h4{font-size:13px;font-weight:600;margin-bottom:5px}
.pcard .desc{font-size:11px;color:var(--text2);margin-bottom:12px}
.pcard .price{font-size:17px;font-weight:800;color:var(--accent)}

.sgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.scard{border-radius:14px;overflow:hidden;background:var(--card);cursor:pointer;border:1px solid transparent;transition:all .3s}
.scard:hover{border-color:var(--border);transform:translateY(-4px)}
.scard .thumb{height:150px}
.scard .info{padding:20px}
.scard h4{font-size:14px;font-weight:600;margin-bottom:5px}
.scard p{font-size:12px;color:var(--text2)}

.ngrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.ncard{display:flex;gap:14px;padding:18px;border-radius:14px;cursor:pointer;border:1px solid transparent;transition:all .3s}
.ncard:hover{background:var(--card);border-color:var(--border)}
.ncard .num{font-size:32px;font-weight:900;color:var(--accent);opacity:.25;min-width:40px;line-height:1}
.ncard h4{font-size:13px;font-weight:600;line-height:1.5;margin-bottom:3px}
.ncard .date{font-size:11px;color:var(--text2)}

.crow{display:flex;border:1px solid var(--border);border-radius:22px;overflow:hidden}
.citem{flex:1;padding:34px 20px;text-align:center;border-right:1px solid var(--border);cursor:pointer;transition:background .3s}
.citem:last-child{border-right:none}
.citem:hover{background:var(--card)}
.citem .cn{font-size:18px;font-weight:700;opacity:.5;margin-bottom:6px;transition:opacity .3s}
.citem:hover .cn{opacity:1}
.citem p{font-size:11px;color:var(--text2)}

.cta{text-align:center;padding:68px 40px;margin:32px 0;background:var(--cta-bg);border-radius:22px}
.cta h2{font-size:28px;font-weight:700;letter-spacing:-1px;margin-bottom:12px}
.cta p{font-size:14px;color:var(--text2);margin-bottom:24px}
.cta .btn{padding:14px 32px;font-size:14px}
/* 首页/子站内容切换 */
html:not([data-site="default"]) #homeContent{display:none}
html[data-site="default"] #shopContent{display:none}

footer{border-top:1px solid var(--ft-bd);padding:40px 48px;max-width:1080px;margin:0 auto}
.fgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;margin-bottom:32px}
.fgrid h5{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px}
.fgrid a{display:block;font-size:12px;color:var(--text2);text-decoration:none;margin-bottom:8px;transition:color .3s}
.fgrid a:hover{color:var(--text)}
.fbot{font-size:11px;color:var(--text2);padding-top:18px;border-top:1px solid var(--ft-bd)}

@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes scaleIn{0%{opacity:0;transform:scale(.5);filter:blur(8px)}60%{opacity:1;filter:blur(0)}100%{opacity:1;transform:scale(1);filter:blur(0)}}
.fi{opacity:0;transform:translateY(28px);transition:opacity .65s ease,transform .65s ease}
.fi.v{opacity:1;transform:translateY(0)}

@media(max-width:768px){
  nav{padding:0 16px;gap:8px}.nlinks{display:none}.nright a,.nright .sep,.nav-search{display:none}.nright{gap:10px}#navAuthArea{display:flex!important}#navUserArea{display:flex!important}#navAuthArea a,#navUserArea a{display:inline!important}.hero{padding:240px 20px 120px}.hero h1{font-size:30px}
  .wrap{padding:0 20px}.feat{grid-template-columns:1fr}.feat-main{grid-row:auto;min-height:250px}
  .pgrid,.sgrid,.ngrid{grid-template-columns:1fr}.crow{flex-direction:column}
  .citem{border-right:none;border-bottom:1px solid var(--border)}.fgrid{grid-template-columns:repeat(2,1fr)}
  .hero-wrap .blob,.hero-wrap::before,.hero-wrap::after{animation:none!important}
  .wgrid{grid-template-columns:repeat(2,1fr)!important}
}


/* ════ PAGE SWITCHING ════ */
html,body{height:100%;overflow:hidden}
.is-chat #landingPage{display:none!important}
.is-chat #chatApp{opacity:1!important;pointer-events:all!important}
.is-chat-conv #welcomeScreen{display:none!important}
#landingPage{position:fixed;inset:0;z-index:10;background:var(--bg);overflow-y:auto;transition:opacity .4s ease,transform .4s ease}
#landingPage.exit{opacity:0;transform:scale(.97);pointer-events:none}

/* ════ CHAT APP ════ */
#chatApp{position:fixed;top:0;left:0;right:0;z-index:20;height:100vh;height:100dvh;display:flex;overflow:hidden;opacity:0;pointer-events:none;transition:opacity .35s ease}
#chatApp.active{opacity:1;pointer-events:all}
.sb-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9980;opacity:0;pointer-events:none;transition:opacity .3s;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:20px;box-sizing:border-box}
.sb-overlay.active{opacity:1;pointer-events:all}

/* Sidebar */
.sidebar{background:#fff;border-radius:16px;width:100%;max-width:560px;max-height:80vh;display:flex;flex-direction:column;transform:scale(.94) translateY(12px);transition:transform .3s cubic-bezier(.19,1,.22,1);box-shadow:0 20px 60px rgba(0,0,0,.25)}
.sb-overlay.active .sidebar{transform:scale(1) translateY(0)}
.sb-header{padding:14px 12px 10px;border-bottom:1px solid var(--border)}
.sb-logo{display:flex;align-items:center;gap:8px;padding:8px 6px;margin-bottom:8px;cursor:pointer;font-size:17px;font-weight:700;color:#E12521;letter-spacing:-.3px;font-family:'Noto Sans SC',sans-serif}
.new-btn{width:100%;display:flex;align-items:center;gap:8px;padding:10px 14px;border-radius:10px;border:1px solid var(--border);background:#fff;color:var(--text);font-size:13px;font-family:inherit;transition:all .2s;cursor:pointer}
.new-btn:hover{background:var(--card);border-color:var(--primary)}
.new-btn svg{width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;opacity:.7}
.sb-section{padding:14px 12px 6px;font-size:11px;color:var(--text2);font-weight:600;text-transform:uppercase;letter-spacing:.8px}
.sb-list{flex:1;overflow-y:auto;padding:4px 8px 12px}
.sb-list::-webkit-scrollbar{width:3px}
.sb-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
.conv-item{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:9px;cursor:pointer;transition:background .15s;font-size:13px;color:var(--text2)}
.conv-item:hover{background:#F4EFFA;color:var(--text)}
.conv-item.active{background:#EBE5F2;color:var(--text)}
.conv-item svg{width:14px;height:14px;stroke:currentColor;stroke-width:1.8;fill:none;flex-shrink:0;opacity:.6}
.conv-title{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.conv-empty{padding:20px 10px;font-size:12px;color:var(--text2);text-align:center;opacity:.6}
.sb-footer{padding:12px;border-top:1px solid var(--border);display:flex;align-items:center;gap:8px}
.sb-theme-btn,.back-home-btn{display:flex;align-items:center;gap:7px;padding:8px 10px;border-radius:9px;border:none;background:transparent;color:var(--text2);font-size:12px;font-family:inherit;cursor:pointer;transition:all .2s}
.sb-theme-btn{flex:1}
.sb-theme-btn:hover,.back-home-btn:hover{background:rgba(128,128,128,.06);color:var(--text)}
.sb-theme-btn svg,.back-home-btn svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;fill:none}

/* Chat main */
.chat-main{flex:1;display:flex;flex-direction:column;min-width:0;position:relative;background:#fff}
.chat-topbar{height:52px;border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 16px 0 24px;flex-shrink:0;gap:8px;background:#fff}
.chat-title{font-size:14px;font-weight:600;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.topbar-btn{display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:6px;border:1px solid var(--border);background:none;color:var(--text2);font-size:11px;cursor:pointer;transition:all .15s;font-family:inherit;white-space:nowrap}
.topbar-btn:hover{border-color:var(--accent);color:var(--accent)}
.topbar-btn.active{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,transparent);color:var(--accent)}
#shareBtn{display:none!important}
.menu-btn{display:none;align-items:center;justify-content:center;width:36px;height:36px;border-radius:9px;border:1px solid var(--border);background:transparent;color:var(--text);flex-shrink:0;transition:all .2s}
.menu-btn:hover{border-color:var(--accent);color:var(--accent)}
.menu-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;fill:none}

/* Messages */
.msgs-wrap{flex:1;overflow-y:auto;overflow-x:hidden;padding:28px 0;position:relative}
.msgs-wrap::-webkit-scrollbar{width:4px}
.msgs-wrap::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
#msgsInner{padding:0 32px;display:flex;flex-direction:column;gap:18px}

/* Welcome */
.welcome{position:relative}.welcome-close{position:absolute;top:8px;right:8px;width:24px;height:24px;border:none;background:rgba(0,0,0,.08);border-radius:50%;cursor:pointer;font-size:14px;color:#666;display:flex;align-items:center;justify-content:center}.welcome-close:hover{background:rgba(0,0,0,.15)}
.welcome{padding:38px 10px 32px 8px;text-align:left}
.welcome h2{font-size:clamp(26px,4vw,26px);font-weight:900;margin-bottom:10px;letter-spacing:-.03em;line-height:1.2}
.welcome h2 .grad{background:var(--primary-grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-size:200%;animation:sg 4s linear infinite}
@keyframes sg{0%{background-position:0%}100%{background-position:200%}}
.welcome p{font-size:14px;color:var(--text2);margin-bottom:28px;line-height:1.7}
.wlist{display:flex;flex-direction:column;gap:8px}
.wlist-item{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid var(--border);border-radius:10px;padding:14px 16px;cursor:pointer;transition:all .2s;font-size:14px;font-weight:500;color:var(--text)}
.wlist-item:hover{border-color:var(--primary);background:var(--card);color:var(--primary)}

/* Msg bubbles */
.msg{display:flex;gap:10px;animation:msgIn .25s ease}
@keyframes msgIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.msg.user{flex-direction:row-reverse}
.mavatar{display:none}
.mbubble{max-width:96%;padding:12px 16px;border-radius:18px;font-size:15px;line-height:30px;word-break:break-word;overflow-wrap:anywhere;min-width:0;color:var(--text)}
.msg.ai .mbubble{background:transparent;border:none;padding:0 4px;border-bottom-left-radius:0;font-size:15px;line-height:30px;color:var(--text)}
.msg.user .mbubble{background:linear-gradient(90deg,#fdf4f8,#f6e7f5 52%,#edf3ff);color:var(--text);border:none;border-bottom-right-radius:4px;font-size:15px;line-height:22px}
.msg.ai .mbubble pre{font-size:13px;background:#F4EFFA;border:1px solid var(--border);padding:10px;border-radius:8px;overflow-x:auto;margin:8px 0;white-space:pre-wrap}
[data-theme="dark"] .msg.ai .mbubble pre{background:rgba(255,255,255,.05)}
.msg.ai .mbubble p{margin:0 0 8px}.msg.ai .mbubble p:last-child{margin-bottom:0}
.msg.ai .mbubble h1,.msg.ai .mbubble h2,.msg.ai .mbubble h3,.msg.ai .mbubble h4,.msg.ai .mbubble h5{font-size:16px;font-weight:700;margin:12px 0 6px;color:var(--text)}
.msg.ai .mbubble ul,.msg.ai .mbubble ol{padding-left:20px;margin:4px 0 8px}
.msg.ai .mbubble li{margin-bottom:3px}
.msg.ai .mbubble code{font-family:monospace;font-size:12px;background:#EBE5F2;color:#3D0366;padding:1px 5px;border-radius:4px}
[data-theme="dark"] .msg.ai .mbubble code{background:rgba(255,255,255,.08)}
.msg.ai .mbubble .table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:8px 0;border-radius:8px;border:1px solid var(--border)}
.msg.ai .mbubble table{border-collapse:collapse;min-width:100%;font-size:13px}
.msg.ai .mbubble th{padding:8px 14px;text-align:left;font-size:14px;font-weight:700;background:#F4EFFA;border-bottom:1px solid var(--border);white-space:nowrap}
.msg.ai .mbubble td{padding:7px 14px;text-align:left;font-size:14px;line-height:30px;min-width:80px;border-bottom:1px solid var(--border)}
.msg.ai .mbubble tr:last-child td{border-bottom:none}
.msg.ai .mbubble a{color:var(--primary);text-decoration:underline;border-bottom:1px solid transparent;transition:border-color .15s}
.msg.ai .mbubble a:hover{border-bottom-color:var(--primary)}
.msg.ai .mbubble a.leai-ppanel-buy{color:#fff;text-decoration:none;border-bottom:none}
.streaming::after{content:'▋';display:inline-block;animation:cursorBlink .6s step-end infinite;color:var(--accent);font-size:12px;vertical-align:middle;margin-left:1px}
@keyframes cursorBlink{0%,100%{opacity:1}50%{opacity:0}}

/* Typing */
.typing-dots{display:flex;align-items:center;gap:5px;padding:12px 16px;background:var(--card);border:1px solid var(--border);border-radius:16px;border-bottom-left-radius:4px}
.tdot{width:6px;height:6px;border-radius:50%;background:var(--text2);opacity:.4;animation:td .7s ease-in-out infinite}
.tdot:nth-child(2){animation-delay:.12s}
.tdot:nth-child(3){animation-delay:.24s}
@keyframes td{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-4px);opacity:1}}

/* Suggestions */
.suggestions{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;margin-left:42px}
.suggest-chip{display:inline-flex;align-items:center;padding:6px 14px;border-radius:999px;border:1px solid var(--border);background:var(--tag-bg);color:var(--text2);font-size:12px;cursor:pointer;transition:all .2s;font-family:inherit;text-align:left;line-height:1.4}
.suggest-chip:hover{border-color:var(--primary);color:var(--primary)}

/* Input bar */
.input-bar{padding:8px 20px 10px;border-top:1px solid var(--border);flex-shrink:0;background:#fff;padding-bottom:max(10px,env(safe-area-inset-bottom));position:relative}
.input-bar-toprow{display:flex;align-items:center;gap:6px;padding-bottom:8px;flex-wrap:wrap}
.input-inner{display:flex;gap:8px;align-items:flex-end}
.input-tools{display:flex;align-items:center;gap:6px;padding:6px 0 0;flex-wrap:wrap}
.input-tools-right{display:flex;align-items:center;gap:6px;margin-left:auto;flex-shrink:0}
.mode-pill{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:999px;border:1px solid var(--border);background:none;color:var(--text2);font-size:12px;cursor:pointer;transition:all .2s;font-family:inherit;user-select:none;white-space:nowrap}
.mode-pill svg{width:13px;height:13px;stroke:currentColor;stroke-width:2;fill:none;flex-shrink:0}
.mode-pill:hover{border-color:var(--primary);color:var(--primary)}
.mode-pill.active-web{border-color:var(--primary);color:var(--primary);background:rgba(61,3,102,.08)}
.mode-pill.active-think{border-color:var(--primary);color:var(--primary);background:rgba(61,3,102,.08)}
[data-theme="dark"] .mode-pill.active-web{border-color:#60a5fa;color:#60a5fa;background:rgba(96,165,250,.1)}
[data-theme="dark"] .mode-pill.active-think{border-color:#a78bfa;color:#a78bfa;background:rgba(167,139,250,.1)}

.msg-body{display:flex;flex-direction:column;flex:1;min-width:0}
.process-card{background:rgba(128,128,128,.06);border:1px solid var(--border);border-radius:10px;padding:8px 12px;margin-bottom:8px;font-size:12px}
.process-header{display:flex;align-items:center;gap:7px;cursor:pointer;user-select:none;color:var(--text2)}
.process-header svg{width:13px;height:13px;flex-shrink:0;stroke:currentColor;stroke-width:2;fill:none}
.process-title{flex:1;font-size:12px}
.process-steps{margin-top:6px;display:flex;flex-direction:column;gap:3px}
.process-step{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--text2);padding:2px 0}
.process-step svg{width:13px;height:13px;flex-shrink:0;stroke:currentColor;stroke-width:2;fill:none}
.process-step.running svg{animation:spin .8s linear infinite;color:var(--accent)}
.process-step.done svg{color:#22c55e}
.process-step.fail svg{color:#ef4444}
@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
.process-card.collapsed .process-steps{display:none}
.process-card.collapsed{background:none;border-color:transparent;padding:2px 12px}

/* Think block */
.think-block{border:1px solid color-mix(in srgb,#7c3aed 30%,var(--border));border-radius:10px;margin-bottom:8px;overflow:hidden;margin-left:42px}
[data-theme="dark"] .think-block{border-color:color-mix(in srgb,#a78bfa 30%,var(--border))}
.think-header{display:flex;align-items:center;gap:6px;padding:8px 12px;cursor:pointer;user-select:none;background:color-mix(in srgb,#7c3aed 5%,var(--bg));font-size:12px;color:#7c3aed}
[data-theme="dark"] .think-header{color:#a78bfa;background:color-mix(in srgb,#7c3aed 8%,var(--bg))}
.think-header svg{width:13px;height:13px;stroke:currentColor;stroke-width:2;fill:none;flex-shrink:0}
.think-chevron{margin-left:auto;transition:transform .2s}
.think-block.open .think-chevron{transform:rotate(180deg)}
.think-body{padding:8px 12px 10px;font-size:12px;color:var(--text2);line-height:1.7;max-height:240px;overflow-y:auto;display:none;border-top:1px solid color-mix(in srgb,#7c3aed 20%,var(--border));white-space:pre-wrap}
.think-block.open .think-body{display:block}
.think-streaming::after{content:'▋';animation:cursorBlink .6s step-end infinite;color:#7c3aed}

.ta-wrap{flex:1;border:1.5px solid var(--search-bd);border-radius:12px;background:#fff;transition:border-color .25s,box-shadow .25s;position:relative;padding:10px 14px 6px}
.ta-wrap:focus-within{border-color:var(--primary);box-shadow:0 0 0 3px rgba(61,3,102,.08)}
.ta{width:100%;resize:none;border:none;outline:none;padding:0;font-size:15px;font-family:inherit;background:transparent;color:var(--text);line-height:1.6;max-height:120px;min-height:26px}
.ta::placeholder{color:var(--text2);font-size:15px}
.send-btn{width:34px;height:34px;border-radius:50%;border:none;background:var(--send-btn-bg);color:#fff;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;cursor:pointer}
.send-btn:hover:not(:disabled){opacity:.85;transform:scale(1.04)}
.send-btn:disabled{background:#DDD5E8;cursor:not-allowed}
.input-hint{text-align:center;font-size:11px;color:var(--text2);opacity:.5;margin-top:7px}
.img-upload-btn{width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:none;color:var(--text2);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;flex-shrink:0}
.img-upload-btn:hover{border-color:var(--primary);color:var(--primary)}
.img-upload-btn svg{width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none}
.audio-upload-btn{width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:none;color:var(--text2);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;flex-shrink:0;font-size:14px;line-height:1}
.audio-upload-btn:hover{border-color:var(--primary);color:var(--primary)}
.img-preview-wrap{display:flex;align-items:center;gap:6px;padding:4px 8px;background:var(--search-bg);border:1px solid var(--border);border-radius:10px;margin-bottom:6px}
.img-preview-thumb{width:32px;height:32px;object-fit:cover;border-radius:6px;flex-shrink:0}
.img-preview-name{font-size:11px;color:var(--text2);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.img-preview-del{width:18px;height:18px;border:none;background:none;cursor:pointer;color:var(--text2);padding:0;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.img-preview-del:hover{color:#ef4444}
.img-preview-del svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;fill:none}

/* Actions */
.msg-actions{display:flex;align-items:center;gap:2px;margin-top:4px;opacity:0;transition:opacity .15s;height:22px}
.msg.ai:hover .msg-actions,.msg.ai:focus-within .msg-actions{opacity:1}
.act-btn{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:6px;border:none;background:none;color:var(--text2);font-size:11px;cursor:pointer;transition:all .15s;font-family:inherit}
.act-btn:hover{background:rgba(128,128,128,.06);color:var(--text)}
.act-btn svg{width:11px;height:11px;stroke:currentColor;stroke-width:2;fill:none;flex-shrink:0}
.act-btn.copied{color:var(--accent)}
.act-btn.liked{color:#22c55e}
.act-btn.disliked{color:#ef4444}

/* Split compare */
.compare-wrap{display:flex;gap:12px;width:100%}
.compare-col{flex:1;min-width:0;border:1px solid var(--border);border-radius:12px;padding:10px 12px;background:var(--card)}
.compare-col .col-label{font-size:11px;font-weight:700;color:var(--text2);margin-bottom:6px;display:flex;align-items:center;gap:4px}
.compare-col .col-label .dot{width:6px;height:6px;border-radius:50%;display:inline-block}
.compare-col.self .col-label .dot{background:var(--primary)}
.compare-col.official .col-label .dot{background:#e11d48}
.compare-col .mbubble{background:transparent;border:none;padding:0;font-size:14px;line-height:28px;color:var(--text)}
.compare-col .mbubble p{margin:0 0 6px}.compare-col .mbubble p:last-child{margin-bottom:0}
.compare-col .mbubble pre{font-size:13px;background:#F4EFFA;border:1px solid var(--border);padding:8px;border-radius:8px;overflow-x:auto;white-space:pre-wrap;margin:6px 0}
[data-theme="dark"] .compare-col .mbubble pre{background:rgba(255,255,255,.05)}
.compare-col .mbubble code{font-family:monospace;font-size:12px;background:#EBE5F2;color:#3D0366;padding:1px 5px;border-radius:4px}
.compare-col .mbubble a{color:var(--primary);text-decoration:underline}
.compare-col .mbubble a.leai-ppanel-buy{color:#fff;text-decoration:none}
.compare-col .mbubble ul,.compare-col .mbubble ol{padding-left:18px;margin:4px 0 6px}
.compare-col .mbubble .table-wrap{overflow-x:auto;margin:6px 0;border-radius:8px;border:1px solid var(--border)}
.compare-col .mbubble table{border-collapse:collapse;min-width:100%;font-size:13px}
.compare-col .mbubble th{padding:6px 10px;font-weight:700;background:#F4EFFA;border-bottom:1px solid var(--border)}
.compare-col .mbubble td{padding:5px 10px;border-bottom:1px solid var(--border)}
@media(max-width:600px){.compare-wrap{flex-direction:column}.compare-col{flex:none}}

/* LeAI product cards — 完美复刻 leai.lenovo.com.cn */
.leai-products{margin-top:18px;background:linear-gradient(132deg,#ecf1ff,#fcf2f8 72%);border-radius:8px;overflow:hidden}
[data-theme="dark"] .leai-products{background:linear-gradient(132deg,#1a1a2e,#251520 72%);border:1px solid var(--border)}
.leai-ptabs{display:flex;padding:14px 16px 0;gap:22px;overflow-x:auto;scrollbar-width:none}
.leai-ptabs::-webkit-scrollbar{display:none}
.leai-ptab{padding:0 0 12px;font-size:15px;font-weight:400;color:#000;cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;transition:color .2s,font-weight .2s;flex-shrink:0;line-height:1}
.leai-ptab:hover{color:#4d144a}
.leai-ptab.active{color:#4d144a;font-weight:900;border-bottom-color:transparent}
[data-theme="dark"] .leai-ptab{color:var(--text2)}[data-theme="dark"] .leai-ptab.active{color:#e8a0c0;border-bottom-color:transparent}
.leai-pscore{width:100%;padding:6px 12px;font-size:12px;color:#6a352a;font-weight:700;display:flex;align-items:center;gap:4px}
.leai-ppanel{display:none;padding:12px 16px 14px}
.leai-ppanel.active{display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap}
.leai-ppanel-img{width:142px;height:142px;object-fit:contain;flex-shrink:0;border-radius:8px}
[data-theme="dark"] .leai-ppanel-img{filter:brightness(.92)}
.leai-ppanel-info{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between;min-height:142px}
.leai-ppanel-name{font-size:14px;font-weight:500;color:#000;line-height:1.4;margin-bottom:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
[data-theme="dark"] .leai-ppanel-name{color:var(--text)}
.leai-ppanel-brief{font-size:12px;color:#606060;line-height:1.7;margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.leai-ppanel-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px}
.leai-ppanel-tag{font-size:12px;color:#ff2f2f;padding:0}
.leai-ppanel-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto}
.leai-ppanel-pricelabel{font-size:12px;color:#000}
.leai-ppanel-price{font-size:18px;font-weight:500;color:#000;font-family:-apple-system,BlinkMacSystemFont,sans-serif}
.leai-ppanel-price::before{content:'¥';font-size:14px;font-weight:500;margin-right:1px}
.leai-ppanel-buy{display:inline-flex;align-items:center;justify-content:center;width:88px;height:32px;border-radius:20px;background:linear-gradient(90deg,#6b2068 0%,#b83340 100%);color:#fff;font-size:13px;font-weight:500;text-decoration:none;transition:all .2s;border:none;letter-spacing:.5px}
.leai-ppanel-buy:hover{filter:brightness(1.1);transform:translateY(-1px);box-shadow:0 4px 12px rgba(107,32,104,.3)}
.leai-pbtns{display:flex;gap:12px;padding:10px 16px 14px}
.leai-pbtn{display:flex;align-items:center;justify-content:center;gap:4px;width:129px;height:35px;border-radius:100px;background:#f3f0f7;color:#4d144a;font-size:12px;font-weight:500;cursor:pointer;transition:all .2s;border:none}
.leai-pbtn:hover{background:#e8e0f0}
[data-theme="dark"] .leai-pbtn{background:var(--card);color:var(--text2)}
/* ── 商品弹窗 ── */
.leai-modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:9999;display:flex;align-items:center;justify-content:center;animation:leaiFadeIn .2s}
@keyframes leaiFadeIn{from{opacity:0}to{opacity:1}}
.leai-modal{background:#fff;border-radius:12px;width:580px;max-width:92vw;max-height:80vh;display:flex;flex-direction:column;position:relative;box-shadow:0 8px 32px rgba(0,0,0,.18)}
[data-theme="dark"] .leai-modal{background:var(--card2);box-shadow:0 8px 32px rgba(0,0,0,.5)}
.leai-modal-close{position:absolute;top:14px;right:16px;width:28px;height:28px;cursor:pointer;font-size:20px;color:#999;display:flex;align-items:center;justify-content:center;border:none;background:none;z-index:1}
.leai-modal-close:hover{color:#333}
.leai-modal-title{padding:20px 20px 0;font-size:17px;font-weight:700;color:#000}
[data-theme="dark"] .leai-modal-title{color:var(--text)}
.leai-modal-tabs{display:flex;padding:14px 20px 0;gap:22px;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid #f0f0f0}
.leai-modal-tabs::-webkit-scrollbar{display:none}
.leai-modal-tab{padding:0 0 10px;font-size:14px;font-weight:400;color:#000;cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;flex-shrink:0}
.leai-modal-tab.active{color:#4d144a;font-weight:700;border-bottom-color:#4d144a}
[data-theme="dark"] .leai-modal-tabs{border-bottom-color:var(--border)}
[data-theme="dark"] .leai-modal-tab{color:var(--text2)}[data-theme="dark"] .leai-modal-tab.active{color:#e8a0c0;border-bottom-color:#e8a0c0}
.leai-modal-sorts{display:flex;gap:24px;padding:10px 20px;font-size:13px;color:#666}
.leai-modal-sort{cursor:pointer;color:#999}
.leai-modal-sort.active{color:#4d144a;font-weight:600;text-decoration:underline}
.leai-modal-body{flex:1;overflow-y:auto;padding:0 20px 16px}
.leai-modal-card{display:flex;gap:12px;padding:12px;border:1px solid #eee;border-radius:8px;margin-top:10px;cursor:pointer;transition:border-color .2s}
.leai-modal-card:hover{border-color:#4d144a}
[data-theme="dark"] .leai-modal-card{border-color:var(--border)}
.leai-modal-card img{width:80px;height:80px;object-fit:contain;flex-shrink:0;border-radius:6px}
.leai-modal-card-info{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:6px}
.leai-modal-card-name{font-size:13px;font-weight:500;color:#000;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
[data-theme="dark"] .leai-modal-card-name{color:var(--text)}
.leai-modal-card-tags{display:flex;gap:6px}
.leai-modal-card-tag{font-size:11px;padding:1px 6px;border-radius:3px}
.leai-modal-card-tag.sat{background:#e8f5e9;color:#2e7d32}
.leai-modal-card-tag.promo{background:#fff0f0;color:#ff2f2f}
[data-theme="dark"] .leai-modal-card-tag.sat{background:#1a2e1a;color:#66bb6a}
[data-theme="dark"] .leai-modal-card-tag.promo{background:#2e1a1a;color:#f87171}
.leai-modal-card-price{font-size:15px;font-weight:600;color:#000}
[data-theme="dark"] .leai-modal-card-price{color:var(--text)}
.leai-modal-foot{padding:12px 20px;border-top:1px solid #f0f0f0;display:flex;justify-content:flex-end}
[data-theme="dark"] .leai-modal-foot{border-top-color:var(--border)}
.leai-modal-compare{padding:10px 36px;border-radius:24px;background:linear-gradient(90deg,#3d0c3a,#8b1a28);color:#fff;font-size:14px;font-weight:500;border:none;cursor:pointer;transition:filter .2s}
.leai-modal-compare:hover{filter:brightness(1.15)}
@media(max-width:600px){.leai-ppanel.active{flex-direction:column}.leai-ppanel-img{width:100%;height:160px}.leai-ppanel-info{min-height:auto}.leai-modal{max-width:96vw;max-height:85vh}}

/* ── AI 弹层（通用 + 对比表） ── */
.ai-modal-mask{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9999;display:flex;align-items:center;justify-content:center;animation:leaiFadeIn .2s;padding:20px}
.ai-modal{background:#fff;border-radius:12px;max-width:92vw;max-height:85vh;display:flex;flex-direction:column;position:relative;box-shadow:0 8px 32px rgba(0,0,0,.18);overflow:hidden}
[data-theme="dark"] .ai-modal{background:var(--card2);box-shadow:0 8px 32px rgba(0,0,0,.5)}
.ai-modal-close{position:absolute;top:12px;right:14px;width:28px;height:28px;cursor:pointer;font-size:20px;color:#999;display:flex;align-items:center;justify-content:center;border:none;background:none;z-index:1}
.ai-modal-close:hover{color:#333}
.ai-modal-title{padding:18px 20px 12px;font-size:17px;font-weight:700;color:var(--text,#1a1a1a);border-bottom:1px solid var(--border,#eee);flex-shrink:0}
.ai-modal-body{flex:1;overflow-y:auto;padding:16px 20px;font-size:14px;line-height:1.7;color:var(--text,#333)}
.cmp-modal{width:auto;min-width:560px}
.cmp-table-wrap{flex:1;overflow:auto;padding:0 4px 16px}
.cmp-table{border-collapse:collapse;width:100%;font-size:13px}
.cmp-table th,.cmp-table td{padding:10px 14px;text-align:left;border-bottom:1px solid var(--border,#f0f0f0);vertical-align:top}
.cmp-label-col{font-weight:600;color:var(--text2,#666);white-space:nowrap;width:80px;background:var(--card,#fafafa);position:sticky;left:0;z-index:1}
[data-theme="dark"] .cmp-label-col{background:var(--card)}
.cmp-prod-col{min-width:160px}
.cmp-prod-name{font-size:13px;font-weight:700;color:var(--text,#1a1a1a);line-height:1.4}
.cmp-img-wrap{width:120px;height:90px;display:flex;align-items:center;justify-content:center;background:#f8f8f8;border-radius:8px;overflow:hidden}
.cmp-img-wrap img{max-width:100%;max-height:100%;object-fit:contain}
.cmp-no-img{font-size:12px;color:#ccc}
.cmp-price{font-size:16px;font-weight:700;color:#e03c31}
.cmp-orig{font-size:12px;color:#999;text-decoration:line-through;margin-left:6px}
.cmp-desc{font-size:12px;color:var(--text2,#666);line-height:1.5;max-width:200px}
.cmp-buy{display:inline-block;padding:6px 14px;background:var(--primary,#3D0366);color:#fff;border-radius:6px;font-size:12px;text-decoration:none;margin-right:6px}
.cmp-buy:hover{opacity:.85}
.cmp-ask{display:inline-block;padding:6px 14px;background:transparent;border:1px solid var(--border,#ddd);color:var(--text2,#666);border-radius:6px;font-size:12px;cursor:pointer;font-family:inherit}
.cmp-ask:hover{border-color:var(--accent,#e12521);color:var(--accent,#e12521)}
.cmp-img-row td{padding-top:14px}
.cmp-buy-row td{padding:14px}
@media(max-width:600px){.cmp-modal{min-width:auto;width:96vw}.cmp-table{font-size:12px}.cmp-prod-col{min-width:130px}.cmp-img-wrap{width:80px;height:60px}}

/* Store cards */
.store-wrap{display:flex;flex-direction:column}
.store-intro{font-size:13px;color:var(--text2);margin-bottom:10px;line-height:1.6}
.store-card{border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--card);transition:border-color .2s}
.store-card+.store-card{margin-top:8px}
.store-card:hover{border-color:var(--accent)}
.store-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.store-name{font-size:14px;font-weight:600;color:var(--text);line-height:1.4}
.store-dist{font-size:12px;font-weight:700;color:var(--accent);white-space:nowrap;flex-shrink:0}
.store-addr{font-size:12px;color:var(--text2);margin-top:4px;line-height:1.5}
.store-footer{display:flex;align-items:center;flex-wrap:wrap;gap:0;margin-top:6px}
.store-tel{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;color:var(--text2)}
.store-tel svg,.store-nav svg{width:11px;height:11px;stroke:currentColor;stroke-width:2;fill:none;flex-shrink:0}
.store-sep{color:var(--border);margin:0 8px;font-size:11px}
.store-nav{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;color:var(--accent);cursor:pointer}
.store-nav:hover{text-decoration:underline}
.store-expand-btn{display:flex;align-items:center;justify-content:center;gap:5px;margin-top:10px;padding:7px 0;border:1px dashed var(--border);border-radius:10px;background:none;color:var(--text2);font-size:12px;font-family:inherit;cursor:pointer;width:100%;transition:all .2s}
.store-expand-btn:hover{border-color:var(--accent);color:var(--accent)}
.store-expand-btn svg{width:13px;height:13px;stroke:currentColor;stroke-width:2;fill:none;transition:transform .2s}
.store-expand-btn.expanded svg{transform:rotate(180deg)}
.store-hidden{display:none}

/* Scroll bottom btn */
.scroll-down-btn{position:sticky;bottom:12px;float:right;margin-right:16px;width:34px;height:34px;border-radius:50%;border:1px solid var(--border);background:var(--card);color:var(--text2);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .25s;box-shadow:0 2px 10px rgba(0,0,0,.08);opacity:0;pointer-events:none;z-index:5}
.scroll-down-btn.show{opacity:1;pointer-events:all}
.scroll-down-btn:hover{border-color:var(--accent);color:var(--accent)}
.scroll-down-btn svg{width:14px;height:14px;stroke:currentColor;stroke-width:2.5;fill:none}

/* ── Preview Panel ── */
.preview-panel{width:0;flex-shrink:0;display:flex;flex-direction:column;border-left:1px solid var(--border);background:var(--bg);transition:width .3s ease;overflow:hidden;position:relative}
.preview-panel.open{width:50%}
.preview-topbar{display:flex;align-items:center;gap:8px;padding:8px 14px;border-bottom:1px solid var(--border);background:#fff;flex-shrink:0;min-height:44px}
[data-theme="dark"] .preview-topbar{background:var(--card)}
.preview-url{flex:1;font-size:12px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:monospace}
.preview-btns{display:flex;gap:6px;flex-shrink:0}
.preview-btn{display:inline-flex;align-items:center;gap:3px;padding:4px 10px;border-radius:6px;border:1px solid var(--border);background:none;color:var(--text2);font-size:11px;cursor:pointer;transition:all .15s;font-family:inherit}
.preview-btn:hover{border-color:var(--accent);color:var(--accent)}
.preview-iframe{flex:1;border:none;width:100%;background:#fff}
.preview-fallback{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:40px;text-align:center}
.preview-fallback-icon{font-size:48px;opacity:.4}
.preview-fallback-text{font-size:14px;color:var(--text2);line-height:1.7}
.preview-fallback-link{color:var(--accent);font-size:13px}

/* Mobile chat */
@media(max-width:768px){

  .chat-main{width:100%}
  .menu-btn{display:flex}
  .welcome{padding:24px 12px}
  
  .welcome h2{font-size:22px}
  #msgsInner{padding:0 12px}
  .input-bar{padding:8px 10px 10px;padding-bottom:max(10px,env(safe-area-inset-bottom))}
  .ai-product-overlay{padding:16px 14px 18px}
  .ai-product-overlay .ov-name{font-size:14px}
  .ai-product-overlay .ov-chips button{padding:8px 16px;font-size:13px}
  .product-chips-bar button{padding:7px 14px;font-size:12px}
  .input-inner{gap:6px}
  .input-tools{padding:4px 0 0}
  .chat-topbar{padding:0 14px}
  .ta{font-size:16px}
  .scroll-down-btn{bottom:10px;margin-right:10px}
  .preview-panel.open{position:fixed;inset:0;width:100%;z-index:200}
}

.qp:hover{color:var(--text);border-color:var(--text)!important;transform:translateY(-1px)}
.qpills{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}

/* ── 红包对话卡片 ── */
.mode-pill.hb-pill{border-color:#e8a020;color:#c47d00;background:rgba(245,166,35,.08)}
.mode-pill.hb-pill:hover{border-color:#e03c31;color:#e03c31;background:rgba(224,60,49,.08)}
[data-theme="dark"] .mode-pill.hb-pill{border-color:#f5a623;color:#f5a623;background:rgba(245,166,35,.12)}
.hb-mbubble{padding:0!important;background:none!important;border:none!important;max-width:90%!important}
.hb-card{border-radius:14px;overflow:hidden;box-shadow:0 4px 18px rgba(0,0,0,.10);font-size:14px;width:300px}
.hb-card-head{background:linear-gradient(135deg,#e03c31,#ff6b35);padding:14px 16px;display:flex;align-items:center;gap:10px}
.hb-ico{width:38px;height:38px;background:linear-gradient(135deg,#f5a623,#ffd700);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;box-shadow:0 2px 8px rgba(245,166,35,.4)}
.hb-info{flex:1;min-width:0}
.hb-title{font-size:14px;font-weight:700;color:#fff;line-height:1.3}
.hb-sub{font-size:11px;color:rgba(255,255,255,.75);margin-top:2px}
.hb-card-body{background:var(--card2,#fff);padding:14px 16px}
/* 金额展示 */
.hb-amount-big{text-align:center;padding:6px 0 10px}
.hb-am{font-size:42px;font-weight:800;color:#e03c31;line-height:1}
.hb-unit{font-size:16px;color:#e03c31;font-weight:700;vertical-align:top;margin-top:8px;display:inline-block}
.hb-tip{font-size:12px;color:var(--text2,#777);margin-top:4px}
.hb-conds{background:rgba(224,60,49,.06);border-radius:8px;padding:8px 12px;margin-bottom:12px;font-size:12px;color:var(--text2,#666);line-height:1.7}
.hb-conds b{color:#e03c31}
/* 按钮 */
.hb-btn{width:100%;padding:11px;background:linear-gradient(135deg,#e03c31,#ff6b35);border:none;border-radius:10px;font-size:13px;font-weight:700;color:#fff;cursor:pointer;transition:all .2s;font-family:inherit;box-shadow:0 3px 12px rgba(224,60,49,.25)}
.hb-btn:active{transform:scale(.98)}
.hb-btn:disabled{opacity:.55;cursor:default;transform:none}
.hb-btn.gold{background:linear-gradient(135deg,#f5a623,#ffc843);box-shadow:0 3px 12px rgba(245,166,35,.3);color:#7a4200}
.hb-btn.gray{background:var(--card,#f5f5f5);color:var(--text2,#666);box-shadow:none;border:1px solid var(--border,#e8e8e8)}
/* 拆红包 */
.hb-open-anim{text-align:center;padding:6px 0 12px}
.hb-open-circle{width:86px;height:86px;background:linear-gradient(135deg,#f5a623,#ffd700);border-radius:50%;margin:0 auto 10px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 0 0 8px rgba(245,166,35,.14),0 0 0 16px rgba(245,166,35,.06);animation:hbPop .4s cubic-bezier(.34,1.56,.64,1) both}
@keyframes hbPop{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
.oc-am{font-size:26px;font-weight:800;color:#fff;line-height:1;text-shadow:0 1px 4px rgba(0,0,0,.15)}
.oc-unit{font-size:11px;color:rgba(255,255,255,.9);font-weight:600}
/* 商品列表 */
.hb-prod-list-3{display:flex;flex-direction:column;gap:7px;margin-bottom:10px}
.hb-prod{display:flex;align-items:center;gap:9px;padding:9px 10px;border:1.5px solid var(--border,#e8e8e8);border-radius:10px;cursor:pointer;transition:all .2s;background:var(--card2,#fff)}
.hb-prod:hover,.hb-prod.sel{border-color:#e03c31;background:rgba(224,60,49,.04)}
.hb-prod-img{width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.hb-prod-info{flex:1;min-width:0}
.hb-prod-name{font-size:12px;font-weight:600;color:var(--text,#1a1a1a);line-height:1.3;margin-bottom:2px}
.hb-prod-price{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.pp{font-size:13px;font-weight:800;color:#e03c31}
.po{font-size:11px;color:var(--text2,#999);text-decoration:line-through}
.ps{font-size:10px;background:linear-gradient(135deg,#f5a623,#ffc843);color:#7a4200;padding:1px 5px;border-radius:4px;font-weight:600}
.hb-prod-check{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--border,#ddd);flex-shrink:0;transition:all .2s;display:flex;align-items:center;justify-content:center}
.hb-prod.sel .hb-prod-check{background:#e03c31;border-color:#e03c31}
.hb-prod.sel .hb-prod-check::after{content:'✓';color:#fff;font-size:10px;font-weight:700}
.hb-deduct{font-size:12px;color:var(--text2,#777);background:rgba(224,60,49,.06);border-radius:8px;padding:7px 12px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.dd{font-weight:700;color:#e03c31}
/* 订单成功 */
.hb-order-item{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.hb-order-info{background:rgba(224,60,49,.05);border-radius:8px;padding:10px 12px;font-size:12px;line-height:1.9}
.oi-row{display:flex;justify-content:space-between}
.ok{color:var(--text2,#777)}
.ov{color:var(--text,#1a1a1a);font-weight:500}
.ov.red{color:#e03c31;font-weight:700}
.hb-order-no{font-size:11px;color:var(--text3,#aaa);text-align:center;margin:8px 0 0}
.hb-share-row{display:flex;gap:8px}

/* ── 购买优惠领取卡片（自动顺序领取） ── */
.bf-card{border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.12);font-size:14px;background:#fff}
.bf-card-head{padding:14px 16px;background:#fff;border-bottom:1px solid var(--border,#eee)}
.bf-progress-wrap{height:4px;background:#eee;border-radius:2px;margin-top:10px;overflow:hidden}
.bf-progress-bar{height:100%;width:0;background:linear-gradient(90deg,#ff2f2f,#ff7043);border-radius:2px;transition:width .5s cubic-bezier(.4,0,.2,1)}
.bf-card-head-title{font-size:14px;font-weight:700;color:var(--text,#1a1a1a)}
.bf-card-head-sub{font-size:11px;color:var(--text2,#777);margin-top:3px}
.bf-list{padding:12px 14px 4px}
@keyframes bf-fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.bf-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:1.5px solid var(--border,#eee);margin-bottom:8px;transition:border-color .3s,background .3s;background:#fafafa;animation:bf-fadein .3s ease}
.bf-item.active{border-color:var(--border,#eee);background:#fafafa}
.bf-item.claimed{border-color:#22c55e;background:rgba(34,197,94,.05)}
.bf-item-info{flex:1;min-width:0}
.bf-item-name{font-size:12px;font-weight:600;color:var(--text,#1a1a1a);line-height:1.3}
.bf-item-amount{font-size:11px;color:#606060;font-weight:700;margin-top:2px}
.bf-item-status{flex-shrink:0;font-size:11px;display:flex;align-items:center;gap:4px}
.bf-item-status.pending{color:var(--text2,#999)}
.bf-item-status.loading{color:var(--text2,#999)}
.bf-item-status.done{color:#22c55e;font-weight:600}
@keyframes bf-spin{to{transform:rotate(360deg)}}
.bf-spinner{display:inline-block;width:12px;height:12px;border:2px solid rgba(150,150,150,.2);border-top-color:#999;border-radius:50%;animation:bf-spin .7s linear infinite}
.bf-price-wrap{margin:4px 14px 12px;padding:12px 14px;border-radius:10px;background:rgba(224,60,49,.05);border:1px dashed rgba(224,60,49,.2);animation:bf-fadein .4s ease}
.bf-price-label{font-size:11px;color:var(--text2,#777);margin-bottom:4px}
.bf-price-row2{display:flex;align-items:baseline;gap:8px}
.bf-price-orig{font-size:13px;color:#bbb;text-decoration:line-through}
.bf-price-final{font-size:24px;font-weight:800;color:#e03c31;transition:all .4s}
.bf-price-saving{font-size:11px;color:#22c55e;font-weight:600;background:rgba(34,197,94,.1);padding:2px 7px;border-radius:99px}
.bf-order-btn{display:block;width:calc(100% - 28px);margin:0 14px 14px;padding:11px;background:linear-gradient(135deg,#e03c31,#ff6b35);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;text-align:center;opacity:0;transform:translateY(6px);transition:opacity .4s,transform .4s}
.bf-order-btn.show{opacity:1;transform:translateY(0)}

/* ── 订单确认弹层 ── */
.order-overlay{position:fixed;inset:0;z-index:9990;background:rgba(0,0,0,.55);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .3s;pointer-events:none;padding:20px;box-sizing:border-box}
.order-overlay.show{opacity:1;pointer-events:all}
.order-sheet{background:#fff;border-radius:16px;width:100%;max-width:560px;max-height:90vh;display:flex;flex-direction:column;transform:scale(.94) translateY(12px);transition:transform .3s cubic-bezier(.19,1,.22,1);box-shadow:0 20px 60px rgba(0,0,0,.25)}
.order-overlay.show .order-sheet{transform:scale(1) translateY(0)}
.order-sheet-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 12px;border-bottom:1px solid var(--border,#eee);background:#fff;z-index:1;flex-shrink:0}
.order-sheet-body{flex:1;overflow-y:auto;}
.order-sheet-title{font-size:16px;font-weight:700;color:var(--text,#1a1a1a)}
.order-close{background:none;border:none;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2,#999);font-size:20px;line-height:1;flex-shrink:0}
.order-close:hover{background:#f5f5f5}
.order-addr{display:flex;align-items:flex-start;gap:10px;padding:14px 20px;border-bottom:1px solid var(--border,#eee);background:#fafafa}
.order-addr-ico{font-size:16px;flex-shrink:0;margin-top:1px}
.order-addr-info{flex:1;min-width:0}
.order-addr-name{font-size:13px;font-weight:600;color:var(--text,#1a1a1a);margin-bottom:2px}
.order-addr-name span{font-size:12px;font-weight:400;color:var(--text2,#777);margin-left:8px}
.order-addr-detail{font-size:12px;color:var(--text2,#666);line-height:1.5}
.order-addr-tag{display:inline-block;font-size:10px;color:#ff2f2f;border:1px solid rgba(255,47,47,.35);border-radius:3px;padding:0 4px;margin-right:5px;vertical-align:middle}
.order-product{display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid var(--border,#eee)}
.order-product-img{width:72px;height:72px;border-radius:10px;object-fit:contain;background:#f5f5f5;flex-shrink:0;padding:4px;box-sizing:border-box}
.order-product-info{flex:1;min-width:0}
.order-product-name{font-size:14px;font-weight:600;color:var(--text,#1a1a1a);margin-bottom:4px;line-height:1.4}
.order-product-spec{font-size:12px;color:var(--text2,#777)}
.order-breakdown{padding:14px 20px}
.order-row{display:flex;justify-content:space-between;align-items:center;font-size:13px;margin-bottom:10px;color:var(--text2,#555)}
.order-row .ov{color:var(--text,#1a1a1a)}
.order-row .ov.red{color:#e03c31}
.order-row .ov.green{color:#22c55e;font-weight:600}
.order-divider{border:none;border-top:1px dashed var(--border,#e8e8e8);margin:10px 0}
.order-total-row{display:flex;justify-content:space-between;align-items:baseline;margin-top:4px}
.order-total-label{font-size:13px;font-weight:700;color:var(--text,#1a1a1a)}
.order-total-price{font-size:26px;font-weight:800;color:#e03c31}
.order-total-saving{font-size:11px;color:#22c55e;background:rgba(34,197,94,.1);padding:2px 8px;border-radius:99px;margin-left:8px;font-weight:600}
.order-notice{margin:0 20px 14px;padding:10px 12px;background:rgba(32,119,255,.05);border-radius:8px;font-size:11px;color:var(--text2,#777);line-height:1.6}
.order-notice b{color:#2077ff}
.order-invoice{display:flex;align-items:center;gap:10px;padding:12px 20px;border-bottom:1px solid var(--border,#eee)}
.order-invoice-ico{font-size:16px;flex-shrink:0}
.order-invoice-info{flex:1;min-width:0}
.order-invoice-label{font-size:13px;font-weight:600;color:var(--text,#1a1a1a);margin-bottom:2px}
.order-invoice-sub{font-size:12px;color:var(--text2,#777)}
.order-invoice-tag{display:inline-block;font-size:10px;color:#16a34a;border:1px solid rgba(22,163,74,.35);border-radius:3px;padding:0 4px;margin-right:5px;vertical-align:middle}
.order-pay{padding:12px 20px;border-bottom:1px solid var(--border,#eee)}
.order-pay-label{font-size:13px;font-weight:600;color:var(--text,#1a1a1a);margin-bottom:10px}
.order-pay-list{display:flex;flex-direction:row;gap:8px}
.order-pay-item{display:flex;align-items:center;justify-content:center;padding:8px 16px;border:1.5px solid var(--border,#eee);border-radius:10px;cursor:pointer;transition:all .2s;background:#fafafa;flex:1}
.order-pay-item.selected{border-color:#e03c31;background:rgba(224,60,49,.04)}
.order-pay-name{font-size:13px;font-weight:600;color:var(--text,#1a1a1a)}
.order-footer{padding:12px 20px 20px;display:flex;gap:10px;flex-shrink:0;border-top:1px solid var(--border,#eee);background:#fff}
.order-btn-cancel{flex:1;padding:12px;border:1.5px solid var(--border,#e0e0e0);border-radius:10px;background:#fff;color:var(--text2,#666);font-size:14px;font-weight:600;cursor:pointer;font-family:inherit}
.order-btn-cancel:hover{border-color:#aaa}
.order-btn-confirm{flex:2;padding:12px;background:#FF2F2F;border:none;border-radius:10px;color:#fff;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit}
.order-btn-confirm:hover{opacity:.9}

/* ── 商城内容区 ── */
.wrap{max-width:1080px;margin:0 auto;padding:0 32px}
.mall-hero{position:relative;margin:20px 0;border-radius:12px;overflow:hidden;height:300px;background:#f5f5f5}
.mall-slides{width:100%;height:100%;position:relative}
.mall-slide{position:absolute;inset:0;opacity:0;transition:opacity .5s ease}
.mall-slide.active{opacity:1}
.mall-slide img{width:100%;height:100%;object-fit:cover;display:block}
.mall-dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:8px}
.mall-dot{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background .3s}
.mall-dot.active{background:#fff}
.mall-sec{padding:28px 0}
.mall-sec-head{margin-bottom:24px}
.mall-sec-head h2{font-size:22px;font-weight:700;letter-spacing:-.5px;color:var(--text);margin-bottom:4px}
.mall-sec-head p{font-size:13px;color:var(--text2)}
.mall-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.mall-card{border:1px solid var(--border);border-radius:10px;overflow:hidden;cursor:pointer;transition:all .25s;background:var(--card)}
.mall-card:hover{border-color:var(--accent);box-shadow:0 8px 24px rgba(0,0,0,.08);transform:translateY(-3px)}
.mall-img{height:160px;background:#fff;display:flex;align-items:center;justify-content:center;padding:12px;box-sizing:border-box;overflow:hidden}
.mall-img img{width:100%;height:100%;object-fit:contain}
.mall-info{padding:12px 14px 14px}
.mall-name{font-size:13px;font-weight:600;color:var(--text);margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mall-desc{font-size:11px;color:var(--text2);margin-bottom:8px}
.mall-price{font-size:17px;font-weight:800;color:var(--accent)}
.mall-original{font-size:11px;color:#999;text-decoration:line-through;font-weight:400;margin-left:4px}
.mall-features{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;padding:32px 0 40px;border-top:1px solid var(--border)}
.mall-feat-item{text-align:center}
.mall-feat-icon{width:56px;height:56px;background:var(--card);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:22px;border:1px solid var(--border)}
.mall-feat-item h3{font-size:15px;font-weight:600;margin-bottom:6px;color:var(--text)}
.mall-feat-item p{font-size:12px;color:var(--text2);line-height:1.6}
@media(max-width:900px){.mall-grid{grid-template-columns:repeat(2,1fr)}.mall-features{grid-template-columns:1fr;gap:20px}.wrap{padding:0 16px}}
@media(max-width:600px){.mall-hero{height:200px}.mall-grid{grid-template-columns:repeat(2,1fr)}}

/* ── 商品详情页（displayCanvas 渲染） ── */
.pd-breadcrumb{font-size:13px;color:var(--text2);display:flex;align-items:center;gap:4px}
.pd-breadcrumb .sep{opacity:.4}
.pd-gallery{background:#fff;display:flex;flex-direction:column;padding:24px;min-height:400px;width:60%;flex-shrink:0;align-self:flex-start;box-sizing:border-box}
[data-theme="dark"] .pd-gallery{background:#1e1e2e}
.pd-gallery img{width:100%;max-height:360px;object-fit:contain;display:block}
@media(max-width:900px){.pd-gallery{min-height:220px}}
/* ── AI展示画布 ── */
#displayCanvas{position:absolute;top:56px;left:0;right:0;height:calc(100vh - 56px);height:calc(100dvh - 56px);background:#f8f8f8;z-index:90;overflow-y:auto;overscroll-behavior:contain;padding:0 20px 40px}
#displayCanvas .dc-topbar{display:flex;align-items:center;gap:12px;padding:14px 0;position:sticky;top:0;background:#f8f8f8;z-index:1}
#displayCanvas .dc-back{display:inline-flex;align-items:center;gap:4px;padding:7px 14px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text2);font-size:13px;cursor:pointer;transition:all .2s;font-family:inherit}
#displayCanvas .dc-back:hover{border-color:var(--accent);color:var(--accent)}
#displayCanvas .dc-back svg{width:16px;height:16px}
#displayCanvas .dc-title{font-size:15px;font-weight:600;color:var(--text)}
#displayCanvas .dc-body{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
#displayCanvas .dc-card{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.06);cursor:pointer;transition:transform .2s,box-shadow .2s}
#displayCanvas .dc-card:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.1)}
#displayCanvas .dc-card img{width:100%;aspect-ratio:1;object-fit:contain;background:#f5f5f5;padding:12px}
#displayCanvas .dc-card-info{padding:12px}
#displayCanvas .dc-card-name{font-size:13px;font-weight:500;color:var(--text);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#displayCanvas .dc-card-desc{font-size:12px;color:var(--text2);margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#displayCanvas .dc-card-price{font-size:15px;font-weight:600;color:#e1251b;margin-top:6px}
#displayCanvas .dc-card-price .dc-orig{font-size:11px;color:#999;text-decoration:line-through;margin-left:6px;font-weight:400}
@media(max-width:768px){#displayCanvas{position:fixed;top:0;left:0;width:100vw;height:100vh;height:100dvh;z-index:200}#landingPage.dc-open{display:block!important;z-index:30!important;opacity:1!important;transform:none!important;pointer-events:auto!important}}
.pd-page{padding:12px 20px}
.pd-breadcrumb{padding:8px 0;font-size:13px;color:#999}
.pd-breadcrumb a{color:#666;cursor:pointer;text-decoration:none}
.pd-breadcrumb a:hover{color:#e1251b}
.pd-breadcrumb .sep{margin:0 6px;color:#ddd}
.pd-detail-main{display:flex;gap:24px;background:#fff;border-radius:4px;padding:24px;margin-bottom:16px}
[data-theme="dark"] .pd-detail-main{background:var(--card2)}
.pd-gallery{width:60%;max-width:520px;flex-shrink:0;display:flex;flex-direction:column;align-self:flex-start}
.pd-main-img{width:100%;aspect-ratio:1;border:1px solid #eee;border-radius:4px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fafafa;margin-bottom:10px}
.pd-main-img img{max-width:100%;max-height:100%;object-fit:contain}
.pd-thumbs{display:flex;gap:6px;flex-wrap:wrap}
.pd-thumb{width:52px;height:52px;border:2px solid transparent;border-radius:4px;cursor:pointer;display:flex;align-items:center;justify-content:center;background:#fafafa;overflow:hidden}
.pd-thumb:hover,.pd-thumb.active{border-color:#e1251b}
.pd-thumb img{max-width:100%;max-height:100%;object-fit:contain}
.pd-info{flex:1;min-width:0;padding:24px 28px;align-self:flex-start}
.pd-detail-img{text-align:center;padding:16px 0}
.pd-detail-img img{max-width:100%;max-height:420px;object-fit:contain;border-radius:8px}
.pd-prod-name{font-size:20px;font-weight:bold;color:#1a1a2e;line-height:1.4;margin-bottom:8px}
.pd-prod-brief{font-size:13px;color:#666;margin-bottom:14px;line-height:1.5}
.pd-price-box{background:#fff8f0;padding:14px 18px;border-radius:4px;margin-bottom:16px}
[data-theme="dark"] .pd-price-box{background:rgba(225,37,27,.08)}
.pd-price-label{font-size:12px;color:#999;margin-right:8px}
.pd-price-val{font-size:28px;font-weight:bold;color:#e1251b}
.pd-price-val small{font-size:14px}
.pd-price-orig{font-size:14px;color:#999;text-decoration:line-through;margin-left:12px}
.pd-spec-list{margin-bottom:14px}
.pd-spec-row{display:flex;padding:5px 0;font-size:13px;border-bottom:1px solid #f5f5f5}
[data-theme="dark"] .pd-spec-row{border-bottom-color:var(--border)}
.pd-spec-label{width:60px;color:#999;flex-shrink:0}
.pd-spec-value{color:var(--text,#333);flex:1}
.pd-stock{font-size:13px;margin-bottom:10px}
.pd-stock .in{color:#52c41a}
.pd-stock .out{color:#ff4d4f}
.pd-action-btns{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.pd-action-btns .pd-btn-buy{flex:none;padding:0 36px;height:42px;background:#e1251b;color:#fff;border:none;border-radius:4px;font-size:14px;font-weight:600;cursor:pointer;transition:background .2s;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
.pd-action-btns .pd-btn-buy:hover{background:#c41d15}
.pd-action-btns .pd-btn-cart{flex:none;padding:0 36px;height:42px;background:#fff;color:#e1251b;border:1.5px solid #e1251b;border-radius:4px;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}
.pd-action-btns .pd-btn-cart:hover{background:#fff0f0}
.pd-action-btns .pd-btn-ask{flex:none;padding:0 24px;height:42px;background:linear-gradient(135deg,#667eea,#764ba2);border:none;border-radius:4px;font-size:14px;font-weight:600;color:#fff;cursor:pointer;transition:all .2s;font-family:inherit;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.pd-btn-ask:hover{opacity:.88;transform:translateY(-1px)}
/* AI 商品上下文浮层（覆盖 input-bar） */
.ai-product-overlay{position:absolute;left:0;right:0;bottom:0;z-index:10;background:linear-gradient(135deg,rgba(237,233,254,.98),rgba(245,240,255,.98));backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-top:1px solid #c4b5fd;border-radius:16px 16px 0 0;padding:36px 28px 40px;min-height:260px;box-shadow:0 -8px 32px rgba(109,40,217,.12);display:flex;flex-direction:column;justify-content:center;transform:translateY(0);opacity:1;transition:transform .35s cubic-bezier(.4,0,.2,1),opacity .25s ease;pointer-events:auto}
.ai-product-overlay.hiding{transform:translateY(100%);opacity:0;pointer-events:none}
.ai-product-overlay .ov-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px}
.ai-product-overlay .ov-label{font-size:13px;color:#8b5cf6;font-weight:700;letter-spacing:.5px}
.ai-product-overlay .ov-name{font-size:17px;font-weight:700;color:#1a1a2e;margin-top:6px;line-height:1.5}
.ai-product-overlay .ov-price{color:#e1251b;font-weight:700;font-size:17px}
.ai-product-overlay .ov-close{flex-shrink:0;width:32px;height:32px;border:none;background:rgba(0,0,0,.06);border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.ai-product-overlay .ov-close:hover{background:rgba(0,0,0,.14)}
.ai-product-overlay .ov-close svg{width:16px;height:16px;stroke:#555;stroke-width:2.5;fill:none}
.ai-product-overlay .ov-chips{display:flex;gap:12px;flex-wrap:wrap}
.ai-product-overlay .ov-chips button{padding:12px 24px;border:1px solid #c4b5fd;border-radius:22px;background:#fff;color:#6d28d9;font-size:15px;cursor:pointer;transition:all .2s;font-family:inherit;white-space:nowrap;font-weight:600;box-shadow:0 1px 4px rgba(109,40,217,.08)}
.ai-product-overlay .ov-chips button:hover{background:#7c3aed;color:#fff;border-color:#7c3aed;box-shadow:0 2px 8px rgba(124,58,237,.25)}
[data-theme="dark"] .ai-product-overlay{background:linear-gradient(135deg,rgba(30,27,58,.98),rgba(42,31,63,.98));border-color:#3b3560}
[data-theme="dark"] .ai-product-overlay .ov-name{color:#e0e0e0}
[data-theme="dark"] .ai-product-overlay .ov-close{background:rgba(255,255,255,.1)}
[data-theme="dark"] .ai-product-overlay .ov-close svg{stroke:#aaa}
[data-theme="dark"] .ai-product-overlay .ov-chips button{background:#2a2540;color:#c4b5fd;border-color:#4c3d80}
/* 收起后的按钮条（输入框上方） */
.product-chips-bar{display:flex;gap:8px;flex-wrap:wrap;padding:0 0 10px;animation:chipsSlideIn .3s ease}
.product-chips-bar.hidden{display:none}
.product-chips-bar button{padding:8px 18px;border:1px solid #c4b5fd;border-radius:20px;background:#fff;color:#6d28d9;font-size:13px;cursor:pointer;transition:all .2s;font-family:inherit;white-space:nowrap;font-weight:600}
.product-chips-bar button:hover{background:#7c3aed;color:#fff;border-color:#7c3aed}
[data-theme="dark"] .product-chips-bar button{background:#2a2540;color:#c4b5fd;border-color:#4c3d80}
@keyframes chipsSlideIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
/* 商品详情区下半部分：tabs + 内容 */
.pd-detail-below{background:#fff;border-radius:4px;margin-top:16px;overflow:hidden}
[data-theme="dark"] .pd-detail-below{background:var(--card2)}
.pd-tabs{display:flex;border-bottom:2px solid #f0f0f0;padding:0 24px}
[data-theme="dark"] .pd-tabs{border-bottom-color:var(--border)}
.pd-tab{padding:14px 20px;font-size:14px;color:#666;cursor:pointer;border:none;background:none;font-family:inherit;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .2s}
.pd-tab:hover{color:#333}
.pd-tab.active{color:#e1251b;border-bottom-color:#e1251b;font-weight:600}
[data-theme="dark"] .pd-tab:hover{color:var(--text)}
[data-theme="dark"] .pd-tab.active{color:#e1251b}
.pd-tab-panel{padding:24px;display:none}
.pd-tab-panel.active{display:block}
.pd-hl-title{font-size:15px;font-weight:600;color:var(--text,#333);margin:0 0 14px}
.pd-hl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px;margin-bottom:24px}
.pd-hl-item{display:flex;align-items:flex-start;gap:8px;padding:10px 14px;background:#fafafa;border-radius:4px;font-size:13px;color:#333;line-height:1.5}
[data-theme="dark"] .pd-hl-item{background:var(--card);color:var(--text)}
.pd-hl-item::before{content:'✓';color:#e1251b;font-weight:bold;flex-shrink:0}
.pd-tu-title{font-size:14px;font-weight:600;color:var(--text,#333);margin:0 0 10px}
.pd-tu-grid{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}
.pd-tu-tag{padding:5px 14px;background:#f0f7ff;color:#1677ff;border-radius:16px;font-size:12px}
[data-theme="dark"] .pd-tu-tag{background:rgba(22,119,255,.1)}
.pd-detail-img{text-align:center;margin:20px 0}
.pd-detail-img img{max-width:100%;border-radius:4px}
.pd-specs-tbl{width:100%;border-collapse:collapse}
.pd-specs-tbl tr{border-bottom:1px solid #f5f5f5}
[data-theme="dark"] .pd-specs-tbl tr{border-bottom-color:var(--border)}
.pd-specs-tbl td{padding:10px 14px;font-size:13px;vertical-align:top}
.pd-specs-tbl td:first-child{width:100px;color:#999;background:#fafafa;white-space:nowrap}
[data-theme="dark"] .pd-specs-tbl td:first-child{background:var(--card)}
.pd-specs-tbl td:last-child{color:var(--text,#333)}
@media(max-width:600px){.pd-detail-main{flex-direction:column}.pd-gallery{width:100%;max-width:none}.pd-hl-grid{grid-template-columns:1fr}}
/* AI 悬浮入口按钮 */
.ai-fab{position:fixed;bottom:24px;right:24px;z-index:999;display:inline-flex;align-items:center;gap:6px;padding:12px 20px;border:none;border-radius:999px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;font-size:14px;font-weight:600;font-family:inherit;cursor:pointer;box-shadow:0 4px 16px rgba(102,126,234,.4);transition:all .25s}
.ai-fab:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(102,126,234,.55)}
.ai-fab:active{transform:translateY(0)}
html.split-mode.chat-revealed .ai-fab,html.is-chat .ai-fab{display:none}
@media(max-width:768px){.ai-fab{bottom:16px;right:16px;padding:10px 16px;font-size:13px}}
</style>
<link rel="stylesheet" href="/split-layout.css?v=20260512-floating-close">
</head>
<body>
<script>var _p=location.pathname,_chatPrefixes=['/chat','/shop-chat','/b-chat','/biz-chat'],_siteType='default';
_chatPrefixes.forEach(function(x){if(_p.startsWith(x)){_siteType=x.replace('/','').replace('-chat','');var rest=_p.slice(x.length);document.documentElement.classList.add('is-chat');if(rest.split('/')[1])document.documentElement.classList.add('is-chat-conv');}});
if(_siteType==='chat')_siteType='default';
document.documentElement.dataset.site=_siteType;
window.__siteType=_siteType;window.__chatBase=_siteType==='default'?'/chat':'/'+_siteType+'-chat';</script>

<!-- ══════════ LANDING PAGE ══════════ -->
<div id="landingPage">
<nav>
  <div class="logo" onclick="if(location.pathname!=='/'){location.href='/'}else{location.reload()}" style="cursor:pointer" title="返回首页"><img src="https://p2.lefile.cn/fes/cms/2026/04/15/o91jmkfrd1j7modqdoadmgv6sroz50894755.png" alt="Lenovo 联想"></div>
  <div class="nlinks" id="navLinks"></div>
  <script>!function(){
    // 直接从 pathname 计算，不用依赖 __siteType 时序
    var _path = location.pathname;
    var _prefixMap = {'/shop-chat':'shop','/b-chat':'b','/biz-chat':'biz'};
    var _st = 'default';
    for(var k in _prefixMap){ if(_path.startsWith(k)){ _st=_prefixMap[k]; break; } }
    var NAV_ITEMS=[
      {label:'个人及家庭',href:'/shop-chat/',key:'shop'},
      {label:'中小企业',href:'/b-chat/',key:'b'},
      {label:'政教及大企业',href:'/biz-chat/',key:'biz'},
    ];
    var items=NAV_ITEMS.map(function(it){ return Object.assign({},it,{active:it.key===_st}); });
    var html=items.map(function(it){
      if(it.href) return '<a href="'+it.href+'" data-nav="'+it.label+'"'+(it.active?' class="nav-active"':'')+'>'+it.label+'</a>';
      return '<a href="#" data-nav="'+it.label+'" onclick="setNavActive(\''+it.label+'\');startChat(\''+it.q.replace(/'/g,"\\'")+'\');return false;">'+it.label+'</a>';
    }).join('');
    document.getElementById('navLinks').innerHTML=html;
  }();</script>
  <div class="nright">
    <svg class="nav-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
    <div id="navAuthArea"><a href="#" onclick="showLoginModal();return false;">登录</a><span class="sep">|</span><a href="#" onclick="showLoginModal();return false;">注册</a></div>
    <div id="navUserArea" style="display:none;align-items:center;gap:8px;"><span id="navNickname" style="font-size:13px;cursor:pointer;"></span><a href="#" onclick="doLogout();return false;" style="font-size:12px;opacity:.6;">退出</a></div>
    <button class="tog" id="tog" aria-label="切换主题" style="display:none">
      <svg class="sun" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/></svg>
      <svg class="moon" viewBox="0 0 20 20" fill="currentColor"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
      <span class="k"></span>
    </button>
  </div>
</nav>
<div class="hero-wrap"><div class="blob blob1"></div><div class="blob blob2"></div><div class="blob blob3"></div><div class="blob blob4"></div><section class="hero">
  <h1>你好，我是联想乐享</h1>
  <div class="search"><input type="text" placeholder="最近有什么促销活动？" id="heroInput" autocomplete="off"><button class="send-btn" id="heroSend" aria-label="发送"><svg viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg></button></div>
