//  🧧 红包对话 Demo（每步独立消息）
// ══════════════════════════════════════
// 真实商品数据，来源：s.lenovo.com.cn 实时抓取（2026-03-25）
const HB_PRODS = [
  {
    id: '1047558',
    name: '小新平板 Pro GT 11.1英寸 AI平板',
    price: 2499,
    orig: 2799,
    img: null,
    imgUrl: 'https://p1.lefile.cn/fes/cms/2026/03/21/cwq404an8h4ofuuy0tapy2goehgz75460176.png',
    url: 'https://item.lenovo.com.cn/product/1047558.html',
    tag: '🔥 AI旗舰',
    spec: '信风灰 · 256GB'
  },
  {
    id: '1050036',
    name: '小新 Pad Pro 12.7 2025款',
    price: 1899,
    orig: 2199,
    img: null,
    imgUrl: 'https://p1.lefile.cn/fes/cms/2026/03/21/50ej4f8grzedgyypyqy0t03bn6rtz6349359.png',
    url: 'https://item.lenovo.com.cn/product/1050036.html',
    tag: '✨ 2025新款',
    spec: '霜雪银 · 12.7英寸'
  },
  {
    id: '1045775',
    name: '小新平板11 AI平板',
    price: 1099,
    orig: 1299,
    img: null,
    imgUrl: 'https://p1.lefile.cn/fes/cms/2026/03/21/hifil8va3tii74vmwvee5afavpucot922206.png',
    url: 'https://item.lenovo.com.cn/product/1045775.html',
    tag: '💎 高性价比',
    spec: '天青色 · 128GB'
  },
];
let hbSelProd = HB_PRODS[0];

// 发一条用户气泡（文字），然后延迟回调
function _hbUserMsg(text, delay, cb) {
  appendBubble('user', text);
  showTyping();
  setTimeout(() => { hideTyping(); cb(); }, delay);
}

// 往对话流插一条 AI 卡片消息
function _hbAiCard(cardEl, textBefore) {
  const ws = document.getElementById('welcomeScreen');
  if (ws) ws.remove();
  const inner = document.getElementById('msgsInner');
  const d = document.createElement('div');
  d.className = 'msg ai';
  const body = document.createElement('div');
  body.className = 'msg-body';
  // 可选前置文字
  const preHtml = textBefore ? `<div class="mbubble" style="margin-bottom:8px">${escHtml(textBefore)}</div>` : '';
  body.innerHTML = `<div class="msg-pre"></div>${preHtml}<div class="mbubble hb-mbubble"></div>`;
  d.innerHTML = ``;
  d.appendChild(body);
  inner.appendChild(d);
  body.querySelector('.hb-mbubble').appendChild(cardEl);
  scrollBottom();
}

// ── Step 1 触发：用户点击"🧧 买平板返100" ──
function triggerHongbao() {
  showChatApp();
  _hbUserMsg('🧧 买平板返100', 800, () => {
    _hbAiCard(_buildHbStep1(), '为您送上专属红包，购买联想平板立减 ¥100 👇');
  });
}

// ── Step 1 卡片：发红包 ──
function _buildHbStep1() {
  const card = document.createElement('div');
  card.className = 'hb-card';
  card.innerHTML = `
    <div class="hb-card-head">
      <div class="hb-ico">🧧</div>
      <div class="hb-info">
        <div class="hb-title">联想乐享消费红包</div>
        <div class="hb-sub">限时活动 · 购平板立减¥100</div>
      </div>
    </div>
    <div class="hb-card-body">
      <div class="hb-amount-big">
        <div><span class="hb-unit">¥</span><span class="hb-am">100</span></div>
        <div class="hb-tip">消费红包 · 购任意联想平板可用</div>
      </div>
      <div class="hb-conds">
        <b>使用条件：</b>购买任意联想平板，满¥999可用<br>
        <b>有效期：</b>领取后30天内有效
      </div>
      <button class="hb-btn" onclick="hbDoReceive(this)">立即领取红包</button>
    </div>`;
  return card;
}

// ── 用户点"立即领取" → 用户消息 + AI回复拆红包卡片 ──
function hbDoReceive(btn) {
  btn.disabled = true;
  btn.textContent = '已领取 ✓';
  btn.style.opacity = '0.6';
  setTimeout(() => {
    _hbUserMsg('领取红包', 700, () => {
      _hbAiCard(_buildHbStep2(), null);
    });
  }, 300);
}

// ── Step 2 卡片：拆红包 ──
function _buildHbStep2() {
  const card = document.createElement('div');
  card.className = 'hb-card';
  card.innerHTML = `
    <div class="hb-card-head">
      <div class="hb-ico">🎉</div>
      <div class="hb-info">
        <div class="hb-title">恭喜！红包到手了</div>
        <div class="hb-sub">¥100 已存入您的账户</div>
      </div>
    </div>
    <div class="hb-card-body">
      <div class="hb-open-anim">
        <div class="hb-open-circle">
          <div class="oc-am">100</div>
          <div class="oc-unit">元</div>
        </div>
        <div class="hb-open-sub" style="font-size:12px;color:var(--text2,#777);margin-bottom:14px">红包有效期至 ${(() => { const d=new Date(); d.setDate(d.getDate()+30); return d.getFullYear()+'-'+(d.getMonth()+1).toString().padStart(2,'0')+'-'+d.getDate().toString().padStart(2,'0'); })()}</div>
      </div>
      <button class="hb-btn gold" onclick="hbDoShop(this)">去挑选平板，使用红包 →</button>
    </div>`;
  return card;
}

// ── 用户点"去挑选平板" → 用户消息 + AI回复商品卡片 ──
function hbDoShop(btn) {
  btn.disabled = true;
  btn.textContent = '前往选购…';
  setTimeout(() => {
    _hbUserMsg('我要用红包买平板', 800, () => {
      _hbAiCard(_buildHbStep3(), '为您推荐以下平板，红包自动抵扣 ¥100 👇');
    });
  }, 300);
}

// ── Step 3 卡片：选商品 ──
function _buildHbStep3() {
  const card = document.createElement('div');
  card.className = 'hb-card';
  const prodsHtml = HB_PRODS.map((p,i) => `
    <div class="hb-prod${i===0?' sel':''}" data-id="${p.id}" onclick="hbSelectProd(this,'${p.id}')">
      <div class="hb-prod-img"><img src="${p.imgUrl}" alt="${p.name}" style="width:100%;height:100%;object-fit:contain;border-radius:6px"></div>
      <div class="hb-prod-info">
        <div class="hb-prod-name">${p.name}</div>
        <div style="font-size:10px;color:var(--text2,#999);margin-bottom:3px">${p.spec}</div>
        <div class="hb-prod-price">
          <span class="pp">¥${(p.price-100).toLocaleString()}</span>
          <span class="po">¥${p.orig.toLocaleString()}</span>
          <span class="ps">红包-¥100</span>
        </div>
      </div>
      <div class="hb-prod-check"></div>
    </div>`).join('');
  card.innerHTML = `
    <div class="hb-card-head">
      <div class="hb-ico">🛍️</div>
      <div class="hb-info">
        <div class="hb-title">选择平板</div>
        <div class="hb-sub">红包自动抵扣 · 已为您省¥100</div>
      </div>
    </div>
    <div class="hb-card-body">
      <div class="hb-prod-list hb-prod-list-3">${prodsHtml}</div>
      <div class="hb-deduct"><span>消费红包抵扣</span><span class="dd">-¥100</span></div>
      <button class="hb-btn" onclick="hbDoOrder(this)">确认下单</button>
    </div>`;
  return card;
}

function hbSelectProd(el, id) {
  hbSelProd = HB_PRODS.find(p=>p.id===id);
  el.closest('.hb-prod-list-3').querySelectorAll('.hb-prod').forEach(e => e.classList.toggle('sel', e===el));
}


// ── 用户点"确认下单" → 用户消息 + AI回复成功卡片 ──
function hbDoOrder(btn) {
  const p = hbSelProd;
  btn.disabled = true;
  btn.textContent = '下单中…';
  setTimeout(() => {
    _hbUserMsg(`下单 ${p.name}，用红包抵扣`, 900, () => {
      _hbAiCard(_buildHbStep4(p), null);
    });
  }, 300);
}

// ── Step 4 卡片：下单成功 ──
function _buildHbStep4(p) {
  const final = p.price - 100;
  const no = 'LX' + Date.now().toString().slice(-8);
  const card = document.createElement('div');
  card.className = 'hb-card';
  card.innerHTML = `
    <div class="hb-card-head" style="background:linear-gradient(135deg,#16a34a,#22c55e)">
      <div class="hb-ico" style="background:linear-gradient(135deg,#bbf7d0,#86efac)">✅</div>
      <div class="hb-info">
        <div class="hb-title">下单成功！</div>
        <div class="hb-sub">预计3-5个工作日发货</div>
      </div>
    </div>
    <div class="hb-card-body">
      <div class="hb-order-item">
        <div style="width:56px;height:56px;border-radius:10px;overflow:hidden;flex-shrink:0;background:#f5f5f5"><img src="${p.imgUrl}" style="width:100%;height:100%;object-fit:contain"></div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:600;color:var(--text,#1a1a1a);margin-bottom:4px">${p.name}</div>
          <div style="font-size:12px;color:var(--text2,#777)">颜色：深空灰 · 存储：128GB</div>
        </div>
      </div>
      <div class="hb-order-info" style="margin:12px 0">
        <div class="oi-row"><span class="ok">商品价格</span><span class="ov">¥${p.price.toLocaleString()}</span></div>
        <div class="oi-row"><span class="ok">消费红包</span><span class="ov red">-¥100</span></div>
        <div class="oi-row" style="border-top:1px dashed var(--border,#e8e8e8);padding-top:6px;margin-top:4px"><span class="ok" style="font-weight:700">实付金额</span><span class="ov red" style="font-size:16px;font-weight:800">¥${final.toLocaleString()}</span></div>
      </div>
      <div class="hb-order-no">订单号 ${no}</div>
      <div class="hb-share-row" style="margin-top:10px">
        <button class="hb-btn gray" style="flex:1" onclick="showToastHb('分享链接已复制 🎉')">分享给同事</button>
        <button class="hb-btn" style="flex:1" onclick="window.open(hbSelProd.url,'_blank')">去商品页</button>
      </div>
    </div>`;
  return card;
}

function showToastHb(msg) {
  const t = document.getElementById('hbToast');
  if (!t) return;
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2200);
}

// ══════════════════════════════════════
//  🎟️ 立即购买 → 自动顺序领取所有优惠
// ══════════════════════════════════════
function startBuyFlow(productName, productPrice) {
  // 已完成：直接重新弹出订单弹层
  if (startBuyFlow._done) {
    var ov = document.getElementById('orderOverlay');
    if (ov) ov.classList.add('show');
    return;
  }
  // 进行中：不重复触发
  if (startBuyFlow._running) return;
  startBuyFlow._running = true;

  if (typeof showChatApp === 'function') showChatApp();
  if (typeof window.__revealChat === 'function') window.__revealChat();

  var priceNum = parseInt(String(productPrice).replace(/[^\d]/g, '')) || 0;

  var couponRate = priceNum >= 10000 ? [500,300,200] : priceNum >= 3000 ? [200,100,50] : priceNum >= 1000 ? [80,30,20] : [15,10,5];
  var coupons = [
    { title:'商品平台满减券', sub:'联想商城专属', amount:couponRate[0] },
    { title:'联想会员折扣券', sub:'乐享会员专享', amount:couponRate[1] },
    { title:'限时活动补贴',   sub:'今日截止·限量', amount:couponRate[2] }
  ];
  var totalSaving = coupons.reduce(function(s,c){ return s+c.amount; }, 0);
  var finalPrice  = Math.max(0, priceNum - totalSaving);
  var origText    = priceNum > 0 ? '¥'+priceNum.toLocaleString() : '';
  var finalText   = priceNum > 0 ? '¥'+finalPrice.toLocaleString() : '优惠到账';

  // 构建卡片骨架（初始无优惠项）
  var card = document.createElement('div');
  card.className = 'bf-card';
  card.innerHTML =
    '<div class="bf-card-head">' +
      '<div class="bf-card-head-title">正在为您自动领取优惠</div>' +
      '<div class="bf-card-head-sub">'+escHtml(productName)+'</div>' +
      '<div class="bf-progress-wrap"><div class="bf-progress-bar" id="bfProgressBar"></div></div>' +
    '</div>' +
    '<div class="bf-list" id="bfList"></div>';

  // 插入用户消息 + AI 卡片
  appendBubble('user', '我要购买 ' + productName + '，帮我领取所有可用优惠');
  var ws = document.getElementById('welcomeScreen');
  if (ws) ws.remove();
  var inner = document.getElementById('msgsInner');
  var d = document.createElement('div');
  d.className = 'msg ai';
  var body = document.createElement('div');
  body.className = 'msg-body';
  body.innerHTML = '<div class="msg-pre"></div><div class="mbubble" style="margin-bottom:8px">好的！为您自动领取 '+coupons.length+' 张专属优惠 👇</div><div class="mbubble hb-mbubble"></div>';
  d.appendChild(body);
  inner.appendChild(d);
  body.querySelector('.hb-mbubble').appendChild(card);
  scrollBottom();

  // 每张券：出现 → 领取中 → 已领取，依次触发
  // 节奏：每张券占 1100ms（200ms出现后立即开始，700ms后打勾，再等400ms出下一张）
  var APPEAR = 0, LOAD = 200, DONE = 900, NEXT_GAP = 1100;

  coupons.forEach(function(c, i) {
    var base = 400 + i * NEXT_GAP;

    // 1. 追加这张券（淡入）
    setTimeout(function() {
      var list = document.getElementById('bfList');
      if (!list) return;
      var item = document.createElement('div');
      item.className = 'bf-item active';
      item.id = 'bfItem_'+i;
      item.innerHTML =
        '<div class="bf-item-info">' +
          '<div class="bf-item-name">'+escHtml(c.title)+'</div>' +
          '<div class="bf-item-amount">-¥'+c.amount+' · '+escHtml(c.sub)+'</div>' +
        '</div>' +
        '<div class="bf-item-status loading" id="bfSt_'+i+'"><span class="bf-spinner"></span> 领取中</div>';
      list.appendChild(item);
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){ scrollBottom(true); });
      });
    }, base + APPEAR);

    // 2. 打勾
    setTimeout(function() {
      var st = document.getElementById('bfSt_'+i);
      var it = document.getElementById('bfItem_'+i);
      if (st) { st.className='bf-item-status done'; st.textContent='✓ 已领取'; }
      if (it) { it.classList.remove('active'); it.classList.add('claimed'); }
      var pb = document.getElementById('bfProgressBar');
      if (pb) pb.style.width = Math.round((i + 1) / coupons.length * 100) + '%';
      scrollBottom();
    }, base + DONE);
  });

  // 全部完成后追加价格 + 下单按钮，并自动弹出订单确认层
  var allDone = 400 + (coupons.length - 1) * NEXT_GAP + DONE + 400;
  setTimeout(function() {
    // 标记流程结束：释放运行锁，置已完成，禁用购买按钮
    startBuyFlow._running = false;
    startBuyFlow._done = true;
    var pdBtn = document.getElementById('pdBuyBtn');
    if (pdBtn) { pdBtn.disabled = false; pdBtn.textContent = '立即购买'; pdBtn.style.opacity = ''; pdBtn.style.cursor = ''; }
    // 更新卡片标题，隐藏进度条
    var titleEl = card.querySelector('.bf-card-head-title');
    if (titleEl) titleEl.textContent = '已经帮你自动领完优惠';
    var pwrap = card.querySelector('.bf-progress-wrap');
    if (pwrap) pwrap.style.display = 'none';

    var priceWrap = document.createElement('div');
    priceWrap.className = 'bf-price-wrap';
    priceWrap.innerHTML =
      '<div class="bf-price-label">到手价</div>' +
      '<div class="bf-price-row2">' +
        (origText ? '<span class="bf-price-orig">'+origText+'</span>' : '') +
        '<span class="bf-price-final">'+finalText+'</span>' +
        '<span class="bf-price-saving">省¥'+totalSaving+'</span>' +
      '</div>';
    card.appendChild(priceWrap);

    var btn = document.createElement('button');
    btn.className = 'bf-order-btn';
    btn.textContent = '查看订单详情 →';
    btn.onclick = function(){ _showOrderOverlay(); };
    card.appendChild(btn);
    setTimeout(function(){ btn.classList.add('show'); }, 50);
    // 等渲染完成后强制滚到底，露出订单按钮
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){ scrollBottom(true); });
    });
    // 自动弹出订单确认层
    setTimeout(_showOrderOverlay, 800);
  }, allDone);

  function _showOrderOverlay() {
    // 防止重复创建
    if (document.getElementById('orderOverlay')) {
      document.getElementById('orderOverlay').classList.add('show');
      return;
    }
    var no = 'LX' + Date.now().toString().slice(-10);
    var rowsHtml = coupons.map(function(c) {
      return '<div class="order-row"><span>'+escHtml(c.title)+'</span><span class="ov green">-¥'+c.amount+'</span></div>';
    }).join('');

    var overlay = document.createElement('div');
    overlay.className = 'order-overlay';
    overlay.id = 'orderOverlay';
    overlay.innerHTML =
      '<div class="order-sheet">' +
        '<div class="order-sheet-head">' +
          '<span class="order-sheet-title">确认订单</span>' +
          '<button class="order-close" onclick="document.getElementById(\'orderOverlay\').classList.remove(\'show\')">×</button>' +
        '</div>' +
        '<div class="order-sheet-body">' +
        '<div class="order-product">' +
          '<img class="order-product-img" src="" alt="">' +
          '<div class="order-product-info">' +
            '<div class="order-product-name">'+escHtml(productName)+'</div>' +
            '<div class="order-product-spec">Ultra7-356H · 14英寸 · 32GB · 1T SSD</div>' +
          '</div>' +
        '</div>' +
        '<div class="order-addr">' +
          '<div class="order-addr-info">' +
            '<div class="order-addr-name">观同学<span>138 **** 8888</span></div>' +
            '<div class="order-addr-detail"><span class="order-addr-tag">默认</span>北京市朝阳区望京街道望京 SOHO T1 栋 2018 室</div>' +
          '</div>' +
        '</div>' +
        '<div class="order-invoice">' +
          '<div class="order-invoice-info">' +
            '<div class="order-invoice-label">个人发票</div>' +
            '<div class="order-invoice-sub">电子普通发票 · 发至注册邮箱</div>' +
          '</div>' +
        '</div>' +
        '<div class="order-breakdown">' +
          '<div class="order-row"><span>商品原价</span><span class="ov">'+( origText || finalText )+'</span></div>' +
          rowsHtml +
          '<hr class="order-divider">' +
          '<div class="order-total-row">' +
            '<span class="order-total-label">实付金额</span>' +
            '<div style="display:flex;align-items:baseline;gap:6px">' +
              '<span class="order-total-price">'+finalText+'</span>' +
              '<span class="order-total-saving">已省¥'+totalSaving+'</span>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="order-pay">' +
          '<div class="order-pay-label">支付方式</div>' +
          '<div class="order-pay-list">' +
            '<div class="order-pay-item selected" onclick="selectPayMethod(this)">' +
              '<span class="order-pay-name">微信支付</span>' +
            '</div>' +
            '<div class="order-pay-item" onclick="selectPayMethod(this)">' +
              '<span class="order-pay-name">支付宝</span>' +
            '</div>' +
            '<div class="order-pay-item" onclick="selectPayMethod(this)">' +
              '<span class="order-pay-name">京东支付</span>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="order-notice">优惠券已自动领取并抵扣 · 订单号 <b>'+no+'</b></div>' +
        '</div>' +
        '<div class="order-footer">' +
          '<button class="order-btn-cancel" onclick="document.getElementById(\'orderOverlay\').classList.remove(\'show\')">再想想</button>' +
          '<button class="order-btn-confirm" onclick="showToastHb(\'订单提交成功！\');document.getElementById(\'orderOverlay\').classList.remove(\'show\')">立即支付</button>' +
        '</div>' +
      '</div>';

    // 点遮罩关闭
    overlay.addEventListener('click', function(e){ if(e.target===overlay) overlay.classList.remove('show'); });
    document.body.appendChild(overlay);
    requestAnimationFrame(function(){ requestAnimationFrame(function(){ overlay.classList.add('show'); }); });
  }
}
window.startBuyFlow = startBuyFlow;

function selectPayMethod(el) {
  var list = el.closest('.order-pay-list');
  if (!list) return;
  list.querySelectorAll('.order-pay-item').forEach(function(item) {
    item.classList.remove('selected');
  });
  el.classList.add('selected');
}
window.selectPayMethod = selectPayMethod;

</script>
<div id="hbToast" style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(.8);background:rgba(0,0,0,.72);color:#fff;padding:10px 18px;border-radius:10px;font-size:13px;pointer-events:none;opacity:0;transition:all .25s;z-index:9999;white-space:nowrap"></div>
<style>#hbToast.show{opacity:1;transform:translate(-50%,-50%) scale(1)}</style>

<!-- ══════════ 登录弹窗 ══════════ -->
<div id="loginModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.55);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
  <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;padding:32px 28px;width:340px;max-width:92vw;position:relative;">
    <button onclick="hideLoginModal()" style="position:absolute;top:12px;right:16px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--text2);">×</button>
    <div style="font-size:20px;font-weight:700;margin-bottom:6px;">手机号登录</div>
    <div style="font-size:13px;color:var(--text2);margin-bottom:22px;">未注册手机号将自动创建账号</div>
    <div style="margin-bottom:14px;">
      <input id="loginPhone" type="tel" maxlength="11" placeholder="请输入手机号"
        style="width:100%;box-sizing:border-box;padding:10px 14px;border:1px solid var(--border);border-radius:8px;font-size:15px;background:var(--bg);color:var(--text);outline:none;">
    </div>
    <div style="display:flex;gap:8px;margin-bottom:20px;">
      <input id="loginCode" type="text" maxlength="6" placeholder="验证码"
        style="flex:1;padding:10px 14px;border:1px solid var(--border);border-radius:8px;font-size:15px;background:var(--bg);color:var(--text);outline:none;">
      <button id="sendCodeBtn" onclick="sendLoginCode()"
        style="padding:10px 14px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:13px;cursor:pointer;white-space:nowrap;min-width:88px;">
        发送验证码
      </button>
    </div>
    <button onclick="doLogin()"
      style="width:100%;padding:12px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer;">
      登录 / 注册
    </button>
    <div id="loginMsg" style="margin-top:12px;font-size:13px;text-align:center;color:#e03c31;min-height:18px;"></div>
  </div>
</div>

<!-- 算术验证浮层 -->
<div id="captchaModal" style="display:none;position:fixed;inset:0;z-index:10000;align-items:center;justify-content:center;">
  <div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:24px 28px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,.18);">
    <div style="font-size:22px;font-weight:700;margin-bottom:16px;" id="captchaQuestion"></div>
    <input id="captchaAnswer" type="number" placeholder="=" autofocus
      style="width:80px;padding:10px;text-align:center;border:1px solid var(--border);border-radius:8px;font-size:20px;background:var(--bg);color:var(--text);outline:none;">
    <div style="margin-top:14px;display:flex;gap:8px;justify-content:center;">
      <button onclick="submitCaptcha()" style="padding:8px 24px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:14px;cursor:pointer;">确认</button>
      <button onclick="closeCaptcha()" style="padding:8px 16px;background:none;border:1px solid var(--border);border-radius:8px;font-size:14px;cursor:pointer;color:var(--text2);">取消</button>
    </div>
  </div>
</div>

<script>
// ── 登录弹窗逻辑 ──
function showLoginModal(){ document.getElementById('loginModal').style.display='flex'; }
function hideLoginModal(){ document.getElementById('loginModal').style.display='none'; }
window.addEventListener('DOMContentLoaded', function(){
  var m = document.getElementById('loginModal');
  if(m) m.addEventListener('click', function(e){ if(e.target===this) hideLoginModal(); });
  // 默认展示登录态：观同学
  onLoginSuccess({ nickname: '观同学', phone: '13800008888' });
  // 检查登录态（_authReady 供 restoreFromUrl 等待）
  window._authReady = fetch('/api/auth/me').then(function(r){return r.json();}).then(function(d){ if(d.user) onLoginSuccess(d.user); }).catch(function(){});
  // 子站路径自动高亮对应导航
  var _sn={'shop':'个人及家庭','b':'中小企业','biz':'政教及大企业'};
  // 首页直接清除高亮，不再依赖 __siteType
  if(location.pathname === '/') {
    document.querySelectorAll('.nlinks a').forEach(function(a){ a.classList.remove('nav-active'); });
  } else if(_sn[window.__siteType]) {
    setNavActive(_sn[window.__siteType]);
  }
});

var _captchaAnswer = 0;
var _captchaPending = false;
function refreshCaptcha(){
  var a = Math.floor(Math.random()*9)+1;
  var b = Math.floor(Math.random()*9)+1;
  _captchaAnswer = a + b;
  var el = document.getElementById('captchaQuestion');
  if(el) el.textContent = a + ' + ' + b + ' = ?';
  var inp = document.getElementById('captchaAnswer');
  if(inp){ inp.value = ''; setTimeout(function(){ inp.focus(); }, 50); }
}
function closeCaptcha(){
  document.getElementById('captchaModal').style.display='none';
  _captchaPending = false;
}
function submitCaptcha(){
  var ans = parseInt(document.getElementById('captchaAnswer').value);
  if(isNaN(ans) || ans !== _captchaAnswer){ refreshCaptcha(); return; }
  closeCaptcha();
  doSendCode();
}

async function sendLoginCode(){
  const phone = document.getElementById('loginPhone').value.trim();
  if(!/^1[3-9]\d{9}$/.test(phone)){ setLoginMsg('请输入正确的手机号'); return; }
  setLoginMsg('');
  refreshCaptcha();
  document.getElementById('captchaModal').style.display='flex';
  // 支持回车提交
  const inp = document.getElementById('captchaAnswer');
  inp.onkeydown = function(e){ if(e.key==='Enter') submitCaptcha(); };
}

async function doSendCode(){
  const phone = document.getElementById('loginPhone').value.trim();
  const btn = document.getElementById('sendCodeBtn');
  btn.disabled = true;
  try {
    const r = await fetch('/api/auth/send-code', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({phone}) });
    const d = await r.json();
    if(d.success){
      setLoginMsg('验证码已发送，请注意查收', 'green');
      let s = 60;
      btn.textContent = s + 's后重试';
      const t = setInterval(()=>{ s--; if(s<=0){ clearInterval(t); btn.disabled=false; btn.textContent='发送验证码'; } else { btn.textContent=s+'s后重试'; } }, 1000);
    } else {
      setLoginMsg(d.error || '发送失败');
      btn.disabled = false;
    }
  } catch(e){ setLoginMsg('网络错误，请重试'); btn.disabled=false; }
}

async function doLogin(){
  const phone = document.getElementById('loginPhone').value.trim();
  const code  = document.getElementById('loginCode').value.trim();
  if(!/^1[3-9]\d{9}$/.test(phone)){ setLoginMsg('请输入正确的手机号'); return; }
  if(!/^\d{6}$/.test(code)){ setLoginMsg('请输入6位验证码'); return; }
  try {
    const r = await fetch('/api/auth/login', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({phone,code,anon_uid:_UID}) });
    const d = await r.json();
    if(d.success){
      hideLoginModal();
      onLoginSuccess(d.user);
    } else {
      setLoginMsg(d.error || '登录失败');
    }
  } catch(e){ setLoginMsg('网络错误，请重试'); }
}

async function doLogout(){
  await fetch('/api/auth/logout', { method:'POST' });
  _loginUser = null;
  _anonRounds = 0;
  convList = [];
  updateSidebar();
  updateNavUser(null);
}

function updateNavUser(user){
  const authArea = document.getElementById('navAuthArea');
  const userArea = document.getElementById('navUserArea');
  const nickname = document.getElementById('navNickname');
  const chatAuth = document.getElementById('chatNavAuth');
  const chatUser = document.getElementById('chatNavUser');
  const chatNick = document.getElementById('chatNavNickname');
  const name = user ? (user.nickname || user.phone.replace(/(.{3}).+(.{4})/, '$1****$2')) : '';
  if(user){
    if(authArea) authArea.style.display = 'none';
    if(userArea) userArea.style.display = 'flex';
    if(nickname) nickname.textContent = name;
    if(chatAuth) chatAuth.style.display = 'none';
    if(chatUser) chatUser.style.display = 'block';
    if(chatNick) chatNick.textContent = name;
  } else {
    if(authArea) authArea.style.display = '';
    if(userArea) userArea.style.display = 'none';
    if(chatAuth) chatAuth.style.display = 'block';
    if(chatUser) chatUser.style.display = 'none';
  }
}

function setLoginMsg(msg, color){
  const el = document.getElementById('loginMsg');
  el.textContent = msg;
  el.style.color = color === 'green' ? '#10b981' : '#e03c31';
}


</script>
<script src="/split-layout.js?v=20260512-link-resolver"></script>
</body>
</html>
