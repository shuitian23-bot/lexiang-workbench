  document.getElementById('thinkBtn').classList.toggle('active-think', thinkingEnabled);
}

function toggleLeai() {
  leaiCompare = !leaiCompare;
  document.getElementById('leaiToggle').classList.toggle('active-web', leaiCompare);
  document.getElementById('leaiLabel').textContent = leaiCompare ? '对比模式' : '官方AI';
}

// Share conversation
async function shareConv() {
  if (!convId) return;
  try {
    const r = await apiFetch('/api/chat/share', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ conv_id: convId })
    });
    if (!r.ok) return;
    const { token } = await r.json();
    const url = location.origin + '/share/' + token;
    await navigator.clipboard.writeText(url);
    const btn = document.getElementById('shareBtn');
    const orig = btn.innerHTML;
    btn.textContent = t('shareSuccess');
    setTimeout(() => { btn.innerHTML = orig; }, 2000);
  } catch(e) {}
}
let convList = []; // [{id, title}]

// ── Theme ──
const SUN_I = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>';
const MOON_I = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
function isDark(){ return document.documentElement.getAttribute('data-theme') === 'dark'; }
function applyTheme(dark){
  document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  // Landing page .tog is pure CSS driven by data-theme, no JS needed
  // Chat sidebar theme button uses icon swap
  const ctb = document.getElementById('chatThemeBtn');
  if (ctb) {
    const label = ctb.querySelector('#themeToggleLabel')?.textContent || I18N[currentLang]?.themeToggle || '切换主题';
    ctb.innerHTML = (dark ? MOON_I : SUN_I) + `<span id="themeToggleLabel">${label}</span>`;
  }
}
if (localStorage.getItem('lexiang-theme') === 'dark') applyTheme(true);
// 初始化语言
applyLang();
function toggleTheme(){ applyTheme(!isDark()); localStorage.setItem('lexiang-theme', isDark() ? 'dark' : 'light'); }
document.getElementById('tog').addEventListener('click', toggleTheme);
document.getElementById('chatThemeBtn').addEventListener('click', toggleTheme);

// ── Page transitions ──
function goHome(){
  window.__siteType = 'default';
  window.__chatBase = '/chat';
  document.documentElement.dataset.site = 'default';
  if(location.pathname !== '/') {
    location.href='/';
  } else {
    location.reload();
  }
}
function showChatApp(pushUrl){
  document.documentElement.classList.add('is-chat');
  document.getElementById('landingPage').classList.add('exit');
  document.getElementById('chatApp').classList.add('active');
  setTimeout(() => document.getElementById('mainTa').focus(), 350);
  if (pushUrl !== false) {
    var base = window.__chatBase || '/chat';
    history.pushState(null, '', convId ? base + '/' + convId : base);
  }
  if (window.__pendingProductCtx) notifyAIProductContext(window.__pendingProductCtx);
}
window.addEventListener('popstate', (e) => {
  const p = location.pathname;
  var dc = document.getElementById('displayCanvas');
  if (dc && dc.style.display !== 'none' && !p.includes('/product/')) {
    closeDisplayCanvas();
  }
  if (p === '/' || p === '') {
    document.getElementById('chatApp').classList.remove('active');
    document.getElementById('landingPage').classList.remove('exit');
    document.documentElement.classList.remove('is-chat');
    // 清除导航高亮
    document.querySelectorAll('.nlinks a').forEach(function(a){ a.classList.remove('nav-active'); });
  } else if (['/chat','/shop-chat','/b-chat','/biz-chat'].some(x => p.startsWith(x))) {
    const base = ['/shop-chat','/b-chat','/biz-chat','/chat'].find(x => p.startsWith(x));
    const rest = p.slice(base.length).replace(/^\//, '');
    const id = Number(rest.split('/')[0]);
    if (id) loadConv(id);
    else if (rest && rest.startsWith('product/')) { /* handled by displayCanvas logic above */ }
    else if (!document.documentElement.classList.contains('split-mode')) openChatFresh();
  }
});
// 处理 bfcache 恢复
window.addEventListener('pageshow', function(e) {
  if (e.persisted) {
    // 从 bfcache 恢复，需要重新计算导航
    var _path = location.pathname;
    if (_path === '/' || _path === '') {
      document.querySelectorAll('.nlinks a').forEach(function(a){ a.classList.remove('nav-active'); });
    }
  }
});
function openChatFresh(){ if(window.__siteType==='default') setNavActive(null);
  // 匿名用户也能进聊天界面，超过免费轮次时再弹登录
  convId = null;
  // 重置加载状态，防止上次请求异常卡住
  isLoading = false;
  document.getElementById('mainSend').disabled = false;
  document.querySelectorAll('.suggestions').forEach(el => el.remove());
  document.getElementById('msgsInner').innerHTML = welcomeHTML();
  updateSidebar();
  updateTitle('');
  showChatApp();
  closeSidebar();
}

// ── Welcome screen HTML ──
function welcomeHTML(){
  const s = I18N[currentLang];
  var sw = s.siteWelcome && s.siteWelcome[window.__siteType];
  var title = sw ? sw.title : s.welcomeTitle;
  var sub = sw ? sw.sub : s.welcomeSub;
  var cards = sw ? sw.cards : s.wCards;
  const items = cards.map(([label, q]) =>
    `<div class="wlist-item" onclick="quickAsk('${q.replace(/'/g,"\\'")}')"><span>${label}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"/></svg></div>`
  ).join('');
  return `<div class="welcome" id="welcomeScreen">
    <h2>${title}</h2>
    <p>${sub}</p>
    <div class="wlist">${items}</div>
  </div>`;
}

// ── Sidebar ──
async function loadConvList(){
  try {
    const data = await apiFetch('/api/chat/conversations').then(r=>r.json());
    convList = data.map(c => ({ id: c.id, title: c.title || c.first_msg || '新对话' }));
    updateSidebar();
  } catch(e){}
}
function updateSidebar(){
  const el = document.getElementById('sbList');
  if (!convList.length){ el.innerHTML = `<div class="conv-empty">${t('noHistory')}</div>`; return; }
  el.innerHTML = convList.map(c => `
    <div class="conv-item ${c.id === convId ? 'active' : ''}" data-cid="${c.id}">
      <svg viewBox="0 0 24 24"><path d="M4 4h16v12H5.17L4 17.17V4z"/></svg>
      <span class="conv-title">${escHtml(c.title.slice(0,28))}</span>
    </div>`).join('');
  el.querySelectorAll('.conv-item').forEach(item => {
    item.addEventListener('click', () => { loadConv(item.dataset.cid); closeSidebar(); });
  });
}
function updateTitle(t){ document.getElementById('chatTitle').textContent = t; }

// ── Mobile sidebar toggle ──
function toggleSidebar(){
  const sb = document.getElementById('chatSidebar');
  const ov = document.getElementById('sbOverlay');
  const isOpen = sb.classList.toggle('open');
  ov.classList.toggle('active', isOpen);
}
function closeSidebar(){
  document.getElementById('chatSidebar').classList.remove('open');
  document.getElementById('sbOverlay').classList.remove('active');
}

// ── Mobile landing nav ──
function toggleMobileNav(){
  const mob = document.getElementById('lnavMob'); if(!mob) return;
  const ham = document.getElementById('lnavHam');
  const isOpen = mob.classList.toggle('open');
  if(ham) ham.classList.toggle('open', isOpen);
}
function closeMobileNav(){
  const mob = document.getElementById('lnavMob'); if(mob) mob.classList.remove('open');
  const ham = document.getElementById('lnavHam'); if(ham) ham.classList.remove('open');
}

async function loadConv(id){
  convId = id;
  history.pushState(null, '', '/chat/' + id);
  updateSidebar();
  var msgs = await apiFetch('/api/chat/history/' + id).then(r=>r.ok?r.json():[]).catch(e => {
    _log.error('loadConv history fetch failed', e.stack, { convId: id });
    return [];
  });
  if (!Array.isArray(msgs)) msgs = [];
  const inner = document.getElementById('msgsInner');
  document.querySelectorAll('.suggestions').forEach(el => el.remove());
  inner.innerHTML = '';
  msgs.forEach(m => {
    if (m.role !== 'user' && m.leai_response) {
      // 有官方AI对比数据，渲染分屏
      let leai;
      try { leai = JSON.parse(m.leai_response); } catch { leai = null; }
      if (leai) {
        const el = appendCompareBubble();
        const selfB = el.querySelector('.compare-col.self .mbubble');
        const offB = el.querySelector('.compare-col.official .mbubble');
        selfB.classList.remove('streaming');
        offB.classList.remove('streaming');
        selfB.innerHTML = renderMdText(m.content);
        offB.innerHTML = renderMdText(leai.text || '');
        if (leai.products?.length) offB.insertAdjacentHTML('beforeend', renderLeaiProducts(leai.products));
        return;
      }
    }
    appendBubble(m.role === 'user' ? 'user' : 'ai', m.content, true);
  });
  scrollBottom();
  const conv = convList.find(c => c.id === id);
  if (conv) updateTitle(conv.title);
  showChatApp(false);
  // 恢复右侧产品面板
  try {
    var saved = sessionStorage.getItem('lx.display.' + id);
    if (saved) { var dd = JSON.parse(saved); if (dd.products?.length) showDisplayCanvas(dd.title, dd.products); }
  } catch(e){}
  setTimeout(() => document.getElementById('mainTa').focus(), 100);
}

// ── Append message bubble ──
function appendBubble(role, text, renderMd=false){
  const ws = document.getElementById('welcomeScreen');
  if (ws) ws.remove();
  const inner = document.getElementById('msgsInner');
  const d = document.createElement('div');
  d.className = 'msg ' + role;
  const content = (renderMd && role === 'ai' && typeof marked !== 'undefined')
    ? marked.parse(text).replace(/<table/g,'<div class="table-wrap"><table').replace(/<\/table>/g,'</table></div>')
    : escHtml(text);
  if (role === 'ai') {
    const body = document.createElement('div');
    body.className = 'msg-body';
    body.innerHTML = `<div class="msg-pre"></div><div class="mbubble">${content}</div>`;
    const actions = document.createElement('div');
    actions.className = 'msg-actions';
    actions.innerHTML = `
      <button class="act-btn" onclick="copyMsg(this)"><svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>复制</button>
      <button class="act-btn fb-like" onclick="sendFeedback(this,1)" title="回答有帮助"><svg viewBox="0 0 24 24"><path d="M14 9V5a3 3 0 00-3-3l-4 9v11h11.28a2 2 0 002-1.7l1.38-9a2 2 0 00-2-2.3H14z"/><path d="M7 22H4a2 2 0 01-2-2v-7a2 2 0 012-2h3"/></svg>有用</button>
      <button class="act-btn fb-dislike" onclick="sendFeedback(this,-1)" title="回答有问题"><svg viewBox="0 0 24 24"><path d="M10 15v4a3 3 0 003 3l4-9V2H5.72a2 2 0 00-2 1.7l-1.38 9a2 2 0 002 2.3H10z"/><path d="M17 2h2.67A2.31 2.31 0 0122 4v7a2.31 2.31 0 01-2.33 2H17"/></svg>没用</button>`;
    body.appendChild(actions);
    d.innerHTML = ``;
    d.appendChild(body);
  } else {
    d.innerHTML = `<div class="mbubble">${content}</div>`;
  }
  inner.appendChild(d);
  scrollBottom(role === 'user');
  return d;
}

// ── Markdown render helper ──
function renderMdText(text) {
  if (typeof marked === 'undefined') return text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  return marked.parse(text)
    .replace(/<table/g,'<div class="table-wrap"><table')
    .replace(/<\/table>/g,'</table></div>');
}

// ── Real-time streaming render ──
function startStream(el) {
  const bubble = el.querySelector('.mbubble');
  bubble.classList.add('streaming');
  bubble.innerHTML = '';
  let accumulated = '';
  let renderTimer = null;

  function scheduleRender() {
    if (renderTimer) return;
    renderTimer = setTimeout(() => {
      renderTimer = null;
      bubble.innerHTML = renderMdText(accumulated);
      scrollBottom();
    }, 80); // 80ms 节流渲染，避免频繁重排
  }

  return {
    push(chunk) {
      accumulated += chunk;
      scheduleRender();
    },
    finish() {
      if (renderTimer) { clearTimeout(renderTimer); renderTimer = null; }
      bubble.classList.remove('streaming');
      bubble.innerHTML = renderMdText(accumulated);
      scrollBottom();
      return accumulated;
    }
  };
}

// ── Typing indicator ──
let typingEl = null;
function showTyping(){
  const ws = document.getElementById('welcomeScreen');
  if (ws) ws.remove();
  const inner = document.getElementById('msgsInner');
  typingEl = document.createElement('div');
  typingEl.className = 'msg ai';
  typingEl.innerHTML = '<div class="typing-dots"><div class="tdot"></div><div class="tdot"></div><div class="tdot"></div></div>';
  inner.appendChild(typingEl);
  scrollBottom();
}
function hideTyping(){ if(typingEl){ typingEl.remove(); typingEl=null; } }

// ── Tool display names ──
const TOOL_DISPLAY = {
  knowledge_rag: { label: '精准检索知识库', labelEn: 'Deep knowledge search' },
  web_search:    { label: '联网搜索',       labelEn: 'Web search' },
};
function toolLabel(name) {
  const d = TOOL_DISPLAY[name];
  return d ? (currentLang === 'en' ? d.labelEn : d.label) : name;
}

// ── Process card helpers ──
function createProcessCard() {
  const el = document.createElement('div');
  el.className = 'process-card';
  el.innerHTML = `<div class="process-header" onclick="this.closest('.process-card').classList.toggle('collapsed')">
    <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
    <span class="process-title">${currentLang === 'en' ? 'Processing…' : '正在处理…'}</span>
    <svg viewBox="0 0 24 24" style="width:11px;height:11px;opacity:.5"><polyline points="6 9 12 15 18 9"/></svg>
  </div>
  <div class="process-steps"></div>`;
  return el;
}

function addProcessStep(card, id, label) {
  const steps = card.querySelector('.process-steps');
  const s = document.createElement('div');
  s.className = 'process-step running';
  s.id = 'ps-' + id;
  s.innerHTML = `<svg viewBox="0 0 24 24"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg><span>${label}</span>`;
  steps.appendChild(s);
  scrollBottom();
}

function doneProcessStep(card, id, success = true) {
  const s = document.getElementById('ps-' + id);
  if (!s) return;
  s.className = 'process-step ' + (success ? 'done' : 'fail');
  s.querySelector('svg').innerHTML = success
    ? '<polyline points="20 6 9 17 4 12"/>'
    : '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>';
}

function collapseProcessCard(card, done = true) {
  const title = card.querySelector('.process-title');
  if (title) title.textContent = currentLang === 'en' ? 'Completed' : '处理完成';
  card.classList.add('collapsed');
}

// ── Think block helpers ──
function createThinkBlock() {
  const el = document.createElement('div');
  el.className = 'think-block open';
  el.innerHTML = `<div class="think-header" onclick="this.closest('.think-block').classList.toggle('open')">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <span class="think-title">${currentLang === 'en' ? 'Thinking…' : '思考中…'}</span>
    <svg class="think-chevron" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
  </div>
  <div class="think-body think-streaming"></div>`;
  return el;
}

function finalizeThinkBlock(block) {
  const title = block.querySelector('.think-title');
  if (title) title.textContent = currentLang === 'en' ? 'Thought process' : '思考过程';
  block.querySelector('.think-body').classList.remove('think-streaming');
  block.classList.remove('open'); // 默认收起，用户可展开
}

// ── Send to API (streaming) ──
async function callAPI(msg, imageUrl, audioUrl){
  const t0 = Date.now();
  isLoading = true;
  document.getElementById('mainSend').disabled = true;

  // 立即创建 AI 气泡
  const bubbleEl = appendBubble('ai', '');
  const preEl = bubbleEl.querySelector('.msg-pre');
  const stream = startStream(bubbleEl);

  // 创建 process card
  const procCard = createProcessCard();
  preEl.appendChild(procCard);
  let procStep = 0; // 递增 ID，避免冲突
  let thinkBlock = null;
  let thinkBody = null;
  let thinkAccum = '';
  let firstChunk = true;

  try {
    const bodyData = { message: msg, conv_id: convId, web_search: webSearchEnabled, lang: currentLang, thinking_mode: thinkingEnabled };
    if (imageUrl) bodyData.image_url = imageUrl;
    if (audioUrl) bodyData.audio_url = audioUrl;
    let workspaceContext = null;
    try {
      if (typeof window.__getWorkspaceContext === 'function') workspaceContext = window.__getWorkspaceContext();
    } catch(e) {}
    if (workspaceContext) bodyData.product_context = workspaceContext;
    else if (window.__currentProduct) bodyData.product_context = window.__currentProduct;
    const res = await apiFetch('/api/chat/stream', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(bodyData)
    });

    if (!res.ok) {
      const errMap = {429:'请求太频繁，请稍后再试',500:'服务器暂时不可用',502:'服务器维护中',503:'服务繁忙'};
      const err = await res.json().catch(() => ({}));
      const friendly = errMap[res.status] || err.error || '服务暂时不可用，请稍后重试';
      preEl.remove();
      stream.finish();
      bubbleEl.querySelector('.mbubble').textContent = '抱歉，' + friendly;
      return;
    }

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buf = '';
    let lastEvent = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buf += decoder.decode(value, { stream: true });
      const lines = buf.split('\n');
      buf = lines.pop();

      for (const line of lines) {
        if (line.startsWith('event: ')) { lastEvent = line.slice(7).trim(); continue; }
        if (line === '') { lastEvent = ''; continue; }
        if (!line.startsWith('data: ')) continue;
        let d;
        try { d = JSON.parse(line.slice(6)); } catch { console.warn('Stream parse error:', line); continue; }

        if (lastEvent === 'status') {
          if (d.type === 'rag') {
            addProcessStep(procCard, 'rag', d.text);
          } else if (d.type === 'rag_done') {
            doneProcessStep(procCard, 'rag', true);
          } else if (d.type === 'tool') {
            const sid = 'tool-' + (++procStep);
            addProcessStep(procCard, sid, toolLabel(d.name));
            procCard._lastToolId = sid;
          } else if (d.type === 'tool_done') {
            if (procCard._lastToolId) doneProcessStep(procCard, procCard._lastToolId, d.success !== false);
          }
        }

        else if (lastEvent === 'thinking') {
          if (!thinkBlock) {
            thinkBlock = createThinkBlock();
            preEl.appendChild(thinkBlock);
            thinkBody = thinkBlock.querySelector('.think-body');
          }
          thinkAccum += d.text;
          thinkBody.textContent = thinkAccum;
          scrollBottom();
        }

        else if (lastEvent === 'think_end') {
          if (thinkBlock) finalizeThinkBlock(thinkBlock);
        }

        else if (lastEvent === 'chunk' || (!lastEvent && d.text)) {
          if (d.text) {
            if (firstChunk) {
              firstChunk = false;
              collapseProcessCard(procCard);
            }
            stream.push(d.text);
          }
        }

        else if (lastEvent === 'done') {
          if (d.convId) {
            convId = d.convId;
            document.getElementById('shareBtn').style.display = '';
          }
          stream.finish();
          _log.event('chat_reply', { ms: Date.now()-t0, convId });
          if (convId) history.replaceState(null, '', (window.__chatBase||'/chat') + '/' + convId);
          loadConvList();
          // 自动预览：回复完成后，取最后一个气泡里的第一个外部链接在右侧打开
          setTimeout(function(){
            if (!bubbleEl || typeof openPreview !== 'function') return;
            var links = bubbleEl.querySelectorAll('a[onclick*="openPreview"]');
            if (!links.length) return;
            var oc = links[links.length - 1].getAttribute('onclick') || '';
            var m = oc.match(/openPreview\(['"]([^'"]+)['"]\)/);
            if (m && m[1]) openPreview(m[1]);
          }, 300);
        }

        else if (lastEvent === 'products') {
          if (d.products?.length) {
            const cardsHtml = renderSelfProducts(d.products);
            if (cardsHtml) bubbleEl.querySelector('.mbubble').insertAdjacentHTML('beforeend', cardsHtml);
            scrollBottom();
          }
        }

        else if (lastEvent === 'suggestions') {
          if (d.suggestions?.length) renderSuggestions(bubbleEl, d.suggestions);
        }

        else if (lastEvent === 'nav') {
          if (d.target && typeof window.__navigateLandingTo === 'function') {
            try { window.__navigateLandingTo(d.target); } catch(e) { console.warn('nav handler error', e); }
          }
        }

        else if (lastEvent === 'display') {
          if (d.products?.length) {
            showDisplayCanvas(d.title || 'AI推荐', d.products);
            try { sessionStorage.setItem('lx.display.' + convId, JSON.stringify({title: d.title || 'AI推荐', products: d.products})); } catch(e){}
          }
        }

        else if (lastEvent === 'modal') {
          showAIModal(d);
        }

        else if (lastEvent === 'error') {
          stream.finish();
          var emb = bubbleEl.querySelector('.mbubble');
          var errMsg = '抱歉，出了点问题：' + (d.message || '未知错误');
          if (emb && emb.textContent.trim()) {
            emb.insertAdjacentHTML('beforeend', '<p style="color:#e53e3e;margin-top:8px;font-size:13px">⚠ ' + errMsg + '</p>');
          } else {
            emb.textContent = errMsg;
          }
        }
      }
    }

  } catch(e) {
    _log.error('callAPI stream error', e.stack, { msg: msg.slice(0,80) });
    stream.finish();
    var mb = bubbleEl.querySelector('.mbubble');
    if (mb && mb.textContent.trim()) {
      mb.insertAdjacentHTML('beforeend', '<p style="color:#e53e3e;margin-top:8px;font-size:13px">⚠ 生成中断，以上为已接收内容。</p>');
    } else {
      mb.textContent = '网络错误，请稍后重试。';
    }
  } finally {
    isLoading = false;
    document.getElementById('mainSend').disabled = false;
  }
}

// ── LeAI Compare: 分屏对比气泡 ──
function appendCompareBubble() {
  const ws = document.getElementById('welcomeScreen');
  if (ws) ws.remove();
  const inner = document.getElementById('msgsInner');
  const d = document.createElement('div');
  d.className = 'msg ai';
  d.innerHTML = `<div class="msg-body"><div class="compare-wrap">
    <div class="compare-col self"><div class="col-label"><span class="dot"></span>自研AI</div><div class="mbubble streaming"></div></div>
    <div class="compare-col official"><div class="col-label"><span class="dot"></span>联想官方AI</div><div class="mbubble streaming"></div></div>
  </div></div>`;
  inner.appendChild(d);
  scrollBottom();
  return d;
}

// ── LeAI 官方AI流式调用 ──
async function callLeaiStream(bubble) {
  // 确保有 token
  if (!leaiSession.token) {
    try {
      const r = await fetch('/api/leai/auth');
      const d = await r.json();
      if (d.rc === 0 && d.data) {
        leaiSession.token = d.data.token;
        leaiSession.sessionId = d.data.sessionId;
      } else {
        bubble.textContent = '官方AI认证失败';
        bubble.classList.remove('streaming');
        return;
      }
    } catch(e) {
      bubble.textContent = '官方AI连接失败';
      bubble.classList.remove('streaming');
      return;
    }
  }
  return leaiSession;
}

// ── 渲染自研AI商品卡片（基于products表数据） ──
function renderSelfProducts(products) {
  if (!products?.length) return '';
  const uid = 'sp' + Date.now();
  let tabs = '<div class="leai-ptabs">';
  let panels = '';
  products.forEach((p, i) => {
    const tabName = escHtml(p.category || p.name?.slice(0, 6) || '商品');
    tabs += `<div class="leai-ptab${i===0?' active':''}" onclick="document.querySelectorAll('#${uid} .leai-ptab').forEach(t=>t.classList.remove('active'));this.classList.add('active');document.querySelectorAll('#${uid} .leai-ppanel').forEach(p=>p.classList.remove('active'));document.getElementById('${uid}-p${i}').classList.add('active')">${tabName}</div>`;

    const name = escHtml(p.name || '');
    const desc = escHtml(p.description || '');
    const price = p.price ? '¥' + p.price : '';
    const origPrice = p.original_price && p.original_price > p.price ? `<s style="color:#999;font-size:12px;margin-left:6px">¥${p.original_price}</s>` : '';
    let specsHtml = '';
    if (p.specs) {
      try {
        const sp = typeof p.specs === 'string' ? JSON.parse(p.specs) : p.specs;
        if (sp && typeof sp === 'object') {
          const entries = Object.entries(sp).slice(0, 4);
          specsHtml = entries.map(([k, v]) => `<span class="leai-ppanel-tag">${escHtml(k + ': ' + v)}</span>`).join('');
        }
      } catch {}
    }

    panels += `<div class="leai-ppanel${i===0?' active':''}" id="${uid}-p${i}">
      <div class="leai-ppanel-info" style="width:100%">
        <div class="leai-ppanel-name">${name}</div>
        <div class="leai-ppanel-brief">${desc}</div>
        ${specsHtml ? `<div class="leai-ppanel-tags">${specsHtml}</div>` : ''}
        <div class="leai-ppanel-row">
          <div>${price ? `<span class="leai-ppanel-pricelabel">参考价：</span><span class="leai-ppanel-price">${price}</span>${origPrice}` : ''}</div>
          <a class="leai-ppanel-buy" href="https://www.lenovo.com.cn" target="_blank" rel="noopener">去看看</a>
        </div>
      </div>
    </div>`;
  });
  tabs += '</div>';
  return `<div class="leai-products" id="${uid}">${tabs}${panels}</div>`;
}

// ── 渲染联想官方AI商品卡片（完美还原leai样式） ──
function renderLeaiProducts(productList) {
  const uid = 'lp' + Date.now();
  let tabs = '<div class="leai-ptabs">';
  let panels = '';
  productList.forEach((spu, i) => {
    const item = spu.item_list?.[0];
    if (!item) return;
    const tabName = escHtml(spu.item_set_name || item.spuName || '商品');
    tabs += `<div class="leai-ptab${i===0?' active':''}" onclick="document.querySelectorAll('#${uid} .leai-ptab').forEach(t=>t.classList.remove('active'));this.classList.add('active');document.querySelectorAll('#${uid} .leai-ppanel').forEach(p=>p.classList.remove('active'));document.getElementById('${uid}-p${i}').classList.add('active')">${tabName}</div>`;

    const url = item.url?.startsWith('//') ? 'https:' + item.url : (item.url || '#');
    const img = item.imgUrl?.startsWith('//') ? 'https:' + item.imgUrl : (item.imgUrl || '');
    const name = escHtml(item.name || spu.item_set_name || '');
    const brief = escHtml((item.brief || '').replace(/\//g, ' / '));
    const price = item.deliveryPrice || item.basePrice || '';
    const tagsHtml = (item.tags || []).map(t => `<span class="leai-ppanel-tag">${escHtml(t.replace(/^huanxin-/,''))}</span>`).join('');
    const score = item.recommend_score;
    const satisfied = score ? score.filter(s => s.is_satisfied).length : 0;
    const scoreHtml = score ? `<div class="leai-pscore">推荐度：<b>已有${satisfied}项满足</b> ›</div>` : '';

    panels += `<div class="leai-ppanel${i===0?' active':''}" id="${uid}-p${i}">
      <div style="width:100%">${scoreHtml}</div>
      ${img ? `<img class="leai-ppanel-img" src="${img}" alt="" loading="lazy">` : ''}
      <div class="leai-ppanel-info">
        <div class="leai-ppanel-name">${name}</div>
        <div class="leai-ppanel-brief">${brief}</div>
        ${tagsHtml ? `<div class="leai-ppanel-tags">${tagsHtml}</div>` : ''}
        <div class="leai-ppanel-row">
          <div>${price ? `<span class="leai-ppanel-pricelabel">预估到手：</span><span class="leai-ppanel-price">${price}</span>` : ''}</div>
          <a class="leai-ppanel-buy" href="${url}" target="_blank" rel="noopener">立即购买</a>
        </div>
      </div>
    </div>`;
  });
  tabs += '</div>';
  // 把productList序列化存到全局，供弹窗使用
  window.__leaiProducts = window.__leaiProducts || {};
  window.__leaiProducts[uid] = productList;
  const btns = `<div class="leai-pbtns"><div class="leai-pbtn" onclick="openLeaiModal('${uid}','compare')">查看参数对比 ›</div><div class="leai-pbtn" onclick="openLeaiModal('${uid}','all')">查看全部商品 ›</div></div>`;
  return `<div class="leai-products" id="${uid}">${tabs}${panels}${btns}</div>`;
}

// ── 商品弹窗（还原leai官方样式） ──
function openLeaiModal(uid, mode) {
  const productList = window.__leaiProducts?.[uid];
  if (!productList?.length) return;

  // 关闭已有弹窗
  document.querySelectorAll('.leai-modal-mask').forEach(m => m.remove());

  const mask = document.createElement('div');
  mask.className = 'leai-modal-mask';
  mask.onclick = (e) => { if (e.target === mask) mask.remove(); };

  const totalItems = productList.reduce((n, spu) => n + (spu.item_list?.length || 0), 0);
  const title = mode === 'compare' ? '参数对比' : `推荐商品(${totalItems})`;

  // Build tabs
  let tabsHtml = '';
  productList.forEach((spu, i) => {
    const name = escHtml(spu.item_set_name || '商品');
    tabsHtml += `<div class="leai-modal-tab${i===0?' active':''}" data-idx="${i}">${name}</div>`;
  });

  // Build all product panels
  let panelsHtml = '';
  productList.forEach((spu, si) => {
    const items = spu.item_list || [];
    items.forEach(item => {
      const img = item.imgUrl?.startsWith('//') ? 'https:' + item.imgUrl : (item.imgUrl || '');
      const name = escHtml(item.name || spu.item_set_name || '');
      const url = item.url?.startsWith('//') ? 'https:' + item.url : (item.url || '#');
      const price = item.deliveryPrice || item.basePrice || '';
      const score = item.recommend_score;
      const satisfied = score ? score.filter(s => s.is_satisfied).length : 0;
      const tags = (item.tags || []).map(t => t.replace(/^huanxin-/,''));
      let tagsHtml = '';
      if (satisfied > 0) tagsHtml += `<span class="leai-modal-card-tag sat">${satisfied}项满足</span>`;
      tags.forEach(t => { tagsHtml += `<span class="leai-modal-card-tag promo">${escHtml(t)}</span>`; });

      panelsHtml += `<div class="leai-modal-card" data-spu="${si}" onclick="window.open('${url}','_blank')">
        ${img ? `<img src="${img}" alt="" loading="lazy">` : ''}
        <div class="leai-modal-card-info">
          <div class="leai-modal-card-name">${name}</div>
          ${tagsHtml ? `<div class="leai-modal-card-tags">${tagsHtml}</div>` : ''}
          ${price ? `<div class="leai-modal-card-price">¥ ${price}</div>` : ''}
        </div>
      </div>`;
    });
  });

  mask.innerHTML = `<div class="leai-modal" onclick="event.stopPropagation()">
    <button class="leai-modal-close" onclick="this.closest('.leai-modal-mask').remove()">×</button>
    <div class="leai-modal-title">${title}</div>
    <div class="leai-modal-tabs">${tabsHtml}</div>
    <div class="leai-modal-sorts">
      <span class="leai-modal-sort active">默认排序</span>
      <span class="leai-modal-sort">推荐度</span>
      <span class="leai-modal-sort">价格</span>
      <span class="leai-modal-sort">销量</span>
    </div>
    <div class="leai-modal-body">${panelsHtml}</div>
    <div class="leai-modal-foot">
      <button class="leai-modal-compare" onclick="this.closest('.leai-modal-mask').remove()">添加对比</button>
    </div>
  </div>`;

  document.body.appendChild(mask);

  // Tab switching - filter cards by spu index
  mask.querySelectorAll('.leai-modal-tab').forEach(tab => {
    tab.onclick = () => {
      mask.querySelectorAll('.leai-modal-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const idx = tab.dataset.idx;
      mask.querySelectorAll('.leai-modal-card').forEach(c => {
        c.style.display = c.dataset.spu === idx ? 'flex' : 'none';
      });
    };
  });

  // Sort switching (visual only for now)
  mask.querySelectorAll('.leai-modal-sort').forEach(s => {
    s.onclick = () => {
      mask.querySelectorAll('.leai-modal-sort').forEach(x => x.classList.remove('active'));
      s.classList.add('active');
    };
  });

  // Initially show only first tab's products
  const firstTab = mask.querySelector('.leai-modal-tab');
  if (firstTab) firstTab.click();
}

async function callCompareAPI(msg) {
  const t0 = Date.now();
  isLoading = true;
  document.getElementById('mainSend').disabled = true;

  try {
  const compareEl = appendCompareBubble();
  const selfBubble = compareEl.querySelector('.compare-col.self .mbubble');
  const officialBubble = compareEl.querySelector('.compare-col.official .mbubble');

  // 两个独立的流状态
  let selfAccum = '', officialAccum = '';

  // 官方AI节流渲染
  let officialLastRender = 0;
  function renderOfficial() {
    const now = Date.now();
    if (now - officialLastRender < 100) return;
    officialLastRender = now;
    officialBubble.innerHTML = renderMdText(officialAccum);
    scrollBottom();
  }

  // ── 自研AI流（打字机队列） ──
  let selfMsgId = null;
  let selfProducts = []; // 自研AI返回的商品列表
  let selfQueue = []; // 待渲染的文本块队列
  let selfStreamDone = false;
  let selfMdTimer = 0; // markdown节流计数
  // 打字机定时器：每30ms从队列取文本渲染
  const selfTyper = setInterval(() => {
    if (selfQueue.length === 0) {
      if (selfStreamDone) {
        clearInterval(selfTyper);
        selfBubble.classList.remove('streaming');
        selfBubble.innerHTML = renderMdText(selfAccum || '（无回复）');
        if (selfProducts.length) selfBubble.insertAdjacentHTML('beforeend', renderSelfProducts(selfProducts));
        scrollBottom();
      }
      return;
    }
    // 每次取多个chunk加速输出
    const take = Math.min(selfQueue.length, 3);
    for (let i = 0; i < take; i++) selfAccum += selfQueue.shift();
    // 流式中轻量渲染：每10次tick才做一次markdown（约300ms），其余用textContent
    selfMdTimer++;
    if (selfMdTimer % 10 === 0) {
      selfBubble.innerHTML = renderMdText(selfAccum);
    } else {
      selfBubble.textContent = selfAccum;
    }
    scrollBottom();
  }, 30);

  const selfStream = (async () => {
    try {
      const bodyData = { message: msg, conv_id: convId, web_search: webSearchEnabled, lang: currentLang, thinking_mode: thinkingEnabled };
      const res = await apiFetch('/api/chat/stream', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyData)
      });
      if (!res.ok) { selfBubble.textContent = '自研AI请求失败'; selfBubble.classList.remove('streaming'); selfStreamDone = true; return; }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buf = '', lastEvent = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop();
        for (const line of lines) {
          if (line.startsWith('event: ')) { lastEvent = line.slice(7).trim(); continue; }
          if (line === '') { lastEvent = ''; continue; }
          if (!line.startsWith('data: ')) continue;
          let d; try { d = JSON.parse(line.slice(6)); } catch { continue; }
          if ((lastEvent === 'chunk' || (!lastEvent && d.text)) && d.text) {
            selfQueue.push(d.text);
          } else if (lastEvent === 'products' && d.products?.length) {
            selfProducts = d.products;
          } else if (lastEvent === 'done') {
            if (d.convId) { convId = d.convId; document.getElementById('shareBtn').style.display = ''; history.replaceState(null, '', '/chat/' + convId); }
            if (d.msgId) selfMsgId = d.msgId;
            loadConvList();
          }
        }
      }
    } catch(e) { selfQueue.push('网络错误'); }
    selfStreamDone = true;
  })();

  // ── 官方AI流 ──
  let officialProducts = [];
  const officialStream = (async () => {
    try {
      // 获取 token
      if (!leaiSession.token) {
        const r = await fetch('/api/leai/auth');
        const d = await r.json();
        if (d.rc === 0 && d.data) { leaiSession.token = d.data.token; leaiSession.sessionId = d.data.sessionId; }
        else { officialBubble.textContent = '官方AI认证失败'; officialBubble.classList.remove('streaming'); return; }
      }
      const res = await fetch('/api/leai/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: leaiSession.sessionId, token: leaiSession.token, input: msg })
      });
      if (!res.ok) { officialBubble.textContent = '官方AI请求失败'; officialBubble.classList.remove('streaming'); return; }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buf = '', lastEvent = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop();
        for (const line of lines) {
          if (line.startsWith('event:')) { lastEvent = line.slice(6).trim(); continue; }
          if (line === '') { lastEvent = ''; continue; }
          if (!line.startsWith('data:')) continue;
          const raw = line.slice(5);
          if (lastEvent === 'thinking_trace') continue;
          if (lastEvent === 'timeout') { officialAccum += '\n（超时）'; continue; }
          try {
            const d = JSON.parse(raw);
            const rt = d.response?.response_text || d.response_text;
            if (rt) { officialAccum = rt; console.log('[LeAI] got text, len:', rt.length, 'event:', lastEvent); }
            // 提取商品卡片数据
            const pl = d.response?.product_list || d.product_list;
            if (pl?.length) officialProducts = pl;
          } catch(pe) { console.warn('[LeAI] parse error:', pe.message, 'raw:', raw.slice(0, 80)); }
          renderOfficial();
        }
      }
    } catch(e) { console.error('[LeAI] stream error:', e); officialAccum = '连接失败'; }
    // token可能过期，清空重试一次
    if (!officialAccum && leaiSession.token) {
      console.log('[LeAI] empty response, retrying with fresh token...');
      leaiSession.token = null; leaiSession.sessionId = null;
      try {
        const r2 = await fetch('/api/leai/auth');
        const d2 = await r2.json();
        if (d2.rc === 0 && d2.data) {
          leaiSession.token = d2.data.token; leaiSession.sessionId = d2.data.sessionId;
          const res2 = await fetch('/api/leai/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sessionId: leaiSession.sessionId, token: leaiSession.token, input: msg }) });
          if (res2.ok) {
            const reader2 = res2.body.getReader();
            const decoder2 = new TextDecoder();
            let buf2 = '', lastEvent2 = '';
            while (true) {
              const { done, value } = await reader2.read();
              if (done) break;
              buf2 += decoder2.decode(value, { stream: true });
              const lines2 = buf2.split('\n');
              buf2 = lines2.pop();
              for (const line of lines2) {
                if (line.startsWith('event:')) { lastEvent2 = line.slice(6).trim(); continue; }
                if (line === '') { lastEvent2 = ''; continue; }
                if (!line.startsWith('data:')) continue;
                if (lastEvent2 === 'thinking_trace') continue;
                try {
                  const d = JSON.parse(line.slice(5));
                  const rt = d.response?.response_text || d.response_text;
                  if (rt) { officialAccum = rt; }
                  const pl = d.response?.product_list || d.product_list;
                  if (pl?.length) officialProducts = pl;
                } catch {}
                renderOfficial();
              }
            }
          }
        }
      } catch(e2) { console.error('[LeAI] retry failed:', e2); }
    }
    officialBubble.classList.remove('streaming');
    officialBubble.innerHTML = renderMdText(officialAccum || '（无回复）');
    // 渲染商品卡片
    console.log('[LeAI] products found:', officialProducts.length);
    if (officialProducts.length) {
      const cardsHtml = renderLeaiProducts(officialProducts);
      console.log('[LeAI] cards HTML length:', cardsHtml.length);
      officialBubble.insertAdjacentHTML('beforeend', cardsHtml);
    }
  })();

  await Promise.all([selfStream, officialStream]);
  _log.event('compare_reply', { ms: Date.now()-t0, convId });
  // 保存官方AI回复到DB
  if (selfMsgId && officialAccum) {
    apiFetch('/api/chat/messages/' + selfMsgId + '/leai', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ leai_text: officialAccum, leai_products: officialProducts })
    }).catch(() => {});
  }
  } finally {
    isLoading = false;
    document.getElementById('mainSend').disabled = false;
  }
}

